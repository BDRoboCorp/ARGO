<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Project Milestone Approval</title>
    <style>
      :root {
        --blue: #0f6cbd;
        --blue-strong: #115ea3;
        --blue-soft: #eef6fc;
        --border: #d1d1d1;
        --border-soft: #e5e5e5;
        --text: #242424;
        --muted: #616161;
        --page: #f5f5f5;
        --surface: #ffffff;
        --hover: #f3f9ff;
        --focus: #000000;
        --error: #a4262c;
        --error-soft: #fdf3f4;
        --success: #107c10;
        --success-soft: #f1faf1;
        --warning: #8a6100;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        width: 100%;
        height: 100%;
      }

      body {
        margin: 0;
        color: var(--text);
        background: var(--page);
        font:
          14px/1.4 "Segoe UI",
          "SegoeUI",
          sans-serif;
      }

      button,
      textarea {
        font: inherit;
      }

      .shell {
        min-height: 100%;
        display: flex;
        flex-direction: column;
      }

      .content {
        flex: 1 1 auto;
        width: 100%;
        max-width: 960px;
        padding: 16px;
      }

      .panel {
        margin-bottom: 12px;
        padding: 16px;
        border: 1px solid var(--border-soft);
        background: var(--surface);
      }

      .panel h3 {
        margin: 0 0 10px;
        font-size: 15px;
        font-weight: 600;
      }

      .details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 10px 20px;
        margin: 0;
      }

      .details dt {
        color: var(--muted);
        font-size: 12px;
      }

      .details dd {
        margin: 2px 0 0;
        font-weight: 600;
        word-break: break-word;
      }

      .record-link {
        color: var(--blue-strong);
        text-decoration: none;
      }

      .record-link:hover {
        text-decoration: underline;
      }

      .record-link:focus-visible {
        outline: 2px solid var(--focus);
        outline-offset: 2px;
      }

      .status-pill {
        display: inline-block;
        padding: 1px 8px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 600;
        color: var(--blue-strong);
        background: var(--blue-soft);
      }

      .status-pill.approved {
        color: var(--success);
        background: var(--success-soft);
      }

      .status-pill.rejected {
        color: var(--error);
        background: var(--error-soft);
      }

      .role-list {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .role-list li {
        padding: 4px 10px;
        border: 1px solid #b7d6f2;
        border-radius: 2px;
        background: var(--blue-soft);
        font-weight: 600;
      }

      .role-list li small {
        margin-left: 4px;
        color: var(--muted);
        font-weight: 400;
      }

      .empty-note {
        margin: 0;
        color: var(--muted);
      }

      .field label {
        display: block;
        margin-bottom: 5px;
        font-weight: 600;
      }

      .required {
        color: var(--error);
      }

      .field textarea {
        width: 100%;
        min-height: 120px;
        padding: 7px 9px;
        border: 1px solid var(--border);
        border-radius: 2px;
        color: var(--text);
        background: var(--surface);
        resize: vertical;
      }

      .field textarea:focus-visible {
        outline: 2px solid var(--focus);
        outline-offset: 1px;
      }

      .field textarea[aria-invalid="true"] {
        border-color: var(--error);
      }

      .field-error {
        min-height: 18px;
        margin: 4px 0 0;
        color: var(--error);
        font-size: 12px;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 8px;
      }

      .button {
        min-height: 32px;
        min-width: 110px;
        padding: 5px 16px;
        border: 1px solid var(--border);
        border-radius: 4px;
        color: var(--text);
        background: var(--surface);
        cursor: pointer;
      }

      .button:focus-visible {
        outline: 2px solid var(--focus);
        outline-offset: 2px;
      }

      .button:disabled {
        opacity: 0.55;
        cursor: default;
      }

      .button.approve {
        border-color: var(--success);
        color: #ffffff;
        background: var(--success);
      }

      .button.approve:hover:not(:disabled) {
        background: #0e6b0e;
      }

      .button.reject {
        border-color: var(--error);
        color: #ffffff;
        background: var(--error);
      }

      .button.reject:hover:not(:disabled) {
        background: #8f1d24;
      }

      .button.link {
        min-width: 0;
        border-color: transparent;
        color: var(--blue-strong);
        background: transparent;
      }

      .message {
        margin-bottom: 12px;
        padding: 10px 12px;
        border-left: 4px solid var(--blue);
        background: var(--surface);
      }

      .message.warning {
        border-left-color: var(--warning);
      }

      .message.error {
        border-left-color: var(--error);
      }

      .message.success {
        border-left-color: var(--success);
      }

      .message strong {
        display: block;
        margin-bottom: 2px;
      }

      .pending-list {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .pending-list button {
        width: 100%;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 12px;
        border: 0;
        border-bottom: 1px solid var(--border-soft);
        color: var(--text);
        background: var(--surface);
        text-align: left;
        cursor: pointer;
      }

      .pending-list li:last-child button {
        border-bottom: 0;
      }

      .pending-list button:hover {
        background: var(--hover);
      }

      .pending-list button:focus-visible {
        outline: 2px solid var(--focus);
        outline-offset: -2px;
      }

      .pending-meta {
        color: var(--muted);
        font-size: 12px;
        white-space: nowrap;
      }

      [hidden] {
        display: none !important;
      }

      @media (max-width: 640px) {
        .content {
          padding: 12px;
        }

        .actions .button {
          flex: 1 1 0;
        }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <section class="content" aria-live="polite">
        <div id="root"></div>
      </section>
    </main>

    <script>
      (function () {
        "use strict";

        var ENTITY_NAME = "bdgas_projectmilestoneapprover";

        var STATUS_IN_QUEUE = 1;
        var STATUS_APPROVED = 100000002;
        var STATUS_REJECTED = 100000003;

        // Request intake user lookups that count as a role on the approval.
        var REQUEST_INTAKE_ROLE_FIELDS = [
          "bdgas_botowner",
          "bdgas_botinformedid",
          "bdgas_botvp",
          "bdgas_assigneeba",
          "bdgas_businesspartner",
          "bdgas_domainownerid",
          "bdgas_leaddeveloperid",
          "bdgas_amoleadid",
        ];
        var BUDGET_REQUEST_ROLE_FIELD = "bdgas_financepoc";

        var elements = {
          root: document.getElementById("root"),
        };

        var state = {
          xrm: null,
          userId: "",
          approver: null,
          isSubmitting: false,
        };

        init();

        async function init() {
          try {
            state.xrm = getXrm();
            state.userId = cleanGuid(
              state.xrm.Utility.getGlobalContext().userSettings.userId,
            );

            var recordId = getRecordId();
            if (recordId) {
              await loadApproval(recordId);
            } else {
              await loadPendingList();
            }
          } catch (error) {
            renderFatal(error);
          }
        }

        // ---------- Context ----------

        function getXrm() {
          var current = window;
          while (true) {
            try {
              if (
                current.Xrm &&
                current.Xrm.WebApi &&
                current.Xrm.Navigation &&
                current.Xrm.Utility
              ) {
                return current.Xrm;
              }
            } catch (error) {
              // Cross-origin frame; keep walking up.
            }

            if (!current.parent || current.parent === current) {
              break;
            }
            current = current.parent;
          }

          throw new Error(
            "This web resource must be opened inside a model-driven app.",
          );
        }

        // The record id can come from the URL (?id= or ?data=, which ARGO
        // Navigation appends for web resources) or from the hosting form.
        function getRecordId() {
          var parameters = new URLSearchParams(window.location.search);
          var candidates = [
            parameters.get("id"),
            parseDataId(parameters.get("data")),
            getHostFormRecordId(),
          ];

          for (var index = 0; index < candidates.length; index += 1) {
            var id = cleanGuid(candidates[index]);
            if (isGuid(id)) {
              return id;
            }
          }

          return "";
        }

        function parseDataId(data) {
          if (!data) {
            return "";
          }

          try {
            var parsed = JSON.parse(data);
            if (typeof parsed === "string") {
              return parsed;
            }
            return (
              (parsed &&
                (parsed.id ||
                  parsed.recordId ||
                  parsed.entityId ||
                  parsed.bdgas_projectmilestoneapproverid)) ||
              ""
            );
          } catch (error) {
            var dataParameters = new URLSearchParams(data);
            return dataParameters.get("id") || data;
          }
        }

        function getHostFormPage() {
          try {
            var page = window.parent && window.parent.Xrm && window.parent.Xrm.Page;
            if (
              page &&
              page.data &&
              page.data.entity &&
              page.data.entity.getEntityName() === ENTITY_NAME
            ) {
              return page;
            }
          } catch (error) {
            // Not hosted on a form.
          }

          return null;
        }

        function getHostFormRecordId() {
          var page = getHostFormPage();
          return page ? page.data.entity.getId() : "";
        }

        // ---------- Pending list (no record id given) ----------

        async function loadPendingList() {
          var result = await state.xrm.WebApi.retrieveMultipleRecords(
            ENTITY_NAME,
            "?$select=bdgas_approverno,_bdgas_projectmilestoneid_value,statuscode,createdon" +
              "&$filter=_ownerid_value eq " +
              state.userId +
              " and statecode eq 0 and statuscode eq " +
              STATUS_IN_QUEUE +
              "&$orderby=createdon desc",
          );

          clearChildren(elements.root);

          if (!result.entities.length) {
            elements.root.appendChild(
              createMessage(
                "success",
                "You're all caught up",
                "There are no milestone approvals waiting for you.",
              ),
            );
            return;
          }

          var panel = document.createElement("div");
          panel.className = "panel";
          panel.style.padding = "0";

          var list = document.createElement("ul");
          list.className = "pending-list";

          result.entities.forEach(function (entity) {
            var item = document.createElement("li");
            var button = document.createElement("button");
            button.type = "button";

            var title = document.createElement("span");
            title.textContent =
              formatted(entity, "_bdgas_projectmilestoneid_value") ||
              entity.bdgas_approverno ||
              "Milestone approval";

            var meta = document.createElement("span");
            meta.className = "pending-meta";
            meta.textContent = [
              entity.bdgas_approverno,
              formatted(entity, "createdon"),
            ]
              .filter(Boolean)
              .join(" · ");

            button.appendChild(title);
            button.appendChild(meta);
            button.addEventListener("click", function () {
              openApproval(cleanGuid(entity.bdgas_projectmilestoneapproverid));
            });

            item.appendChild(button);
            list.appendChild(item);
          });

          panel.appendChild(list);
          elements.root.appendChild(panel);
        }

        async function openApproval(recordId) {
          clearChildren(elements.root);

          try {
            await loadApproval(recordId, true);
          } catch (error) {
            renderFatal(error);
          }
        }

        // ---------- Approval ----------

        async function loadApproval(recordId, showBackLink) {
          var approver = await state.xrm.WebApi.retrieveRecord(
            ENTITY_NAME,
            recordId,
            "?$select=bdgas_approverno,bdgas_comments,bdgas_sequence,statecode,statuscode," +
              "_ownerid_value,_bdgas_projectmilestoneid_value,modifiedon",
          );
          state.approver = approver;

          var milestone = null;
          var requestIntake = null;
          var budgetRequests = [];

          var milestoneId = cleanGuid(approver._bdgas_projectmilestoneid_value);
          if (milestoneId) {
            milestone = await state.xrm.WebApi.retrieveRecord(
              "bdgas_projectmilestone",
              milestoneId,
              "?$select=bdgas_number,bdgas_description,statuscode,bdgas_fileattachment," +
                "_bdgas_milestonetypeid_value,_bdgas_requestintakeid_value",
            );
          }

          var requestIntakeId =
            milestone && cleanGuid(milestone._bdgas_requestintakeid_value);
          var roleMetadata = await getRoleMetadata();

          if (requestIntakeId) {
            var intakeSelect = REQUEST_INTAKE_ROLE_FIELDS.map(function (field) {
              return "_" + field + "_value";
            });
            intakeSelect.push("bdgas_requestintake", "bdgas_digitalproductname");

            var results = await Promise.all([
              state.xrm.WebApi.retrieveRecord(
                "bdgas_requestintake",
                requestIntakeId,
                "?$select=" + intakeSelect.join(","),
              ),
              state.xrm.WebApi.retrieveMultipleRecords(
                "bdgas_budgetrequest",
                "?$select=bdgas_name,_" +
                  BUDGET_REQUEST_ROLE_FIELD +
                  "_value&$filter=_bdgas_requestintakeid_value eq " +
                  requestIntakeId,
              ),
            ]);
            requestIntake = results[0];
            budgetRequests = results[1].entities;
          }

          var roles = getUserRoles(requestIntake, budgetRequests, roleMetadata);

          renderApproval({
            approver: approver,
            milestone: milestone,
            requestIntake: requestIntake,
            roles: roles,
            showBackLink: Boolean(showBackLink),
          });
        }

        // Role labels come from the attribute display names so they follow
        // whatever the fields are called in Dataverse.
        async function getRoleMetadata() {
          var metadata = await Promise.all([
            state.xrm.Utility.getEntityMetadata(
              "bdgas_requestintake",
              REQUEST_INTAKE_ROLE_FIELDS,
            ),
            state.xrm.Utility.getEntityMetadata("bdgas_budgetrequest", [
              BUDGET_REQUEST_ROLE_FIELD,
            ]),
          ]);

          var labels = {};
          REQUEST_INTAKE_ROLE_FIELDS.forEach(function (field) {
            labels[field] = getAttributeLabel(metadata[0], field);
          });
          labels[BUDGET_REQUEST_ROLE_FIELD] = getAttributeLabel(
            metadata[1],
            BUDGET_REQUEST_ROLE_FIELD,
          );

          return {
            labels: labels,
          };
        }

        function getAttributeLabel(entityMetadata, field) {
          try {
            var attribute = entityMetadata.Attributes.get(field);
            if (attribute && attribute.DisplayName) {
              return attribute.DisplayName;
            }
          } catch (error) {
            // Fall through to the logical name.
          }

          return field;
        }

        function getUserRoles(requestIntake, budgetRequests, roleMetadata) {
          var roles = [];

          if (requestIntake) {
            REQUEST_INTAKE_ROLE_FIELDS.forEach(function (field) {
              if (cleanGuid(requestIntake["_" + field + "_value"]) === state.userId) {
                roles.push({ label: roleMetadata.labels[field] });
              }
            });
          }

          var financeRequests = budgetRequests.filter(function (budgetRequest) {
            return (
              cleanGuid(budgetRequest["_" + BUDGET_REQUEST_ROLE_FIELD + "_value"]) ===
              state.userId
            );
          });
          if (financeRequests.length) {
            roles.push({
              label: roleMetadata.labels[BUDGET_REQUEST_ROLE_FIELD],
              note:
                budgetRequests.length > 1
                  ? financeRequests
                      .map(function (budgetRequest) {
                        return budgetRequest.bdgas_name;
                      })
                      .filter(Boolean)
                      .join(", ")
                  : "",
            });
          }

          return roles;
        }

        function renderApproval(model) {
          var approver = model.approver;
          var milestone = model.milestone;
          var statusCode = approver.statuscode;
          var isOwner = cleanGuid(approver._ownerid_value) === state.userId;
          var isDecided =
            statusCode === STATUS_APPROVED || statusCode === STATUS_REJECTED;
          var isActive = approver.statecode === 0;

          clearChildren(elements.root);

          if (model.showBackLink) {
            var back = document.createElement("button");
            back.type = "button";
            back.className = "button link";
            back.textContent = "← Back to my pending approvals";
            back.addEventListener("click", function () {
              clearChildren(elements.root);
              loadPendingList().catch(renderFatal);
            });
            elements.root.appendChild(back);
          }

          if (!isOwner) {
            elements.root.appendChild(
              createMessage(
                "warning",
                "You can't act on this approval",
                "Only the owner of this approval (" +
                  (formatted(approver, "_ownerid_value") || "another user") +
                  ") can approve or reject it.",
              ),
            );
          } else if (isDecided) {
            elements.root.appendChild(
              createMessage(
                statusCode === STATUS_APPROVED ? "success" : "error",
                "Already " + (formatted(approver, "statuscode") || "decided"),
                "This approval has already been completed.",
              ),
            );
          } else if (!isActive) {
            elements.root.appendChild(
              createMessage(
                "warning",
                "This approval is closed",
                "The record is inactive and can no longer be approved or rejected.",
              ),
            );
          }

          elements.root.appendChild(renderDetails(model));
          elements.root.appendChild(renderRoles(model.roles));

          var canDecide = isOwner && isActive && !isDecided;
          elements.root.appendChild(renderDecision(approver, canDecide));
        }

        function renderDetails(model) {
          var approver = model.approver;
          var milestone = model.milestone;
          var panel = createPanel("Approval details");

          var details = document.createElement("dl");
          details.className = "details";

          // On the approver form the header already shows the approver no.,
          // owner and milestone, so only list them when opened standalone.
          var isOnForm = Boolean(getHostFormPage());

          if (model.requestIntake) {
            addDetail(
              details,
              "Project Center",
              createRequestLink(model.requestIntake),
            );
          }
          if (!isOnForm) {
            addDetail(details, "Approver no.", approver.bdgas_approverno);
          }
          addDetail(
            details,
            "Status",
            createStatusPill(approver.statuscode, formatted(approver, "statuscode")),
          );
          if (!isOnForm) {
            addDetail(details, "Owner", formatted(approver, "_ownerid_value"));
          }
          if (milestone) {
            if (!isOnForm) {
              addDetail(details, "Milestone", milestone.bdgas_number);
            }
            addDetail(
              details,
              "Milestone type",
              formatted(milestone, "_bdgas_milestonetypeid_value"),
            );
            addDetail(
              details,
              "Milestone status",
              formatted(milestone, "statuscode"),
            );
          }

          panel.appendChild(details);

          if (milestone && milestone.bdgas_fileattachment) {
            addDetail(details, "Attachment", createAttachmentLink(milestone));
          }

          if (milestone && milestone.bdgas_description) {
            var description = document.createElement("p");
            description.style.margin = "12px 0 0";
            description.style.whiteSpace = "pre-wrap";
            description.textContent = milestone.bdgas_description;
            panel.appendChild(description);
          }

          return panel;
        }

        function renderRoles(roles) {
          var panel = createPanel("Your roles on this Project Center");

          if (!roles.length) {
            var empty = document.createElement("p");
            empty.className = "empty-note";
            empty.textContent =
              "You are not listed in any role on the related Project Center or budget request.";
            panel.appendChild(empty);
            return panel;
          }

          var list = document.createElement("ul");
          list.className = "role-list";
          roles.forEach(function (role) {
            var item = document.createElement("li");
            item.textContent = role.label;
            if (role.note) {
              var note = document.createElement("small");
              note.textContent = "(" + role.note + ")";
              item.appendChild(note);
            }
            list.appendChild(item);
          });
          panel.appendChild(list);

          return panel;
        }

        function renderDecision(approver, canDecide) {
          var panel = createPanel("Your decision");

          var field = document.createElement("div");
          field.className = "field";

          var label = document.createElement("label");
          label.setAttribute("for", "comments");
          label.textContent = "Comments ";
          var required = document.createElement("span");
          required.className = "required";
          required.textContent = "*";
          required.setAttribute("aria-label", "required");
          label.appendChild(required);

          var textarea = document.createElement("textarea");
          textarea.id = "comments";
          textarea.maxLength = 4000;
          textarea.value = approver.bdgas_comments || "";
          textarea.disabled = !canDecide;
          textarea.placeholder = "Explain your decision";
          textarea.setAttribute("aria-describedby", "commentsError");

          var error = document.createElement("p");
          error.className = "field-error";
          error.id = "commentsError";

          textarea.addEventListener("input", function () {
            if (textarea.value.trim()) {
              error.textContent = "";
              textarea.removeAttribute("aria-invalid");
            }
          });

          field.appendChild(label);
          field.appendChild(textarea);
          field.appendChild(error);
          panel.appendChild(field);

          if (!canDecide) {
            return panel;
          }

          var actions = document.createElement("div");
          actions.className = "actions";

          var approveButton = document.createElement("button");
          approveButton.type = "button";
          approveButton.className = "button approve";
          approveButton.textContent = "Approve";

          var rejectButton = document.createElement("button");
          rejectButton.type = "button";
          rejectButton.className = "button reject";
          rejectButton.textContent = "Reject";

          var decisionControls = {
            textarea: textarea,
            error: error,
            buttons: [approveButton, rejectButton],
          };

          approveButton.addEventListener("click", function () {
            submitDecision(STATUS_APPROVED, "Approve", decisionControls);
          });
          rejectButton.addEventListener("click", function () {
            submitDecision(STATUS_REJECTED, "Reject", decisionControls);
          });

          actions.appendChild(approveButton);
          actions.appendChild(rejectButton);
          panel.appendChild(actions);

          return panel;
        }

        async function submitDecision(statusCode, actionLabel, controls) {
          if (state.isSubmitting) {
            return;
          }

          var comments = controls.textarea.value.trim();
          if (!comments) {
            controls.error.textContent =
              "Enter a comment before you " + actionLabel.toLowerCase() + ".";
            controls.textarea.setAttribute("aria-invalid", "true");
            controls.textarea.focus();
            return;
          }

          var confirmation = await state.xrm.Navigation.openConfirmDialog({
            title: actionLabel + " milestone",
            text:
              "Are you sure you want to " +
              actionLabel.toLowerCase() +
              " this milestone? This can't be undone from this page.",
            confirmButtonLabel: actionLabel,
            cancelButtonLabel: "Cancel",
          });
          if (!confirmation.confirmed) {
            return;
          }

          setSubmitting(true, controls);
          try {
            var recordId = cleanGuid(
              state.approver.bdgas_projectmilestoneapproverid,
            );
            await state.xrm.WebApi.updateRecord(ENTITY_NAME, recordId, {
              bdgas_comments: comments,
              statecode: 0,
              statuscode: statusCode,
            });

            refreshHostForm();
            await loadApproval(recordId);
          } catch (error) {
            setSubmitting(false, controls);
            await showError(error);
          } finally {
            state.isSubmitting = false;
          }
        }

        function setSubmitting(isSubmitting, controls) {
          state.isSubmitting = isSubmitting;
          controls.textarea.disabled = isSubmitting;
          controls.buttons.forEach(function (button) {
            button.disabled = isSubmitting;
          });
        }

        function refreshHostForm() {
          var page = getHostFormPage();
          if (!page) {
            return;
          }

          try {
            page.data.refresh(false);
          } catch (error) {
            console.warn("Unable to refresh the hosting form.", error);
          }
        }

        async function showError(error) {
          try {
            await state.xrm.Navigation.openErrorDialog({
              message: (error && error.message) || String(error),
            });
          } catch (dialogError) {
            console.error(error);
          }
        }

        function renderFatal(error) {
          clearChildren(elements.root);
          elements.root.appendChild(
            createMessage(
              "error",
              "Unable to load the approval",
              (error && error.message) || String(error),
            ),
          );
        }

        // ---------- Helpers ----------

        function createPanel(titleText) {
          var panel = document.createElement("section");
          panel.className = "panel";
          var title = document.createElement("h3");
          title.textContent = titleText;
          panel.appendChild(title);
          return panel;
        }

        function addDetail(list, labelText, value) {
          var term = document.createElement("dt");
          term.textContent = labelText;
          var description = document.createElement("dd");
          if (value instanceof Node) {
            description.appendChild(value);
          } else {
            description.textContent =
              value === undefined || value === null || value === "" ? "—" : value;
          }

          var wrapper = document.createElement("div");
          wrapper.appendChild(term);
          wrapper.appendChild(description);
          list.appendChild(wrapper);
        }

        function createAttachmentLink(milestone) {
          var link = document.createElement("a");
          link.className = "record-link";
          link.href = "#";
          link.textContent = milestone.bdgas_fileattachment_name || "Download attachment";
          link.addEventListener("click", function (event) {
            event.preventDefault();
            downloadAttachment(milestone, link);
          });
          return link;
        }

        // File columns are downloaded from .../<column>/$value; the file
        // name comes back in the x-ms-file-name header.
        async function downloadAttachment(milestone, link) {
          if (link.getAttribute("aria-busy") === "true") {
            return;
          }

          link.setAttribute("aria-busy", "true");
          try {
            var response = await fetch(
              state.xrm.Utility.getGlobalContext().getClientUrl() +
                "/api/data/v9.2/bdgas_projectmilestones(" +
                cleanGuid(milestone.bdgas_projectmilestoneid) +
                ")/bdgas_fileattachment/$value",
              {
                credentials: "same-origin",
                headers: { "OData-MaxVersion": "4.0", "OData-Version": "4.0" },
              },
            );
            if (!response.ok) {
              throw new Error(
                "Unable to download the attachment (status " + response.status + ").",
              );
            }

            var fileName =
              decodeFileName(response.headers.get("x-ms-file-name")) ||
              milestone.bdgas_fileattachment_name ||
              "attachment";
            var blob = await response.blob();
            var url = window.URL.createObjectURL(blob);
            var anchor = document.createElement("a");
            anchor.href = url;
            anchor.download = fileName;
            document.body.appendChild(anchor);
            anchor.click();
            anchor.remove();
            window.URL.revokeObjectURL(url);

            link.textContent = fileName;
          } catch (error) {
            await showError(error);
          } finally {
            link.removeAttribute("aria-busy");
          }
        }

        function decodeFileName(value) {
          if (!value) {
            return "";
          }

          try {
            return decodeURIComponent(value);
          } catch (error) {
            return value;
          }
        }

        function createRequestLink(requestIntake) {
          var requestId = cleanGuid(requestIntake.bdgas_requestintakeid);
          var link = document.createElement("a");
          link.className = "record-link";
          link.href = "#";
          link.textContent =
            [requestIntake.bdgas_requestintake, requestIntake.bdgas_digitalproductname]
              .filter(Boolean)
              .join(" - ") || "Open request";
          link.addEventListener("click", function (event) {
            event.preventDefault();
            openRecord("bdgas_requestintake", requestId);
          });
          return link;
        }

        // Inside ARGO Navigation, open records in its work area so its
        // Save & Close / Back commands keep working; otherwise use the app.
        function openRecord(entityName, entityId) {
          var navigationHost = findArgoNavigationHost();
          if (navigationHost) {
            navigationHost.openItem({
              pageType: "entityrecord",
              entityName: entityName,
              entityId: entityId,
              label: entityName,
            });
            return;
          }

          state.xrm.Navigation.openForm({
            entityName: entityName,
            entityId: entityId,
          });
        }

        function findArgoNavigationHost() {
          var current = window;
          try {
            while (current.parent && current.parent !== current) {
              current = current.parent;
              if (current.bdgasArgoNavigationHost) {
                return current.bdgasArgoNavigationHost;
              }
            }
          } catch (error) {
            // Cross-origin parent; fall back to Xrm navigation.
          }

          return null;
        }

        function createStatusPill(statusCode, label) {
          var pill = document.createElement("span");
          pill.className = "status-pill";
          if (statusCode === STATUS_APPROVED) {
            pill.classList.add("approved");
          } else if (statusCode === STATUS_REJECTED) {
            pill.classList.add("rejected");
          }
          pill.textContent = label || String(statusCode);
          return pill;
        }

        function createMessage(type, titleText, bodyText) {
          var message = document.createElement("div");
          message.className = "message " + type;
          var title = document.createElement("strong");
          title.textContent = titleText;
          var body = document.createElement("span");
          body.textContent = bodyText;
          message.appendChild(title);
          message.appendChild(body);
          return message;
        }

        function formatted(entity, field) {
          return (
            (entity &&
              entity[field + "@OData.Community.Display.V1.FormattedValue"]) ||
            ""
          );
        }

        function cleanGuid(value) {
          return String(value || "")
            .replace(/[{}]/g, "")
            .toLowerCase();
        }

        function isGuid(value) {
          return /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(
            value,
          );
        }

        function clearChildren(element) {
          while (element.firstChild) {
            element.removeChild(element.firstChild);
          }
        }
      })();
    </script>
  </body>
</html>
