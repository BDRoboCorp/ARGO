var BudgetRequest = BudgetRequest || {};

BudgetRequest.FIELD_PERMISSION_CONFIG_NAME =
    "ARGO Fields Permission";

// Initializes the Budget Request form, registers events, sets field behavior,
// and applies configured field access permissions.
BudgetRequest.onLoad = async function (executionContext) {
    var formContext = executionContext.getFormContext();

    BudgetRequest.registerEvents(formContext);
    // BudgetRequest.setFeeReadOnly(formContext);
    // BudgetRequest.setRecurringFlag(executionContext);
    // BudgetRequest.calculateFee(executionContext);

    // var isRecurringAttr = formContext.getAttribute("bdgas_isrecurring");
    // if (isRecurringAttr) {
    //     isRecurringAttr.addOnChange(BudgetRequest.calculateFee);
    //     isRecurringAttr.addOnChange(BudgetRequest.setNextChargebackDate);
    // }

    var chargebackDateAttr = formContext.getAttribute("bdgas_datechargeback");
    if (chargebackDateAttr) {
        chargebackDateAttr.removeOnChange(BudgetRequest.setNextChargebackDate);
        chargebackDateAttr.addOnChange(BudgetRequest.setNextChargebackDate);
    }

    //BudgetRequest.setNextChargebackDate(executionContext);

    BudgetRequest.setNextChargebackDateRequirement(executionContext, false);

    BudgetRequest.setDevelopmentEffortVisibility(executionContext);

    await BudgetRequest.applyConfiguredFieldAccess(
        formContext
    );
};

// Registers OnChange events for Budget Request fields to trigger
// fee calculation, recurring logic, date handling, visibility, and permissions.
BudgetRequest.registerEvents = function (formContext) {

    var applicationAttr = formContext.getAttribute("bdgas_applicationid");
    if (applicationAttr) {
        applicationAttr.addOnChange(BudgetRequest.calculateFee);
    }

    var developmentEffortAttr = formContext.getAttribute("bdgas_developmenteffort");
    if (developmentEffortAttr) {
        developmentEffortAttr.addOnChange(BudgetRequest.calculateFee);
    }

    var isRecurringAttr = formContext.getAttribute("bdgas_isrecurring");
    if (isRecurringAttr) {
        isRecurringAttr.removeOnChange(
            BudgetRequest.handleRecurringChange
        );

        isRecurringAttr.addOnChange(
            BudgetRequest.handleRecurringChange
        );
    }

    var chargebackTypeAttr = formContext.getAttribute("bdgas_chargebacktype");
    if (chargebackTypeAttr) {
        chargebackTypeAttr.addOnChange(BudgetRequest.setRecurringFlag);
        chargebackTypeAttr.addOnChange(BudgetRequest.setDevelopmentEffortVisibility);
        chargebackTypeAttr.addOnChange(BudgetRequest.calculateFee);
    }

    var requestIntakeAttr = formContext.getAttribute("bdgas_requestintakeid");
    if (requestIntakeAttr) {
        requestIntakeAttr.removeOnChange(
            BudgetRequest.onRequestIntakeChange
        );
        requestIntakeAttr.addOnChange(
            BudgetRequest.onRequestIntakeChange
        );
    }
};

// Reapplies configured field access permissions when the Request Intake changes.
BudgetRequest.onRequestIntakeChange = async function (executionContext) {
    await BudgetRequest.applyConfiguredFieldAccess(
        executionContext.getFormContext()
    );
};

// Retrieves and parses the ARGO Fields Permission configuration
// from the ARGO Config table.
BudgetRequest.getFieldPermissionConfig = async function () {
    var escapedConfigName =
        BudgetRequest.FIELD_PERMISSION_CONFIG_NAME
            .replace(/'/g, "''");

    var query =
        "?$select=bdgas_value" +
        "&$filter=bdgas_name eq '" +
        escapedConfigName +
        "'&$top=1";

    var result = await Xrm.WebApi.retrieveMultipleRecords(
        "bdgas_argoconfig",
        query
    );

    if (
        !result.entities ||
        result.entities.length === 0 ||
        !result.entities[0].bdgas_value
    ) {
        return null;
    }

    return JSON.parse(
        result.entities[0].bdgas_value
    );
};

// Retrieves the team IDs associated with the current logged-in user.
BudgetRequest.getCurrentUserTeamIds = async function () {
    var userId =
        Xrm.Utility.getGlobalContext()
            .userSettings.userId
            .replace(/[{}]/g, "");

    var result = await Xrm.WebApi.retrieveRecord(
        "systemuser",
        userId,
        "?$select=systemuserid" +
        "&$expand=teammembership_association" +
        "($select=teamid)"
    );

    return (
        result.teammembership_association || []
    ).map(function (team) {
        return String(team.teamid || "")
            .replace(/[{}]/g, "")
            .toLowerCase();
    });
};

// Retrieves the Project Type from the selected Request Intake record.
BudgetRequest.getProjectType = async function (formContext) {
    var requestIntakeAttr =
        formContext.getAttribute(
            "bdgas_requestintakeid"
        );

    var requestIntakeValue =
        requestIntakeAttr
            ? requestIntakeAttr.getValue()
            : null;

    if (!requestIntakeValue || requestIntakeValue.length === 0) {
        return null;
    }

    var requestIntakeId =
        requestIntakeValue[0].id
            .replace(/[{}]/g, "");

    var requestIntake = await Xrm.WebApi.retrieveRecord(
        "bdgas_requestintake",
        requestIntakeId,
        "?$select=bdgas_requestintaketype"
    );

    return requestIntake.bdgas_requestintaketype;
};

// Enables or disables configured Budget Request fields based on
// the user's team membership and the selected project's type.
BudgetRequest.applyConfiguredFieldAccess = async function (formContext) {
    try {
        var results = await Promise.all([
            BudgetRequest.getFieldPermissionConfig(),
            BudgetRequest.getCurrentUserTeamIds(),
            BudgetRequest.getProjectType(formContext)
        ]);

        var config = results[0];
        var currentUserTeamIds = results[1];
        var projectType = results[2];

        if (!config) {
            console.warn(
                "ARGO Fields Permission config was not found."
            );
            return;
        }

        var entityName =
            formContext.data.entity
                .getEntityName()
                .toLowerCase();

        var allFieldsEntry =
            (config.AllFields || [])
                .find(function (entry) {
                    return String(entry.Entity || "")
                        .toLowerCase() === entityName;
                });

        if (!allFieldsEntry) {
            console.warn(
                "No ARGO field configuration found for " +
                entityName + "."
            );
            return;
        }

        var supportedFields = {};

        (config.Teams || []).forEach(function (team) {
            var teamId = String(team.TeamId || "")
                .replace(/[{}]/g, "")
                .toLowerCase();

            if (
                currentUserTeamIds.indexOf(teamId) === -1 ||
                (team.ProjectTypes || [])
                    .map(String)
                    .indexOf(String(projectType)) === -1
            ) {
                return;
            }

            var entityEntry =
                (team.Entities || [])
                    .find(function (entry) {
                        return String(entry.Entity || "")
                            .toLowerCase() === entityName;
                    });

            if (!entityEntry) {
                return;
            }

            (entityEntry.SupportedFields || [])
                .forEach(function (fieldName) {
                    supportedFields[fieldName] = true;
                });
        });

        (allFieldsEntry.Fields || [])
            .forEach(function (fieldName) {
                var attribute =
                    formContext.getAttribute(fieldName);

                if (!attribute) {
                    return;
                }

                attribute.controls.forEach(
                    function (control) {
                        control.setDisabled(
                            !supportedFields[fieldName]
                        );
                    }
                );
            });
    }
    catch (error) {
        console.error(
            "Unable to apply ARGO field permissions.",
            error
        );
    }
};

