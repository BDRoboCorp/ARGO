			var statusValue =
				statusAttr.getValue();

			var isInQueue =
				statusValue === INQUEUE_STATUS_REASON;

			var isConceptApproval =
				statusValue === CONCEPT_APPROVAL_STATUS_REASON;

			var isSolutionDesign =
				statusValue === SOLUTION_DESIGN_STATUS_REASON;

			var isDev =
				statusValue === DEV_STATUS_REASON;

			var isQa =
				statusValue === QA_STATUS_REASON;

			var isReadyForSprintProdMove =
				statusValue === READY_FOR_SPRINT_PROD_MOVE_STATUS_REASON;

			var isProd =
				statusValue === PROD_STATUS_REASON;


			var shouldApplyInQueueMandatory =
				isInQueue || isConceptApproval || isSolutionDesign ||
				isDev || isQa || isReadyForSprintProdMove || isProd;

			INQUEUE_REQUIRED_FIELDS.forEach(function (fieldName) {

				var attr =
					formContext.getAttribute(fieldName);

				if (!attr) {
					return;
				}

				attr.setRequiredLevel(
					shouldApplyInQueueMandatory
						? "required"
						: "none"
				);
			});

			//Enhancement of Existing Bot = Yes, Parent Request Intake = mandatory
			RequestIntake.Business
				.setParentRequestIntakeMandatory(
					formContext
				);

			//IsAIAssessment = Yes, isResponsibleAISubmitted = mandatory
