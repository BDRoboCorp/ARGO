	//Ensures the appropriate Request Intake form is displayed based on the selected Request Intake Type, switching between QPA and RPA forms when required.
	this.preventFormSelection = function (formContext) {

		var requestType =
			formContext.getAttribute(
				"bdgas_requestintaketype"
			);

		if (!requestType) {
			return;
		}

		var currentForm =
			formContext.ui.formSelector.getCurrentItem();

		if (!currentForm) {
			return;
		}

		var currentFormName =
			currentForm.getLabel();

		var requestTypeValue =
			requestType.getValue();

		var shouldUseQpaForm =
			requestTypeValue === 100000001;

		var shouldUseRpaForm =
			requestTypeValue === 100000000 ||
			requestTypeValue === 100000002 ||
			requestTypeValue === 100000003 ||
			requestTypeValue === 100000004 ||
			requestTypeValue === 100000005;

		var forms =
			formContext.ui.formSelector.items.get();

		if (
			shouldUseQpaForm &&
			currentFormName === FORM_NAMES.RPA
		) {
			for (var i = 0; i < forms.length; i++) {
				if (
					forms[i].getLabel() === FORM_NAMES.QPA
				) {
					forms[i].navigate();
					return;
				}
			}
		}

		if (
			shouldUseRpaForm &&
			currentFormName === FORM_NAMES.QPA
		) {
			for (var j = 0; j < forms.length; j++) {
				if (
					forms[j].getLabel() === FORM_NAMES.RPA
				) {
					forms[j].navigate();
					return;
				}
			}
		}
	};

