			}

		});
	};
}).apply(RequestIntake.Business);


(function () {

	//Registers the Request Intake field and BPF event handlers uses to trigger form business logic when values or stages change.
	var registerEvents = function (executionContext) {

		var formContext = executionContext.getFormContext();

		var attribute =
			formContext.getAttribute("bdgas_requestintaketype");

		if (attribute) {
			attribute.addOnChange(
				RequestIntake.Events.RequestIntakeTypeOnChange
			);
		}
		var enhancementAttr =
			formContext.getAttribute(
				"bdgas_enhancementofexistingbot"
			);

		if (enhancementAttr) {
			enhancementAttr.addOnChange(
				RequestIntake.Events
					.EnhancementOfExistingBotOnChange
			);
		}

		var isAIAssessmentAttr =
			formContext.getAttribute(
				"bdgas_isaiassessment"
			);

		if (isAIAssessmentAttr) {
			isAIAssessmentAttr.addOnChange(
				RequestIntake.Events
					.IsAIAssessmentOnChange
			);
		}

		var statusAttr =
			formContext.getAttribute("statuscode");

		if (statusAttr) {
			statusAttr.addOnChange(
				RequestIntake.Events.StatusCodeOnChange
			);
		}

		var developmentSizeAttr =
			formContext.getAttribute(
				"bdgas_developmentsizeid"
			);

		if (developmentSizeAttr) {
			developmentSizeAttr.addOnChange(
				RequestIntake.Events
					.DevelopmentSizeOnChange
			);
		}

		if (
			formContext.data &&
			formContext.data.process
		) {
			formContext.data.process.addOnStageChange(
				RequestIntake.Events.BpfStageChange
			);
		}
	};

	//Updates the Responsible AI Submitted requirement whenever the AI Assessment value changes.
	this.IsAIAssessmentOnChange =
    function (executionContext) {
        var formContext =
            executionContext.getFormContext();

        RequestIntake.Business
            .setResponsibleAISubmittedMandatory(
                formContext
            );
    };

	//Reapplies field permissions and QPA field requirements, then switch's the BPF when the Request Intake Type changes.
	this.RequestIntakeTypeOnChange = function (executionContext) {

		var formContext =
			executionContext.getFormContext();

		RequestIntake.Business
			.applyConfiguredFieldAccess(
				formContext
			);

		RequestIntake.Business
			.applyQpaNonMandatoryRules(
				formContext
			);

		window.setTimeout(function () {
			RequestIntake.Business.switchBpfByType(
				formContext
			);
		}, 1500);
	};

	//Reapplies the status-based mandatory field rules when Enhancement of Existing Bot changes.
	this.EnhancementOfExistingBotOnChange =
		function (executionContext) {

			var formContext =
				executionContext.getFormContext();

			RequestIntake.Business
				.applyInQueueMandatoryRules(
					formContext
				);

			RequestIntake.Business
				.applyConceptApprovalMandatoryRules(
					formContext
				);

			RequestIntake.Business
				.applySolutionDesignMandatoryRules(
					formContext
				);

			RequestIntake.Business
				.applyDevMandatoryRules(
					formContext
				);

			RequestIntake.Business
				.applyQaMandatoryRules(
					formContext
				);

			RequestIntake.Business
				.applyProdMandatoryRules(
					formContext
				);

			RequestIntake.Business
				.applyQpaNonMandatoryRules(
					formContext
				);

		};

	//Reapplies all status-based mandatory field rules whenever the Request Intake Status Reason changes.
	this.StatusCodeOnChange =
		function (executionContext) {

			var formContext =
				executionContext.getFormContext();

			RequestIntake.Business
				.applyInQueueMandatoryRules(
					formContext
				);

			RequestIntake.Business
				.applyConceptApprovalMandatoryRules(
					formContext
				);

			RequestIntake.Business
				.applySolutionDesignMandatoryRules(
					formContext
				);

			RequestIntake.Business
				.applyDevMandatoryRules(
					formContext
				);

			RequestIntake.Business
				.applyQaMandatoryRules(
					formContext
				);

			RequestIntake.Business
				.applyProdMandatoryRules(
					formContext
				);

			RequestIntake.Business
				.applyQpaNonMandatoryRules(
				formContext
				);
		};

	//Recalculates Estimated Hours whenever the selected Development Size changes.
	this.DevelopmentSizeOnChange = function (executionContext) {
		var formContext = executionContext.getFormContext();

		RequestIntake.Business
			.setEstimatedHoursFromDevelopmentSize(
				formContext
			);
	};

	//Re-registers the Development Size lookup filter when the active Business Process Flow stage changes.
	this.BpfStageChange = function (executionContext) {

		var formContext =
			executionContext.getFormContext();

		var control =
			formContext.getControl(
				"header_process_bdgas_developmentsizeid"
			);

		if (!control) {
			return;
		}

		control.removePreSearch(
			RequestIntake.Business
				.addDevelopmentSizeBpfFilter
		);

		control.addPreSearch(
			RequestIntake.Business
				.addDevelopmentSizeBpfFilter
		);
	};

	//Handles the Request Intake post-save event and currently logs that the post-save event has been triggered.
	this.onPostSave = function (executionContext) {

		console.log("Post Save triggered");

	};

	//Initializes the Request Intake form by registering events and applying form, BPF, QPA agreement, mandatory-field, lookup, display-name,
    //estimated-hours, and configured field-access logic.
	this.onLoad = async function (executionContext) {

		registerEvents(executionContext);

		var formContext =
			executionContext.getFormContext();

		RequestIntake.Business
		.registerDevelopmentSizeBpfFilter(
			formContext
		);

		RequestIntake.Business.disableLookupMru(
			formContext
		);

		RequestIntake.Business.removeQpaStatusOptions(
			formContext
		);

		// Show QPA agreement on create
		if (formContext.ui.getFormType() === 1) {

			// QPA was cancelled.
    		// Close the underlying create form as well.
			var qpaCreationCancelled =
				sessionStorage.getItem(
					"bdgas_qpaCreationCancelled"
				);

			if (qpaCreationCancelled === "true") {

				sessionStorage.removeItem(
					"bdgas_qpaCreationCancelled"
				);

				formContext.ui.close();
				return;
			}

			var QPA_FORM_ID = "557c5ae5-f899-f111-b8dc-000d3a11e677";

			var currentForm =
				formContext.ui.formSelector.getCurrentItem();

			var currentFormId =
				currentForm && currentForm.getId()
					? currentForm.getId().replace(/[{}]/g, "").toLowerCase()
					: null;

			// If New opened using RPA Form, redirect immediately to QPA Form
			if (
				currentFormId &&
				currentFormId !== QPA_FORM_ID.toLowerCase()
			) {
				await Xrm.Navigation.navigateTo(
					{
						pageType: "entityrecord",
						entityName: "bdgas_requestintake",
						formId: QPA_FORM_ID
					},
					{
						target: 1
					}
				);

				return;
			}

			// We are now actually on QPA Form.
			// Only now do QPA create logic.
			
			var agreed = await RequestIntake.Business.showQpaAgreement(
				formContext
			);
			
			//Cancel: stop QPA initialization.
			if (!agreed) {

				// Remember that QPA creation was cancelled.
				sessionStorage.setItem(
					"bdgas_qpaCreationCancelled",
					"true"
				);

				// Same close behaviour used by SRA Agreement.
				formContext.ui.close();

				return;
			}

			// Agree: continue QPA initialization.
			RequestIntake.Business.hideRpaOptionOnCreate(
				formContext
			);

			// Temporarily remove mandatory requirements
			// so the initial QPA record can be created.
			var mandatoryLevels = [];

			formContext.data.entity.attributes.forEach(
				function (attribute) {
					var requiredLevel =
						attribute.getRequiredLevel();

					if (requiredLevel !== "none") {
						mandatoryLevels.push({
							attribute: attribute,
							requiredLevel: requiredLevel
						});

						attribute.setRequiredLevel("none");
					}
				}
			);

			try {
				console.log(
					"[QPA] Agreement accepted. Creating QPA record..."
				);

				await formContext.data.save();

				var createdRecordId =
					formContext.data.entity.getId();

				if (!createdRecordId) {
					throw new Error(
						"The QPA Project Center record was not created successfully. " +
						"No record ID was returned."
					);
				}

				console.log(
					"[QPA] Agreement save created record:",
					createdRecordId
				);
			}
			finally {
				// Restore original mandatory levels.
				mandatoryLevels.forEach(
					function (mandatoryField) {
						mandatoryField.attribute.setRequiredLevel(
							mandatoryField.requiredLevel
						);
					}
				);

				// Apply the correct QPA mandatory-field exceptions
				// after the initial record creation.
				RequestIntake.Business.applyQpaNonMandatoryRules(
					formContext
				);
			}
		}
		else {

			RequestIntake.Business.preventFormSelection(
				formContext
			);

			RequestIntake.Business.switchBpfByType(
				formContext
			);

			RequestIntake.Business.applyInQueueMandatoryRules(
				formContext
			);

			RequestIntake.Business.applyConceptApprovalMandatoryRules(
				formContext
			);

			RequestIntake.Business.applySolutionDesignMandatoryRules(
				formContext
			);

			RequestIntake.Business.applyDevMandatoryRules(
				formContext
			);

			RequestIntake.Business.applyQaMandatoryRules(
				formContext
			);

			RequestIntake.Business.applyProdMandatoryRules(
				formContext
			);

			RequestIntake.Business.applyQpaNonMandatoryRules(
				formContext
			);
		}

		RequestIntake.Business.setEstimatedHoursFromDevelopmentSize(
			formContext
		);

		//Display: RequestName - Request Number
		RequestIntake.Business.setRequestIntakeDisplayName(
   			formContext
		);
		await RequestIntake.Business
			.applyConfiguredFieldAccess(
				formContext
			);
	};
}).apply(RequestIntake.Events);