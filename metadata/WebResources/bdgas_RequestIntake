	// Retrieves and parses the ARGO Fields Permission configuration used to control field accessibility on the Request Intake form.
	this.getFieldPermissionConfig =
		async function () {

			var escapedConfigName =
				FIELD_PERMISSION_CONFIG_NAME
					.replace(/'/g, "''");

			var query =
				"?$select=bdgas_value" +
				"&$filter=bdgas_name eq '" +
				escapedConfigName +
				"'&$top=1";

			var result =
				await Xrm.WebApi.retrieveMultipleRecords(
					"bdgas_argoconfig",
					query
				);

			if (
				!result.entities ||
				result.entities.length === 0 ||
				!result.entities[0].bdgas_value
			) {
				return null;
			}

			return JSON.parse(
				result.entities[0].bdgas_value
			);
		};

	// Retrieves the team IDs associated with the currently logged-in user.
	this.getCurrentUserTeamIds =
		async function () {

			var userId =
				Xrm.Utility.getGlobalContext()
					.userSettings.userId
					.replace(/[{}]/g, "");

			var result =
				await Xrm.WebApi.retrieveRecord(
					"systemuser",
					userId,
					"?$select=systemuserid" +
					"&$expand=teammembership_association" +
					"($select=teamid)"
				);

			return (
				result.teammembership_association || []
			).map(function (team) {
				return String(team.teamid || "")
					.replace(/[{}]/g, "")
					.toLowerCase();
			});
		};

	//Retrieves the SRA Appointment record associated with the selected SRA lookup on the Request Intake form.
	this.getSraAppointment =
		async function (formContext) {

			var sraLookup =
				formContext.getAttribute("bdgas_sraid")
					.getValue();

			if (!sraLookup || sraLookup.length === 0) {
				return null;
			}

			var appointmentId =
				sraLookup[0].id.replace(/[{}]/g, "");

			var appointment =
				await Xrm.WebApi.retrieveRecord(
					"appointment",
					appointmentId,
					"?$select=activityid,subject,scheduledstart,statecode,bdgas_slotstatus"
				);

			return appointment;
		};

	//Checks whether the currently logged-in user is a member of the specified team.
	this.isCurrentUserInTeam =
		async function (teamId) {

			if (!teamId) {
				return false;
			}

			teamId =
				teamId
					.replace("{", "")
					.replace("}", "");

			var userId =
				Xrm.Utility.getGlobalContext()
					.userSettings.userId
					.replace("{", "")
					.replace("}", "");

			var query =
				"?$filter=systemuserid eq " +
				userId +
				" and teamid eq " +
				teamId;

			var result =
				await Xrm.WebApi.retrieveMultipleRecords(
					"teammembership",
					query
				);

			return (
				result &&
				result.entities &&
				result.entities.length > 0
			);
		};
	
	//Retrieves the QPA Agreement text from the configured Dataverse environment variable definition.
	this.getQpaAgreement = async function () {
		var query =
			"?$select=defaultvalue" +
			"&$filter=schemaname eq '" +
			QPA_AGREEMENT_CONFIG_NAME +
			"'";

		var result = await Xrm.WebApi.retrieveMultipleRecords(
			"environmentvariabledefinition",
			query
		);

		if (
			!result.entities ||
			result.entities.length === 0
		) {
			return null;
		}

		return result.entities[0].defaultvalue;
	};

