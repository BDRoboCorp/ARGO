	//Activates the appropriate Business Process Flow based on the selected Request Intake Type.
	this.switchBpfByType = function (formContext) {

		var entityId =
			formContext.data.entity.getId();

		if (!entityId) {
			console.log("BPF switch skipped because record has not been saved yet.");
			return;
		}

		if (
			!formContext.data ||
			!formContext.data.process ||
			!formContext.data.process.setActiveProcess ||
			!formContext.data.process.getActiveProcess
		) {
			return;
		}

		var typeAttribute =
			formContext.getAttribute("bdgas_requestintaketype");

		if (!typeAttribute) {
			return;
		}

		var requestIntakeType =
			typeAttribute.getValue();

		if (requestIntakeType === null) {
			return;
		}

		var targetProcessId = null;

		if (requestIntakeType === REQUEST_INTAKE_TYPE.QPA) {
			targetProcessId = BPF_IDS.QPA;
		}
		else {
			targetProcessId = BPF_IDS.RPA;
		}

		if (!targetProcessId) {
			return;
		}

		var activeProcess =
			formContext.data.process.getActiveProcess();

		if (
			activeProcess &&
			activeProcess.getId() &&
			activeProcess.getId().toLowerCase() ===
			targetProcessId.toLowerCase()
		) {
			console.log("Correct BPF is already active.");
			return;
		}

		formContext.data.process.setActiveProcess(
			targetProcessId,
			function (status) {

				console.log(
					"BPF switch result: " + status
				);

				/*
				 Do not call formContext.data.refresh(false) here.
				 setActiveProcess already reloads the form when it changes the process.
				*/
			}
		);
	};

