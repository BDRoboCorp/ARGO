	//Applies configured field access permissions based on the current user's team membership and the selected Request Intake Type.
	this.applyConfiguredFieldAccess =
		async function (formContext) {

			try {
				var results = await Promise.all([
					RequestIntake.DataAccess
						.getFieldPermissionConfig(),
					RequestIntake.DataAccess
						.getCurrentUserTeamIds()
				]);

				var config = results[0];
				var currentUserTeamIds = results[1];

				if (!config) {
					console.warn(
						"ARGO Fields Permission config was not found."
					);
					return;
				}

				var entityName =
					formContext.data.entity
						.getEntityName()
						.toLowerCase();

				var allFieldsEntry =
					(config.AllFields || [])
						.find(function (entry) {
							return String(entry.Entity || "")
								.toLowerCase() === entityName;
						});

				if (!allFieldsEntry) {
					console.warn(
						"No ARGO field configuration found for " +
						entityName + "."
					);
					return;
				}

				var projectTypeAttribute =
					formContext.getAttribute(
						"bdgas_requestintaketype"
					);

				var projectType =
					projectTypeAttribute
						? projectTypeAttribute.getValue()
						: null;

				var supportedFields = {};

				(config.Teams || []).forEach(function (team) {
					var teamId = String(team.TeamId || "")
						.replace(/[{}]/g, "")
						.toLowerCase();

					if (
						currentUserTeamIds.indexOf(teamId) === -1 ||
						(team.ProjectTypes || [])
							.map(String)
							.indexOf(String(projectType)) === -1
					) {
						return;
					}

					var entityEntry =
						(team.Entities || [])
							.find(function (entry) {
								return String(entry.Entity || "")
									.toLowerCase() === entityName;
							});

					if (!entityEntry) {
						return;
					}

					(entityEntry.SupportedFields || [])
						.forEach(function (fieldName) {
							supportedFields[fieldName] = true;
						});
				});

				(allFieldsEntry.Fields || [])
					.forEach(function (fieldName) {
						var attribute =
							formContext.getAttribute(fieldName);

						if (!attribute) {
							return;
						}

						attribute.controls.forEach(
							function (control) {
								control.setDisabled(
									!supportedFields[fieldName]
								);
							}
						);
					});
			}
			catch (error) {
				console.error(
					"Unable to apply ARGO field permissions.",
					error
				);
			}
		};

	//Displays the QPA Agreement dialog and returns whether the user accepted the agreement.
	this.showQpaAgreement = async function (formContext) {
		try {
			var agreementText =
				await RequestIntake.DataAccess
					.getQpaAgreement();

			if (!agreementText) {
				return false;
			}

			// Same pattern as SRA:
			// default result is Cancel
			sessionStorage.setItem(
				"bdgas_qpaAgreementResult",
				"cancel"
			);

			await Xrm.Navigation.navigateTo(
				{
					pageType: "webresource",
					webresourceName: "bdgas_qpaAgreement",
					data: agreementText
				},
				{
					target: 2,
					width: 700,
					height: 600,
					position: 1,
					title: "QPA Agreement"
				}
			);

			var result =
				sessionStorage.getItem(
					"bdgas_qpaAgreementResult"
				);

			return result === "agree";
		}
		catch (error) {
			console.error(error);
			return false;
		}
	};

	//Extracts the numeric value from the selected Development Size name and uses it to populate the Estimates Hours field.
	this.setEstimatedHoursFromDevelopmentSize = function (formContext) {
		var developmentSizeAttr =
			formContext.getAttribute(
				"bdgas_developmentsizeid"
			);

		var estimatedHoursAttr =
			formContext.getAttribute(
				"bdgas_estimatedhours"
			);

		if (!developmentSizeAttr || !estimatedHoursAttr) {
			console.warn(
				"Estimated hours calculation skipped because " +
				"bdgas_developmentsizeid or bdgas_estimatedhours " +
				"is not available on the current form."
			);
			return;
		}

		var developmentSize =
			developmentSizeAttr.getValue();

		if (
			!developmentSize ||
			developmentSize.length === 0
		) {
			estimatedHoursAttr.setValue(null);
			return;
		}

		var sizeName =
			developmentSize[0].name || "";

		var matches = sizeName.match(/\d+/g);

		if (!matches || matches.length === 0) {
			estimatedHoursAttr.setValue(null);
			return;
		}

		var estimatedHours = parseInt(
			matches[matches.length - 1],
			10
		);

		if (isNaN(estimatedHours)) {
			estimatedHoursAttr.setValue(null);
			return;
		}

		estimatedHoursAttr.setValue(
			estimatedHours
		);
	};

	// Display-only: show the digital product name in the form header's
	// entity label (under the record title). Nothing is saved.
	this.setRequestIntakeDisplayName = function (formContext) {
		var productAttr =
			formContext.getAttribute(
				"bdgas_digitalproductname"
			);

		if (!productAttr) {
			return;
		}

		var productName =
			productAttr.getValue();

		if (!productName) {
			return;
		}

		if (
			formContext.ui &&
			formContext.ui.setFormEntityName
		) {
			formContext.ui.setFormEntityName(
				productName
			);
		}
	};

	//Removes mandatory requirements from the configured fields when the Request Intake Type is QPA.
	this.applyQpaNonMandatoryRules = function (formContext) {

		var currentForm =
			formContext.ui.formSelector.getCurrentItem();

		var requestType =
			formContext.getAttribute(
				"bdgas_requestintaketype"
			)?.getValue();

		if (requestType !== 100000001) {
			return;
		}

		var qpaNonMandatoryFields = [
			"bdgas_planviewid",
			"bdgas_planviewrequestcreationdate",
			"bdgas_manualestimatereviewedby",
			"bdgas_developmentsizeid",
			"bdgas_estimatedhours",
			"bdgas_configurationitemlink",
			"bdgas_leaddeveloperid",
			"bdgas_changeticket",
			"bdgas_ardssignoff",
			"bdgas_erprequest",
			"bdgas_developmentstartdate",
			"bdgas_issimplemediumform",
			"bdgas_uatcompletedate",
			"bdgas_botbusinesscriticality",
			"bdgas_botisinhypercare1",
			"bdgas_scheduleortrigger",
			"bdgas_triggerpath",
			"bdgas_kttoamo",
			"bdgas_golivedate",
			"bdgas_schedulenotes",
			"bdgas_fimmanagedsg",
			"bdgas_prodlink"
		];

		qpaNonMandatoryFields.forEach(function (fieldName) {

			var attr = formContext.getAttribute(fieldName);

			if (attr) {
