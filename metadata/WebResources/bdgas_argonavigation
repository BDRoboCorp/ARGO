        async function returnToSimpleNavigation() {
          if (isCommandRunning) {
            return;
          }
          try {
            var page = getFormPage();
            if (page && page.data.getIsDirty()) {
              var confirmation = await getXrm().Navigation.openConfirmDialog({
                title: "Unsaved changes",
                text: "This form has unsaved changes. Discard them and return?",
                confirmButtonLabel: "Discard changes",
                cancelButtonLabel: "Stay on form",
              });
              if (!confirmation.confirmed) {
                return;
              }
            }
            showSimpleNavigationCards();
          } catch (error) {
            await showCommandError(error);
          }
        }

        function showSimpleNavigationCards() {
          var state = simpleNavigationState;
          resetNavigationWorkArea();
          setNavigationData();
          clearChildren(state.workArea);
          state.workArea.hidden = true;
          state.body.classList.remove("is-showing-work-area");
          state.cards.hidden = false;
