        }

        function createSimpleNavigationFooter(emailTo) {
          if (typeof emailTo !== "string" ||
              !/^[^\s@<>?&#:;,]+@[^\s@<>?&#:;,]+\.[^\s@<>?&#:;,]+$/.test(emailTo.trim())) {
            throw new Error(
              "ARGO Navigation emailTo must contain a valid contact email address.",
