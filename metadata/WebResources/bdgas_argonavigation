        async function cancelAppointment() {
          var page = getFormPage();
          if (!page || isCommandRunning) {
            return;
          }
          setCommandRunning(true);
          var slotStatus = null;
          var originalValue = null;
          try {
            slotStatus = page.getAttribute("bdgas_slotstatus");
            if (
              page.data.entity.getEntityName() !== "appointment" ||
              page.ui.getFormType() !== 2 ||
              !cleanGuid(page.data.entity.getId()) ||
              !slotStatus ||
              slotStatus.getValue() !== 2
            ) {
              throw new Error("Only saved Reserved appointments can be canceled.");
            }

            // Confirm first. Nothing on the form changes until the user clicks Yes.
            var confirmation = await getXrm().Navigation.openConfirmDialog(
              {
                title: "Confirm Cancellation",
                text: "Are you sure you want to cancel this SRA Appointment slot?",
                confirmButtonLabel: "Yes",
                cancelButtonLabel: "No",
              },
              { height: 200, width: 450 },
            );
            if (!confirmation.confirmed) {
              return;
            }

            originalValue = slotStatus.getValue();
            slotStatus.setValue(6);
            slotStatus.setSubmitMode("always");
            // Runs SRAAppointment.onSlotStatusChange, which clears the
            // mandatory fields before the save below starts.
            slotStatus.fireOnChange();
            await page.data.save();
          } catch (error) {
            // If the save fails, put Slot Status back so the form is not left
            // half-cancelled and dirty.
            if (slotStatus && originalValue !== null && slotStatus.getValue() === 6) {
              slotStatus.setValue(originalValue);
              slotStatus.fireOnChange();
            }
            await showCommandError(error);
          } finally {
            currentFormKey = "";
            setCommandRunning(false);
            syncFormCommandBar();
          }
        }

        async function activateProjectMilestone() {
          var page = getFormPage();
          if (!page || isCommandRunning) {
            return;
          }

          var entityName = page.data.entity.getEntityName();
          var recordId = cleanGuid(page.data.entity.getId());
          if (entityName !== "bdgas_projectmilestone" || !recordId) {
            await showCommandError(
              new Error("Only saved project milestones can be activated."),
            );
            return;
          }

          setCommandRunning(true);
          try {
            if (page.data.getIsDirty()) {
              throw new Error("Save or discard your changes before activating this milestone.");
            }

            var xrm = getXrm();
            var confirmation = await xrm.Navigation.openConfirmDialog({
              title: "Activate Project Milestone",
              text: "Return this approved milestone to Active / In Queue? You will need to submit it again to rerun approval.",
              confirmButtonLabel: "Activate",
              cancelButtonLabel: "Cancel",
            });
            if (!confirmation.confirmed) {
              return;
            }

            var record = await xrm.WebApi.retrieveRecord(
              entityName,
              recordId,
              "?$select=statecode,statuscode",
            );
            if (record.statecode !== 1 || record.statuscode !== 2) {
              throw new Error("Only approved project milestones can be activated.");
            }

            await xrm.WebApi.updateRecord(entityName, recordId, {
              statecode: 0,
              statuscode: 1,
            });
            await page.data.refresh(false);
            currentFormKey = "";
          } catch (error) {
            await showCommandError(error);
          } finally {
            setCommandRunning(false);
            syncFormCommandBar();
          }
        }

        async function deleteFormRecord() {
          var page = getFormPage();
          if (!page || isCommandRunning) {
            return;
          }

          var entityName = page.data.entity.getEntityName();
          var recordId = cleanGuid(page.data.entity.getId());
          var xrm = getXrm();

          setCommandRunning(true);
          try {
            if (!(await canDeleteAppointment(entityName, recordId))) {
              throw new Error(
                "Appointments can only be deleted by a Regulatory Admin, or by their creator when there is no meeting link.",
              );
            }

            var confirmation = await xrm.Navigation.openConfirmDialog({
              title: "Confirm Deletion",
              text: "Are you sure you want to delete this record? This action cannot be undone.",
              confirmButtonLabel: "Delete",
              cancelButtonLabel: "Cancel",
            });

            if (!confirmation.confirmed) {
              return;
            }

            if (!(await canDeleteAppointment(entityName, recordId))) {
              throw new Error(
                "This appointment is no longer eligible for deletion. Only a Regulatory Admin, or its creator when there is no meeting link, can delete it.",
              );
            }

            await xrm.WebApi.deleteRecord(entityName, recordId);
            closeForm();
          } catch (error) {
            await showCommandError(error);
          } finally {
            setCommandRunning(false);
          }
        }

        async function generateSraDocument() {
          var page = getFormPage();
          if (!page || isCommandRunning) {
            return;
          }

          if (!isRegulatoryAdmin) {
            await showCommandError(
              new Error("Only members of the configured Regulatory Admin team can generate SRA documents."),
            );
            return;
          }

          var appointmentId = cleanGuid(page.data.entity.getId());
          if (!appointmentId) {
            await showCommandError(
              new Error("Save the appointment before generating an SRA document."),
            );
            return;
          }

          setCommandRunning(true);
          try {
            var flowUrl = await getEnvironmentVariableValue(
              GENERATE_SRA_FLOW_SCHEMA_NAME,
            );
            if (!flowUrl) {
              throw new Error(
                "The Generate SRA flow URL is not configured.",
              );
            }

            var response = await fetch(flowUrl, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                AppointmentId: appointmentId,
              }),
            });
            if (!response.ok) {
              throw new Error(
                "Generate SRA flow failed with status " + response.status + ".",
              );
            }

            var result = await response.json();
            downloadSraDocument(result);
          } catch (error) {
            await showCommandError(error);
          } finally {
            setCommandRunning(false);
          }
        }

        async function getEnvironmentVariableValue(schemaName) {
          var xrm = getXrm();
          var escapedSchemaName = String(schemaName).replace(/'/g, "''");
          var query =
            "?$select=defaultvalue&$filter=schemaname eq '" +
            escapedSchemaName +
            "'&$expand=environmentvariabledefinition_environmentvariablevalue" +
            "($select=value,createdon;$orderby=createdon desc;$top=1)";
          var result = await xrm.WebApi.retrieveMultipleRecords(
            "environmentvariabledefinition",
            query,
          );

          if (!result.entities.length) {
            return "";
          }

          var definition = result.entities[0];
          var values =
            definition.environmentvariabledefinition_environmentvariablevalue ||
            [];
          return values.length && values[0].value
            ? values[0].value
            : definition.defaultvalue || "";
        }

        function downloadSraDocument(result) {
          var file = result && result.File;
          var content = file && file.$content;
          if (!content) {
            throw new Error("Generate SRA flow did not return a document file.");
          }

          var fileName = String((result && result.FileName) || "SRA Document");
          if (!/\.[^./\\]+$/.test(fileName)) {
            fileName += ".docx";
          }

          var base64Content = String(content).replace(/^data:[^;]+;base64,/, "");
          var binaryContent = window.atob(base64Content);
          var bytes = new Uint8Array(binaryContent.length);
          for (var index = 0; index < binaryContent.length; index += 1) {
            bytes[index] = binaryContent.charCodeAt(index);
          }

          var blob = new Blob([bytes], {
            type:
              file["$content-type"] ||
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
          });
          var downloadUrl = window.URL.createObjectURL(blob);
          var link = document.createElement("a");
          link.href = downloadUrl;
          link.download = fileName;
          document.body.appendChild(link);
          link.click();
          link.remove();
          window.URL.revokeObjectURL(downloadUrl);
        }

        function hasArgoNavigationParent() {
          var current = window;

          try {
            while (current.parent && current.parent !== current) {
              current = current.parent;

              if (
                current.document &&
                current.document.querySelector(
                  'body[data-argo-navigation="true"]',
                )
              ) {
                return true;
              }
            }
          } catch (error) {
            return false;
          }

          return false;
        }

        function resolveUrl(url) {
          if (url.charAt(0) !== "/") {
            return url;
          }

          return getXrm().Utility.getGlobalContext().getClientUrl() + url;
        }

        function createTile(item) {
          var button = document.createElement("button");
          button.className = "tile";
          button.type = "button";
          button.addEventListener("click", function () {
            openNavigationItem(item);
          });

          var icon = document.createElement("span");
          icon.className = "tile-icon";
          icon.textContent = item.icon || getInitials(item.label);
          button.appendChild(icon);

          var text = document.createElement("span");
          var title = document.createElement("span");
          title.className = "tile-title";
          title.textContent = item.label || item.title || "Open";
          text.appendChild(title);

          if (item.description) {
            var description = document.createElement("span");
            description.className = "tile-description";
            description.textContent = item.description;
            text.appendChild(description);
          }

          button.appendChild(text);
          return button;
        }

        function openNavigationItem(item) {
          var page = getFormPage();

          if (page && page.data.getIsDirty()) {
            getXrm()
              .Navigation.openConfirmDialog({
                title: "Unsaved changes",
                text: "This form has unsaved changes. Discard them and continue?",
                confirmButtonLabel: "Discard changes",
                cancelButtonLabel: "Stay on form",
              })
              .then(function (confirmation) {
                if (confirmation.confirmed) {
                  showNavigationItem(item);
                }
              });
            return;
          }

          showNavigationItem(item);
        }

        function showNavigationItem(item) {
          var xrm = getXrm();
          var url = getNavigationItemUrl(xrm, item);
          if (!url) {
            throw new Error(
              "The selected navigation item cannot be displayed in the work area.",
            );
          }

          if (item.openInNewWindow) {
            window.open(url, "_blank", "noopener,noreferrer");
            return;
          }

          if (simpleNavigationState && !navigationFrame) {
            renderEmbeddedPage(
              { url: "about:blank" },
              simpleNavigationState.workArea,
            );
            updateFormCommandBarVisibility();
          }

          if (!navigationFrame) {
            throw new Error(
              "The selected navigation item cannot be displayed in the work area.",
            );
          }

          if (simpleNavigationState) {
            simpleNavigationState.cards.hidden = true;
            simpleNavigationState.workArea.hidden = false;
            simpleNavigationState.body.classList.add("is-showing-work-area");
          }

          navigationFrame.title = item.label || item.title || "Work area";
          // Record where the user is now before leaving it, so Save & Close
          // on the new page can come back here.
          trackLocation();
          beginFrameNavigation();

          navigationFrame.hidden = false;
          setNavigationData(item.data);
          navigationFrame.src = url;
          navigationFrame.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
        }

        function setNavigationData(data) {
          if (data === undefined || data === null || data === "") {
            sessionStorage.removeItem(NAVIGATION_DATA_KEY);
            return;
          }

          sessionStorage.setItem(NAVIGATION_DATA_KEY, String(data));
        }

        function getNavigationItemUrl(xrm, item) {
          if (item.url) {
            return resolveUrl(item.url);
          }

          var clientUrl = xrm.Utility.getGlobalContext().getClientUrl();
          if (item.pageType === "webresource") {
            return appendDataParameter(
              xrm.Utility.getGlobalContext().getWebResourceUrl(
                item.webresourceName,
              ),
              item.data,
            );
          }

          if (item.pageType === "entitylist") {
            return appendDataParameter(
              clientUrl +
                "/main.aspx?appid=" +
                appId +
                "&cmdbar=false&navbar=off&pagetype=entitylist&etn=" +
                encodeURIComponent(item.entityName) +
                (item.viewId
                  ? "&viewid=" + encodeURIComponent(item.viewId)
                  : ""),
              item.data,
            );
          }

          if (item.pageType === "entityrecord") {
            return appendDataParameter(
              clientUrl +
                "/main.aspx?appid=" +
                appId +
                "&cmdbar=false&navbar=off&pagetype=entityrecord&etn=" +
                encodeURIComponent(item.entityName) +
                (item.entityId
                  ? "&id=" + encodeURIComponent(item.entityId)
                  : "") +
                (item.formId
                  ? "&formid=" + encodeURIComponent(item.formId)
                  : ""),
              item.data,
            );
          }

          return "";
        }

        function appendDataParameter(url, data) {
          if (data === undefined || data === null || data === "") {
            return url;
          }

          return (
            url +
            (url.indexOf("?") === -1 ? "?" : "&") +
            "data=" +
            encodeURIComponent(getDataParameterValue(data))
          );
        }

        function getDataParameterValue(data) {
          if (typeof data !== "string") {
            return JSON.stringify(data);
          }

          try {
            JSON.parse(data);
            return data;
          } catch (error) {
            return JSON.stringify(data);
          }
        }

        function isNavigationUrl(url, item) {
          var webResourceName = String(
            item.webresourceName || "",
          ).toLowerCase();
          return (
            webResourceName.indexOf("argonavigation") !== -1 ||
            String(url || "")
              .toLowerCase()
              .indexOf("argonavigation") !== -1
          );
        }

        function toggleNavigation() {
          var navigationGroups = document.getElementById("navigationGroups");
          if (!navigationGroups) {
            return;
          }

          var isHidden = navigationGroups.hidden;
          navigationGroups.hidden = !isHidden;
          navigationGroups.parentElement.classList.toggle(
            "is-navigation-hidden",
            !isHidden,
          );
          setNavigationToggleLabel(
            isHidden ? "Hide navigation" : "Show navigation",
          );
          elements.toggleNavigationButton.setAttribute(
            "aria-expanded",
            String(isHidden),
          );
        }

        function setNavigationToggleLabel(label) {
          clearChildren(elements.toggleNavigationButton);

          var icon = document.createElement("span");
          icon.className = "button-icon";
          icon.setAttribute("aria-hidden", "true");
          icon.textContent = "≡";
          elements.toggleNavigationButton.appendChild(icon);
          elements.toggleNavigationButton.appendChild(
            document.createTextNode(label),
          );
        }

        function buildPageInput(item) {
          if (!item.pageType) {
            throw new Error(
              "Navigation item '" +
                (item.label || item.title || "Open") +
                "' must define pageType or url.",
            );
          }

          var pageInput = {
            pageType: item.pageType,
          };

          [
            "entityName",
            "entityId",
            "viewId",
            "viewType",
            "dashboardId",
            "webresourceName",
            "name",
            "recordId",
            "data",
            "formId",
            "tabName",
          ].forEach(function (propertyName) {
            if (
              item[propertyName] !== undefined &&
              item[propertyName] !== null &&
              item[propertyName] !== ""
            ) {
              pageInput[propertyName] = item[propertyName];
            }
          });

          return pageInput;
        }

        function renderEmpty(userTeams, config) {
          elements.summaryTitle.textContent = "No matching work areas";
          elements.summaryText.textContent =
            "The current user is not in a configured navigation team.";

          var message = createMessage(
            "warning",
            "No matching team",
            "Configured teams did not match the current user's Dataverse teams.",
          );

          if (config === fallbackConfig) {
            var sample = document.createElement("pre");
            sample.className = "sample-config";
            sample.textContent = JSON.stringify(fallbackConfig, null, 2);
            message.appendChild(sample);
          }

          elements.navigationRoot.appendChild(message);
        }

        function renderError(error) {
          elements.summaryTitle.textContent = "Navigation unavailable";
          elements.summaryText.textContent =
            "The web resource could not load the configured actions.";
          elements.navigationRoot.appendChild(
            createMessage(
              "warning",
              "Unable to load navigation",
              error.message || String(error),
            ),
          );
        }

        function createMessage(type, titleText, bodyText) {
          var message = document.createElement("div");
          message.className = "message " + type;

          var title = document.createElement("h3");
          title.textContent = titleText;
          message.appendChild(title);

          var body = document.createElement("p");
          body.textContent = bodyText;
          message.appendChild(body);

          return message;
        }

        function getInitials(value) {
          return String(value || "Open")
            .split(/\s+/)
            .filter(Boolean)
            .slice(0, 2)
            .map(function (part) {
              return part.charAt(0).toUpperCase();
            })
            .join("");
        }

        function cleanGuid(value) {
          return String(value || "")
            .replace(/[{}]/g, "")
            .toLowerCase();
        }

        function normalize(value) {
          return String(value || "")
            .trim()
            .toLowerCase();
        }

        function clearChildren(element) {
          while (element.firstChild) {
            element.removeChild(element.firstChild);
          }
        }

      })();
