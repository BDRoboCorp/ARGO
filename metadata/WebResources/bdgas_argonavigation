            });

            navigationGroups.appendChild(group);
          });

          workspace.appendChild(navigationGroups);
          workspace.appendChild(workArea);
          elements.navigationRoot.appendChild(workspace);

          if (iframeConfig) {
            renderEmbeddedPage(iframeConfig, workArea);
          }

          openRecordShortcut();
        }

        function openRecordShortcut() {
          var parameters = new URLSearchParams(window.location.search);
          var entityName = parameters.get("entity") || parameters.get("etn");
          var entityId = parameters.get("id");
          var shortcutData = parameters.get("data");

          if (shortcutData) {
            try {
              var parsedData = JSON.parse(shortcutData);
              entityName =
                parsedData.entity ||
                parsedData.entityName ||
                parsedData.etn ||
                entityName;
              entityId =
                parsedData.id ||
                parsedData.entityId ||
                parsedData.recordId ||
                entityId;
            } catch (error) {
              var dataParameters = new URLSearchParams(shortcutData);
              entityName = dataParameters.get("entity") || entityName;
              entityId = dataParameters.get("id") || entityId;
            }
          }

          if (!entityName || !entityId) {
            return;
          }

          entityName = entityName.toLowerCase();
          entityId = cleanGuid(entityId);
          if (
            !/^[0-9a-f]{32}$/.test(entityId) &&
            !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(
              entityId,
            )
          ) {
            return;
          }

          openNavigationItem({
            pageType: "entityrecord",
            entityName: entityName,
            entityId: entityId,
            label: entityName,
          });
        }

        function getNavigationItems(matchingTeams) {
          var seenItems = new Set();

          return matchingTeams.reduce(function (items, section) {
            (Array.isArray(section.items) ? section.items : []).forEach(
              function (item) {
                var itemKey = getNavigationItemKey(item);
                if (seenItems.has(itemKey)) {
                  return;
                }

                seenItems.add(itemKey);
                items.push(item);
              },
            );

            return items;
          }, []);
        }

        function getNavigationCategories(items) {
          var categories = new Map();

          items.forEach(function (item) {
            var categoryName =
              item.category === undefined ? "General" : item.category;
            var action =
              item.action === undefined
                ? item.pageType === "entityrecord" && !item.entityId
                  ? "Create"
                  : "List"
                : item.action;

            if (
              typeof categoryName !== "string" ||
              !categoryName.trim() ||
              (action !== "List" && action !== "Create")
            ) {
              throw new Error(
                "Navigation item '" +
                  (item.label || item.title || "Open") +
                  "' must have a non-empty category and a List or Create action.",
              );
            }

            categoryName = categoryName.trim();
            if (!categories.has(categoryName)) {
              categories.set(categoryName, {
                name: categoryName,
                List: [],
                Create: [],
              });
            }
            categories.get(categoryName)[action].push(item);
          });

          return Array.from(categories.values()).sort(function (left, right) {
            return left.name.localeCompare(right.name);
          });
        }

        function getNavigationItemKey(item) {
          return [
            item.label || item.title || "",
            item.pageType || "",
            item.entityName || "",
            item.webresourceName || "",
            item.viewId || "",
            item.url || "",
          ]
            .join("|")
            .toLowerCase();
        }

        function getIframeConfig(config) {
          if (!config || Array.isArray(config) || !config.iframe) {
            return null;
          }

          if (typeof config.iframe === "string") {
            return { url: config.iframe };
          }

          return config.iframe.url ? config.iframe : null;
        }

        function renderEmbeddedPage(iframeConfig, workArea) {
          var hasHeading = Boolean(
            iframeConfig.title || iframeConfig.description,
          );
          var iframeUrl = resolveUrl(iframeConfig.url);
          if (hasHeading) {
            elements.summaryTitle.textContent = iframeConfig.title || "";
            elements.summaryText.textContent = iframeConfig.description || "";
          }

          if (isNavigationUrl(iframeUrl, {})) {
            return;
          }

          renderFormCommandBar(workArea);

          var iframe = document.createElement("iframe");
          iframe.className = "embedded-page";
          iframe.title = iframeConfig.title || "Work area";
          iframe.hidden = true;
          iframe.loading = "eager";
          iframe.referrerPolicy = "same-origin";
          iframe.addEventListener("load", function () {
            if (iframe !== navigationFrame) {
              return;
            }

            iframe.hidden = false;
            isFrameNavigating = false;
          });
          navigationFrame = iframe;
          workArea.appendChild(iframe);
          iframe.src = iframeUrl;
        }

        function renderFormCommandBar(workArea) {
          var bar = document.createElement("div");
          bar.className = "form-command-bar";
          bar.hidden = true;

          formCommands = {
            root: bar,
            back: createCommandButton("← Back", goBackFromForm),
            save: createCommandButton("Save", saveForm),
            saveAndClose: createCommandButton(
              "Save & Close",
              saveAndCloseForm,
            ),
            remove: createCommandButton("Delete", deleteFormRecord),
            cancel: createCommandButton("Cancel", cancelAppointment),
            activate: createCommandButton("Activate", activateProjectMilestone),
            generate: createCommandButton(
              "Generate SRA Document",
              generateSraDocument,
            ),
          };

          formCommands.back.classList.add("back-button");
          formCommands.saveAndClose.classList.add("primary");
          formCommands.remove.classList.add("danger");

          // Simple navigation uses a single Back button: it steps back inside
          // the embedded page when possible, otherwise returns to the menu.
          if (simpleNavigationState) {
            formCommands.menuBack = createSimpleBackButton(
              goBackInSimpleNavigation,
            );
            bar.appendChild(formCommands.menuBack);
          }

          bar.appendChild(formCommands.back);
          var separator = document.createElement("span");
          separator.className = "form-command-separator";
          separator.setAttribute("aria-hidden", "true");
          separator.textContent = "|";
          formCommands.separator = separator;
          bar.appendChild(separator);
          bar.appendChild(formCommands.save);
          bar.appendChild(formCommands.saveAndClose);
          bar.appendChild(formCommands.remove);
          bar.appendChild(formCommands.cancel);
          bar.appendChild(formCommands.activate);
          bar.appendChild(formCommands.generate);
          workArea.appendChild(bar);

          // The embedded Dataverse page navigates inside itself, so the iframe
          // load event can't tell when a form opens or closes. Poll instead.
          currentFormKey = "";
          locationHistory = [];
          currentLocation = null;
          isFrameNavigating = true;
          if (formPollTimer) {
            window.clearInterval(formPollTimer);
          }
          formPollTimer = window.setInterval(syncFormCommandBar, 500);
        }

        function createCommandButton(label, onClick) {
          var button = document.createElement("button");
          button.className = "command-button";
          button.type = "button";
          button.hidden = true;
          button.textContent = label;
          button.addEventListener("click", onClick);
          return button;
        }

        function getFormPage() {
          if (!navigationFrame || navigationFrame.hidden) {
            return null;
          }

          try {
            var frameWindow = navigationFrame.contentWindow;
            var page = frameWindow && frameWindow.Xrm && frameWindow.Xrm.Page;

            if (
              page &&
              page.data &&
              page.data.entity &&
              page.ui &&
              typeof page.ui.getFormType === "function" &&
              page.data.entity.getEntityName()
            ) {
              return page;
            }
          } catch (error) {
            // Cross-origin or not a form page.
          }

          return null;
        }

        function syncFormCommandBar() {
          if (!formCommands || isCommandRunning) {
            return;
          }

          trackLocation();
          formCommands.back.disabled = !hasBackHistory();

          var page = getFormPage();
          if (!page) {
            currentFormKey = "";
            canDeleteCurrentRecord = false;
            hideFormCommands();
            return;
          }

          var entityName = page.data.entity.getEntityName();
          var recordId = cleanGuid(page.data.entity.getId());
          var formType = page.ui.getFormType();
          var stateAttribute = page.getAttribute("statecode");
          var statusAttribute = page.getAttribute("statuscode");
          var stateCode = stateAttribute && stateAttribute.getValue();
          var statusCode = statusAttribute && statusAttribute.getValue();
          var meetingLinkAttribute = entityName === "appointment" &&
            page.getAttribute("onlinemeetingjoinurl");
          var meetingLink = meetingLinkAttribute && meetingLinkAttribute.getValue();
          var slotStatusAttribute = entityName === "appointment" &&
            page.getAttribute("bdgas_slotstatus");
          var slotStatus = slotStatusAttribute && slotStatusAttribute.getValue();
          var formKey = [entityName, recordId, formType, stateCode, statusCode, meetingLink, slotStatus].join("|");

          if (formKey === currentFormKey) {
            return;
          }
          currentFormKey = formKey;
          canDeleteCurrentRecord = false;

          // Form types: 1 = create, 2 = update. Anything else (read-only,
          // disabled, bulk edit) means the user can't save this record.
          var canSave = formType === 1 || formType === 2;
          var isExisting = formType === 2 && Boolean(recordId);

          formCommands.back.hidden = Boolean(formCommands.menuBack);
          formCommands.save.hidden = !canSave;
          formCommands.saveAndClose.hidden = !canSave;
          formCommands.generate.hidden = !(
            isRegulatoryAdmin &&
            canSave &&
            isExisting &&
            entityName === "appointment"
          );
          formCommands.remove.hidden = true;
          formCommands.remove.disabled = true;
          formCommands.cancel.hidden = !(
            entityName === "appointment" &&
            isExisting &&
            slotStatus === 2
          );
          formCommands.activate.hidden = !(
            entityName === "bdgas_projectmilestone" &&
            Boolean(recordId) &&
            (formType === 2 || formType === 3 || formType === 4) &&
            stateCode === 1 &&
            statusCode === 2
          );
          updateFormCommandBarVisibility();

          if (!isExisting) {
            return;
          }

          Promise.all([
            canDeleteRecord(entityName, recordId),
            canDeleteAppointment(entityName, recordId),
          ])
            .then(function (access) {
              if (formKey !== currentFormKey) {
                return;
              }

              canDeleteCurrentRecord = access[0] && access[1];
              formCommands.remove.hidden = !access[0];
              formCommands.remove.disabled = isCommandRunning || !canDeleteCurrentRecord;
              updateFormCommandBarVisibility();
            })
            .catch(function (error) {
              console.warn("Unable to check delete access.", error);
            });
        }

        // Keep a history of the pages shown in the work area (lists, web
        // resources and saved records) so Save & Close / Delete can return to
        // wherever the user came from, e.g. the Project Center record a
        // milestone was opened from.
        function trackLocation() {
          if (isFrameNavigating) {
            return;
          }

          var location = getCurrentLocation();
          if (!location) {
            return;
          }

          if (currentLocation && currentLocation.key === location.key) {
            currentLocation = location;
            return;
          }

          // Unsaved create forms can't be reopened, so they're never a
          // place to return to.
          var isUnsavedRecord = currentLocation && currentLocation.isRecord && !currentLocation.recordId;
          var top = locationHistory[locationHistory.length - 1];
          if (currentLocation && !isUnsavedRecord && (!top || top.key !== currentLocation.key)) {
            locationHistory.push(currentLocation);
            if (locationHistory.length > MAX_LOCATION_HISTORY) {
              locationHistory.shift();
            }
          }

          currentLocation = location;
        }

        function getCurrentLocation() {
          if (!navigationFrame || navigationFrame.hidden) {
            return null;
          }

          var href;
          try {
            href = navigationFrame.contentWindow.location.href;
          } catch (error) {
            return null; // Cross-origin page.
          }

          if (!/^https?:/i.test(href)) {
            return null;
          }

          var data = sessionStorage.getItem(NAVIGATION_DATA_KEY);
          var isRecordUrl = /[?&]pagetype=entityrecord(&|$)/i.test(href);
          if (!isRecordUrl) {
            return { key: "page|" + href, url: href, data: data, isRecord: false };
          }

          // Right after a record is clicked the URL switches to the form
          // before Xrm.Page is ready; wait for the form.
          var page = getFormPage();
          if (!page) {
            return null;
          }

          var entityName = page.data.entity.getEntityName();
          var recordId = cleanGuid(page.data.entity.getId());

          // While moving between records, Xrm.Page can still describe the old
          // one; wait until it matches the URL.
          var urlId = cleanGuid(new URLSearchParams(href.split("?")[1] || "").get("id"));
          if (urlId && recordId && urlId !== recordId) {
            return null;
          }

          return {
            key: "record|" + entityName + "|" + recordId,
            url: recordId
              ? getNavigationItemUrl(getXrm(), {
                  pageType: "entityrecord",
                  entityName: entityName,
                  entityId: recordId,
                })
              : href,
            data: data,
            isRecord: true,
            recordId: recordId,
          };
        }

        function beginFrameNavigation() {
          isFrameNavigating = true;
        }

        function getFormCommandButtons() {
          return [
            formCommands.back,
            formCommands.save,
            formCommands.saveAndClose,
            formCommands.remove,
            formCommands.cancel,
            formCommands.activate,
            formCommands.generate,
          ];
        }

        function hideFormCommands() {
          getFormCommandButtons().forEach(function (button) {
            button.hidden = true;
          });
          updateFormCommandBarVisibility();
        }

        function updateFormCommandBarVisibility() {
          var buttons = getFormCommandButtons();
          if (formCommands.menuBack) {
            buttons.push(formCommands.menuBack);
          }
          formCommands.separator.hidden = formCommands.back.hidden;
          formCommands.root.hidden = buttons.every(function (button) {
            return button.hidden;
          });
        }

        async function canDeleteRecord(entityName, recordId) {
          var xrm = getXrm();
          var globalContext = xrm.Utility.getGlobalContext();
          var metadata = await xrm.Utility.getEntityMetadata(entityName, []);
          var target = {
            "@odata.id": metadata.EntitySetName + "(" + recordId + ")",
          };

          var response = await fetch(
            globalContext.getClientUrl() +
              "/api/data/v9.2/systemusers(" +
              cleanGuid(globalContext.userSettings.userId) +
              ")/Microsoft.Dynamics.CRM.RetrievePrincipalAccess(Target=@target)" +
              "?@target=" +
              encodeURIComponent(JSON.stringify(target)),
            {
              credentials: "same-origin",
              headers: {
                Accept: "application/json",
                "OData-MaxVersion": "4.0",
                "OData-Version": "4.0",
              },
            },
          );

          if (!response.ok) {
            throw new Error(
              "RetrievePrincipalAccess failed with status " + response.status,
            );
          }

          var result = await response.json();
          return String(result.AccessRights || "").indexOf("DeleteAccess") !== -1;
        }

        async function canDeleteAppointment(entityName, recordId) {
          if (entityName !== "appointment" || isRegulatoryAdmin) {
            return true;
          }

          var xrm = getXrm();
          var record = await xrm.WebApi.retrieveRecord(
            "appointment",
            recordId,
            "?$select=onlinemeetingjoinurl,_createdby_value",
          );
          var userId = cleanGuid(
            xrm.Utility.getGlobalContext().userSettings.userId,
          );
          return !String(record.onlinemeetingjoinurl || "").trim() &&
            Boolean(userId) &&
            cleanGuid(record._createdby_value) === userId;
        }

        async function getRegulatoryAdminAccess(userTeams) {
          try {
            var configValue = await getEnvironmentVariableValue(
              REGULATORY_LOCK_CONFIG_SCHEMA_NAME,
            );
            if (!configValue) {
              throw new Error("The regulatory lock configuration is not configured.");
            }

            var config = JSON.parse(configValue);
            if (!config || typeof config.RegulatoryAdmin !== "string" ||
                !cleanGuid(config.RegulatoryAdmin).trim()) {
              throw new Error("The regulatory lock configuration is missing RegulatoryAdmin.");
            }

            var teamId = cleanGuid(config.RegulatoryAdmin.trim());
            return userTeams.some(function (team) {
              return team.id === teamId;
            });
          } catch (error) {
            console.error("Unable to check Regulatory Admin team membership.", error);
            return false;
          }
        }

        function setCommandRunning(isRunning) {
          isCommandRunning = isRunning;
          [
            formCommands.back,
            formCommands.save,
            formCommands.saveAndClose,
            formCommands.remove,
            formCommands.cancel,
            formCommands.activate,
            formCommands.generate,
          ].forEach(function (button) {
            button.disabled = isRunning;
          });
          if (formCommands.menuBack) {
            formCommands.menuBack.disabled = isRunning;
          }
          formCommands.back.disabled = isRunning || !hasBackHistory();
          formCommands.remove.disabled =
            isRunning || !canDeleteCurrentRecord;
        }

        function hasBackHistory() {
          return locationHistory.some(function (location) {
            return !currentLocation || location.key !== currentLocation.key;
          });
        }

        async function showCommandError(error) {
          try {
            await getXrm().Navigation.openErrorDialog({
              message: (error && error.message) || String(error),
            });
          } catch (dialogError) {
            console.error(error);
          }
        }

        function goBackFromForm() {
          if (!navigationFrame || navigationFrame.hidden || isCommandRunning || !hasBackHistory()) {
            return;
          }

          try {
            navigationFrame.contentWindow.history.back();
          } catch (error) {
            console.warn("Unable to return to the previous page.", error);
          }
        }

        async function confirmDiscardChanges(question) {
          var page = getFormPage();
          if (!page || !page.data.getIsDirty()) {
            return true;
          }

          var confirmation = await getXrm().Navigation.openConfirmDialog({
            title: "Unsaved changes",
            text: "This form has unsaved changes. " + question,
            confirmButtonLabel: "Discard changes",
            cancelButtonLabel: "Stay on form",
          });
          return confirmation.confirmed;
        }

        // Removes and returns the most recent history entry that isn't the
        // current page (e.g. the record was opened twice, or just deleted).
        function popBackTarget() {
          var currentKey = currentLocation && currentLocation.key;
          while (locationHistory.length) {
            var candidate = locationHistory.pop();
            if (candidate.key !== currentKey) {
              return candidate;
            }
          }
          return null;
        }

        function navigateFrameTo(target) {
          currentFormKey = "";
          hideFormCommands();
          // The page being left must not be recorded as a place to come back to.
          currentLocation = null;
          beginFrameNavigation();
          setNavigationData(target.data);
          navigationFrame.src = target.url;
        }

        async function goBackInSimpleNavigation() {
          if (isCommandRunning) {
            return;
          }

          if (!navigationFrame || navigationFrame.hidden || !hasBackHistory()) {
            returnToSimpleNavigation();
            return;
          }

          try {
            if (!(await confirmDiscardChanges("Discard them and go back?"))) {
              return;
            }

            // Navigate from our own history instead of the browser's: an
            // iframe's history.back() walks the whole tab's session history
            // and leaves locationHistory out of sync.
            var target = popBackTarget();
            if (target) {
              navigateFrameTo(target);
            } else {
              showSimpleNavigationCards();
            }
          } catch (error) {
            await showCommandError(error);
          }
        }

        function closeForm() {
          var target = popBackTarget();

          if (target) {
            navigateFrameTo(target);
            return;
          }

          currentFormKey = "";
          hideFormCommands();
          currentLocation = null;
          beginFrameNavigation();
          setNavigationData();

          if (simpleNavigationState) {
            showSimpleNavigationCards();
            return;
          }

          if (DEFAULT_IFRAME_URL) {
            navigationFrame.src = resolveUrl(DEFAULT_IFRAME_URL);
          } else {
            navigationFrame.hidden = true;
          }
        }

        async function saveAndCloseForm() {
          var page = getFormPage();
          if (!page || isCommandRunning) {
            return;
          }

          setCommandRunning(true);
          try {
            // Save through the form so OnSave handlers, required-field
            // validation and business rules all run.
            await page.data.save();

            // A blocked save (validation, or an OnSave handler calling
            // preventDefault) leaves the form dirty: stay on it.
            if (page.data.getIsDirty()) {
              return;
            }

            closeForm();
          } catch (error) {
            // The form already shows its own validation and save messages.
            console.warn("Save was not completed.", error);
          } finally {
            setCommandRunning(false);
          }
        }

        async function saveForm() {
          var page = getFormPage();
          if (!page || isCommandRunning) {
            return;
          }

          setCommandRunning(true);
          try {
            await page.data.save();
          } catch (error) {
            console.warn("Save was not completed.", error);
          } finally {
            setCommandRunning(false);
          }
        }

