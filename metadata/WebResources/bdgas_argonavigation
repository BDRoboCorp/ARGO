        function renderNavigation(matchingTeams, userTeams, config) {
          var iframeConfig = {
            url: DEFAULT_IFRAME_URL,
          };

          var navigationItems = getNavigationItems(matchingTeams);

          elements.summaryTitle.textContent = "User Catalog";
          elements.summaryText.textContent = "";

          var workspace = document.createElement("div");
          workspace.className = "workspace";

          var navigationGroups = document.createElement("nav");
          navigationGroups.id = "navigationGroups";
          navigationGroups.className = "navigation-panel";
          navigationGroups.setAttribute("aria-label", "Work areas");

          var workArea = document.createElement("div");
          workArea.className = "work-area";

          setNavigationToggleLabel("Hide navigation");
          elements.toggleNavigationButton.setAttribute("aria-expanded", "true");

          getNavigationCategories(navigationItems).forEach(function (category) {
            var group = document.createElement("details");
            group.className = "navigation-category";
            group.setAttribute("name", "argo-navigation-category");

            var heading = document.createElement("summary");
            heading.textContent = category.name;
            group.appendChild(heading);

            ["List", "Create"].forEach(function (action) {
              if (!category[action].length) {
