<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ARGO: Automations and Regulatory Governance Office</title>
    <style>
      :root {
        --crm-blue: #0f6cbd;
        --crm-blue-strong: #115ea3;
        --crm-border: #d1d1d1;
        --crm-border-soft: #e5e5e5;
        --crm-text: #242424;
        --crm-muted: #616161;
        --crm-surface: #ffffff;
        --crm-page: #f5f5f5;
        --crm-hover: #f3f9ff;
        --crm-focus: #000000;
        --crm-success: #107c10;
        --crm-warning: #8a6100;
        --nav-surface: #ffffff;
        --nav-surface-strong: #0f6cbd;
        --nav-surface-hover: #f3f9ff;
        --nav-border: #e5e5e5;
        --nav-text: #242424;
        --nav-muted: #616161;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        height: 100%;
        overflow: hidden;
      }

      body {
        margin: 0;
        color: var(--crm-text);
        background: var(--crm-page);
        font:
          14px/1.4 "Segoe UI",
          "SegoeUI",
          sans-serif;
      }

      button {
        font: inherit;
      }

      .shell {
        height: 100vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      .command-bar {
        flex: 0 0 40px;
        height: 40px;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0 12px;
        border-bottom: 1px solid var(--crm-border-soft);
        background: var(--crm-surface);
      }

      .brand-logo {
        height: 24px;
        width: auto;
        display: block;
        flex: 0 0 auto;
      }

      .page-title {
        margin: 0;
        font-size: 16px;
        font-weight: 600;
      }

      .user-greeting {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--crm-text);
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
      }

      .user-teams-label {
        color: var(--crm-muted);
        font-weight: 400;
      }

      .user-team-link {
        color: var(--crm-blue-strong);
        font-weight: 600;
        text-decoration: none;
      }

      .user-team-list {
        display: inline-flex;
        gap: 0;
      }

      .user-team-link:hover {
        text-decoration: underline;
      }

      .user-team-link + .user-team-link::before {
        color: var(--crm-muted);
        content: ", ";
        font-weight: 400;
      }

      .content {
        width: 100%;
        height: calc(100vh - 40px);
        flex: 0 0 calc(100vh - 40px);
        min-height: 0;
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        margin: 0;
        padding: 0;
        overflow: hidden;
      }

      .workspace {
        min-height: 0;
        height: 100%;
        display: grid;
        grid-template-columns: minmax(240px, 300px) minmax(0, 1fr);
        gap: 0;
        align-items: stretch;
      }

      .workspace.is-navigation-hidden {
        grid-template-columns: minmax(0, 1fr);
      }

      .navigation-panel {
        min-height: 0;
        height: 100%;
        overflow: auto;
        border: 0;
        border-right: 1px solid var(--crm-border-soft);
        background: var(--nav-surface);
      }

      .work-area {
        min-width: 0;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      .form-command-bar {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 4px 12px;
        border-bottom: 1px solid var(--crm-border-soft);
        background: var(--nav-surface);
      }

      .form-command-separator {
        margin: 0 4px;
        color: var(--crm-muted);
        user-select: none;
      }

      .form-command-bar[hidden],
      .command-button[hidden] {
        display: none;
      }

      .command-button {
        min-height: 32px;
        padding: 5px 12px;
        border: 1px solid var(--crm-border);
        border-radius: 4px;
        color: var(--crm-text);
        background: var(--crm-surface);
        cursor: pointer;
        transition:
          background-color 120ms ease,
          border-color 120ms ease,
          box-shadow 120ms ease,
          color 120ms ease;
      }

      .command-button:hover:not(:disabled) {
        border-color: var(--crm-blue);
        background: var(--nav-surface-hover);
        box-shadow: 0 1px 2px rgb(0 0 0 / 12%);
      }

      .command-button.primary {
        border-color: var(--crm-blue-strong);
        color: #ffffff;
        background: var(--crm-blue);
      }

      .command-button.primary:hover:not(:disabled) {
        border-color: var(--crm-blue-strong);
        color: #ffffff;
        background: var(--crm-blue-strong);
      }

      .command-button.danger {
        color: #a4262c;
      }

      .command-button.danger:hover:not(:disabled) {
        border-color: #a4262c;
        color: #8f1d24;
        background: #fdf3f4;
      }

      .command-button:disabled {
        color: var(--crm-muted);
        cursor: default;
      }

      .command-button:focus-visible {
        outline: 2px solid var(--crm-focus);
        outline-offset: 2px;
      }

      .summary {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 10px 12px;
        margin-bottom: 0;
        color: var(--crm-text);
        background: var(--nav-surface);
        border: 0;
        border-bottom: 1px solid var(--crm-border-soft);
      }

      .summary h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 600;
        color: var(--crm-blue-strong);
      }

      .summary p {
        margin: 2px 0 0;
        color: var(--crm-muted);
      }

      .refresh-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 32px;
        padding: 5px 12px;
        border: 1px solid var(--crm-blue-strong);
        border-radius: 2px;
        color: #ffffff;
        background: var(--crm-blue);
        cursor: pointer;
      }

      .refresh-button:hover {
        border-color: var(--crm-blue-strong);
        color: #ffffff;
        background: var(--crm-blue-strong);
      }

      .button-icon {
        display: inline-grid;
        width: 16px;
        height: 16px;
        place-items: center;
        font-size: 17px;
        line-height: 1;
      }

      .summary-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .refresh-button:focus-visible,
      .tile:focus-visible {
        outline: 2px solid var(--crm-focus);
        outline-offset: 2px;
      }

      .tile-grid {
        display: block;
        background: var(--nav-surface);
      }

      .navigation-category {
        border-bottom: 1px solid var(--nav-border);
      }

      .navigation-category > summary {
        padding: 10px 12px;
        color: var(--nav-text);
        background: var(--crm-page);
        font-weight: 600;
        cursor: pointer;
      }

      .navigation-category > summary:focus-visible {
        outline: 2px solid var(--crm-focus);
        outline-offset: -2px;
      }

      .navigation-action-title {
        margin: 0;
        padding: 8px 12px 4px;
        color: var(--nav-muted);
        font-size: 12px;
        font-weight: 600;
      }

      .tile {
        width: 100%;
        min-height: 64px;
        display: grid;
        grid-template-columns: 40px 1fr;
        align-content: start;
        gap: 8px;
        padding: 10px;
        border: 0;
        border-bottom: 1px solid var(--nav-border);
        color: var(--nav-text);
        background: var(--nav-surface);
        text-align: left;
        cursor: pointer;
      }

      .tile:last-child {
        border-bottom: 0;
      }

      .tile:hover {
        background: var(--nav-surface-hover);
      }

      .tile-icon {
        width: 40px;
        height: 40px;
        display: grid;
        place-items: center;
        border-radius: 2px;
        color: var(--nav-surface-strong);
        background: var(--blue-icon-background, #eef6fc);
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0;
      }

      .tile:nth-child(4n + 2) .tile-icon {
        color: #c25b00;
        background: #fff4e5;
      }

      .tile:nth-child(4n + 3) .tile-icon {
        color: #087f8c;
        background: #e7f7f8;
      }

      .tile:nth-child(4n + 4) .tile-icon {
        color: #6b2d8b;
        background: #f4eafa;
      }

      .tile-title {
        display: block;
        margin-top: 1px;
        font-weight: 600;
      }

      .tile-description {
        display: block;
        margin-top: 4px;
        color: var(--nav-muted);
        font-size: 12px;
      }

      .embedded-page {
        width: 100%;
        flex: 1 1 0;
        min-height: 0;
        display: block;
        border: 0;
        background: var(--crm-surface);
      }

      .message {
        border-left: 4px solid var(--crm-blue);
        padding: 10px 12px;
        background: var(--crm-surface);
      }

      .user-profile {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 4px 16px;
        margin-bottom: 10px;
        padding: 8px 12px;
        border: 1px solid var(--crm-border-soft);
        background: var(--crm-surface);
        font-size: 12px;
      }

      .user-profile strong {
        font-size: 13px;
      }

      .user-profile-link {
        color: var(--crm-blue-strong);
        text-decoration: none;
        cursor: pointer;
      }

      .user-profile-link:hover {
        text-decoration: underline;
      }

      .user-profile-link:focus-visible {
        outline: 2px solid var(--crm-focus);
        outline-offset: 2px;
      }

      .user-profile-label {
        color: var(--crm-muted);
      }

      .user-profile-teams {
        flex: 1 1 260px;
        min-width: 0;
      }

      .user-team-link + .user-team-link::before {
        color: var(--crm-muted);
        content: ", ";
      }

      .message.warning {
        border-left-color: var(--crm-warning);
      }

      .message.success {
        border-left-color: var(--crm-success);
      }

      .message h3 {
        margin: 0 0 6px;
        font-size: 15px;
        font-weight: 600;
      }

      .message p {
        margin: 0;
        color: var(--crm-muted);
      }

      .sample-config {
        max-height: 320px;
        overflow: auto;
        margin-top: 12px;
        padding: 12px;
        border: 1px solid var(--crm-border-soft);
        background: #fafafa;
        color: #323130;
        font:
          12px/1.45 Consolas,
          "Courier New",
          monospace;
        white-space: pre;
      }

      .content.is-simple-navigation .summary {
        display: none;
      }

      .content.is-simple-navigation {
        grid-template-rows: minmax(0, 1fr);
      }

      .simple-navigation {
        height: 100%;
        min-height: 0;
        display: flex;
        flex-direction: column;
      }

      .simple-navigation-body {
        flex: 1 1 0;
        min-height: 0;
        overflow: auto;
        padding: 32px 48px;
      }

      .simple-navigation-body.is-showing-work-area {
        overflow: hidden;
        padding: 0;
      }

      .simple-footer {
        flex: 0 0 auto;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px 24px;
        padding: 12px 48px;
        border-top: 1px solid var(--crm-border-soft);
        background: var(--crm-surface);
        color: var(--crm-muted);
        font-size: 12px;
      }

      .simple-footer a {
        color: #782578;
      }

      .simple-footer a:focus-visible {
        outline: 2px solid var(--crm-focus);
        outline-offset: 2px;
      }

      .simple-navigation [hidden] {
        display: none;
      }

      .simple-navigation h2 {
        margin: 0 0 8px;
        font-size: 24px;
      }

      .simple-description {
        margin: 0 0 28px;
        color: var(--crm-muted);
      }

      .simple-card-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 240px));
        gap: clamp(8px, 1.5vw, 16px);
      }

      .simple-card {
        min-width: 0;
        min-height: 260px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: clamp(8px, 1.5vw, 20px);
        border: 1px solid var(--crm-border-soft);
        border-radius: 6px;
        background: var(--crm-surface);
        overflow-wrap: anywhere;
      }

      .simple-card-icon {
        display: grid;
        place-items: center;
        min-width: 40px;
        width: max-content;
        max-width: 100%;
        min-height: 40px;
        padding: 8px;
        border-radius: 5px;
        color: #782578;
        background: #f3e7f3;
        font-weight: 600;
        white-space: nowrap;
        overflow-wrap: normal;
      }

      .simple-card-icon img {
        display: block;
        width: 24px;
        max-width: 100%;
        height: 24px;
        object-fit: contain;
      }

      .simple-card h3 {
        max-width: 100%;
        margin: 16px 0 8px;
        font-size: 16px;
      }

      .simple-card p {
        max-width: 100%;
        margin: 0 0 16px;
        color: var(--crm-muted);
      }

      .simple-card-button {
        width: 100%;
        margin-top: auto;
        padding: 8px 4px;
        border: 0;
        border-radius: 3px;
        color: #ffffff;
        background: #782578;
        font-weight: 600;
        cursor: pointer;
      }

      .simple-card-button:hover {
        background: #602060;
      }

      .simple-back {
        align-self: flex-start;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 36px;
        margin-bottom: 24px;
        padding: 7px 14px;
        border: 1px solid #ddc7dd;
        border-radius: 6px;
        color: #782578;
        background: var(--crm-surface);
        font-weight: 600;
        cursor: pointer;
        transition:
          background-color 120ms ease,
          border-color 120ms ease;
      }

      .simple-back:hover {
        border-color: #782578;
        background: #f3e7f3;
      }

      .simple-back:active {
        background: #e8d3e8;
      }

      .simple-back-icon {
        width: 16px;
        height: 16px;
        background: currentColor;
        clip-path: polygon(
          40% 15%, 49% 24%, 29% 44%, 90% 44%,
          90% 56%, 29% 56%, 49% 76%, 40% 85%, 5% 50%
        );
      }

      .form-command-bar .simple-back {
        align-self: center;
        min-height: 32px;
        margin: 0 4px 0 0;
        padding: 5px 12px;
      }

      .form-command-bar .simple-back[hidden],
      .form-command-separator[hidden] {
        display: none;
      }

      .simple-card-button:focus-visible,
      .simple-back:focus-visible {
        outline: 2px solid var(--crm-focus);
        outline-offset: 2px;
      }

      .simple-work-area {
        height: 100%;
      }

      @media (max-width: 640px) {
        .simple-navigation-body {
          padding: 24px 16px;
        }

        .simple-footer {
          padding: 12px 16px;
        }

        .command-bar {
          padding: 0 12px;
        }

        .workspace {
          grid-template-columns: 1fr;
        }

        .navigation-panel {
          height: auto;
          max-height: 40vh;
          border-right: 0;
          border-bottom: 1px solid var(--crm-border-soft);
        }

        .summary {
          align-items: stretch;
        }

        .refresh-button {
          width: 100%;
        }

        .tile-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body data-argo-navigation="true">
    <main class="shell">
      <header class="command-bar">
        <img
          class="brand-logo"
          src="/WebResources/bdgas_BDLogo"
          alt="BD"
        />
        <h1 class="page-title">
          ARGO: Automations and Regulatory Governance Office
        </h1>
        <div class="user-greeting" id="userGreeting"></div>
      </header>

      <section class="content" aria-live="polite">
        <div class="summary">
          <div>
            <h2 id="summaryTitle">User Catalog</h2>
            <p id="summaryText">Checking your team access.</p>
          </div>
          <div class="summary-actions">
            <button
              class="refresh-button"
              type="button"
              id="toggleNavigationButton"
              aria-controls="navigationGroups"
              aria-expanded="true"
            >
              <span class="button-icon" aria-hidden="true">≡</span>
              Hide navigation
            </button>
            <button class="refresh-button" type="button" id="refreshButton">
              <span class="button-icon" aria-hidden="true">↻</span>
              Refresh
            </button>
          </div>
        </div>
        <div id="navigationRoot"></div>
      </section>
    </main>

    <script>
      (function () {
        "use strict";

        var CONFIG_NAME = "ARGO Navigation";
        var DEFAULT_APP_ID = "cebc59c4-bf80-f111-ab0f-000d3a11e677";
        var DEFAULT_IFRAME_URL = "/webresources/bdgas_argoprojectcenter.html";
        var GENERATE_SRA_FLOW_SCHEMA_NAME = "bdgas_ARGOGenerateSRA";
        var REGULATORY_LOCK_CONFIG_SCHEMA_NAME =
          "bdgas_regulatorylockconfiguration";
        var NAVIGATION_DATA_KEY = "bdgas_sraAppointmentNavigationData";

        var fallbackConfig = { teams: [] };
        var navigationFrame = null;
        var appId = DEFAULT_APP_ID;
        var formCommands = null;
        var formPollTimer = null;
        var currentFormKey = "";
        var isCommandRunning = false;
        var MAX_LOCATION_HISTORY = 20;
        var locationHistory = [];
        var currentLocation = null;
        var isFrameNavigating = false;
        var isRegulatoryAdmin = false;
        var canDeleteCurrentRecord = false;
        var simpleNavigationState = null;

        var elements = {
          navigationRoot: document.getElementById("navigationRoot"),
          toggleNavigationButton: document.getElementById(
            "toggleNavigationButton",
          ),
          refreshButton: document.getElementById("refreshButton"),
          summaryTitle: document.getElementById("summaryTitle"),
          summaryText: document.getElementById("summaryText"),
          userGreeting: document.getElementById("userGreeting"),
        };

        elements.refreshButton.addEventListener("click", refreshWorkArea);
        elements.toggleNavigationButton.addEventListener(
          "click",
          toggleNavigation,
        );
        window.bdgasArgoNavigationHost = {
          openItem: openNavigationItem,
        };
        loadNavigation();

        // Reload only what is shown in the work area; rebuild the whole page
        // only when there is no work area yet (e.g. navigation failed to load).
        function refreshWorkArea() {
          if (!navigationFrame || navigationFrame.hidden) {
            loadNavigation();
            return;
          }

          var page = getFormPage();
          if (page && page.data.getIsDirty()) {
            getXrm()
              .Navigation.openConfirmDialog({
                title: "Unsaved changes",
                text: "This form has unsaved changes. Discard them and refresh?",
                confirmButtonLabel: "Discard changes",
                cancelButtonLabel: "Stay on form",
              })
              .then(function (confirmation) {
                if (confirmation.confirmed) {
                  reloadFrame();
                }
              });
            return;
          }

          reloadFrame();
        }

        function reloadFrame() {
          currentFormKey = "";
          beginFrameNavigation();

          try {
            navigationFrame.contentWindow.location.reload();
          } catch (error) {
            // Cross-origin page: reload it from its last known address.
            navigationFrame.src = navigationFrame.src;
          }
        }

        async function loadNavigation() {
          isRegulatoryAdmin = false;
          currentFormKey = "";
          resetNavigationWorkArea();
          simpleNavigationState = null;
          elements.navigationRoot.parentElement.classList.remove(
            "is-simple-navigation",
          );
          elements.toggleNavigationButton.hidden = false;
          clearChildren(elements.navigationRoot);
          elements.summaryTitle.textContent = "User Catalog";
          elements.summaryText.textContent = "Checking your team access.";

          try {
            var xrm = getXrm();
            var config = await getNavigationConfig(xrm);
            appId = config.appId || DEFAULT_APP_ID;
            var configuredIframe = getIframeConfig(config);
            DEFAULT_IFRAME_URL = "/webresources/bdgas_argoprojectcenter.html";

            if (hasArgoNavigationParent()) {
              if (DEFAULT_IFRAME_URL) {
                window.location.replace(resolveUrl(DEFAULT_IFRAME_URL));
              }
              return;
            }

            var currentUser = await getCurrentUser(xrm);
            var matchingTeams = findMatchingTeams(config, currentUser.teams);
            isRegulatoryAdmin = await getRegulatoryAdminAccess(currentUser.teams);
            renderUserProfile(currentUser, matchingTeams);

            if (matchingTeams.length === 0) {
              renderEmpty(currentUser.teams, config);
              return;
            }

            if (shouldUseSimpleNavigation(config, matchingTeams, currentUser.teams)) {
              renderSimpleNavigation(config.simpleNavigation, config.emailTo);
            } else {
              renderNavigation(matchingTeams, currentUser.teams, config);
            }
          } catch (error) {
            renderError(error);
          }
        }

        function getXrm() {
          var current = window;
          while (true) {
            try {
              if (
                current.Xrm &&
                current.Xrm.WebApi &&
                current.Xrm.Navigation &&
                current.Xrm.Utility
              ) {
                return current.Xrm;
              }
            } catch (error) {
              // Cross-origin frame; can't inspect it, keep walking up.
            }

            if (!current.parent || current.parent === current) {
              break;
            }
            current = current.parent;
          }

          throw new Error(
            "This web resource must be opened inside a model-driven app.",
          );
        }

        async function getNavigationConfig(xrm) {
          var query =
            "?$select=bdgas_value&$filter=bdgas_name eq '" +
            CONFIG_NAME +
            "'&$top=1";
          var result = await xrm.WebApi.retrieveMultipleRecords(
            "bdgas_argoconfig",
            query,
          );

          if (!result.entities.length) {
            return fallbackConfig;
          }

          var configValue = result.entities[0].bdgas_value;
          if (!configValue) {
            return fallbackConfig;
          }

          try {
            return JSON.parse(configValue);
          } catch (error) {
            throw new Error(
              "ARGO Config '" +
                CONFIG_NAME +
                "'" +
                " contains invalid JSON: " +
                error.message,
            );
          }
        }

        async function getCurrentUser(xrm) {
          var userId = cleanGuid(
            xrm.Utility.getGlobalContext().userSettings.userId,
          );
          var result = await xrm.WebApi.retrieveRecord(
            "systemuser",
            userId,
            "?$select=fullname,internalemailaddress&$expand=teammembership_association($select=teamid,name)",
          );

          return {
            id: userId,
            name: result.fullname || "Current user",
            email: result.internalemailaddress || "",
            teams: (result.teammembership_association || []).map(
              function (team) {
                return {
                  id: cleanGuid(team.teamid),
                  name: team.name || "",
                };
              },
            ),
          };
        }

        function renderUserProfile(currentUser, matchingTeams) {
          clearChildren(elements.userGreeting);

          var greeting = document.createElement("span");
          greeting.textContent = "Hi, " + currentUser.name;
          elements.userGreeting.appendChild(greeting);

          var matchedUserTeams = getMatchedUserTeams(
            matchingTeams,
            currentUser.teams,
          );

          if (!matchedUserTeams.length) {
            return;
          }

          var label = document.createElement("span");
          label.className = "user-teams-label";
          label.textContent = "Teams:";
          elements.userGreeting.appendChild(label);

          var teamList = document.createElement("span");
          teamList.className = "user-team-list";

          matchedUserTeams.forEach(function (team) {
            var link = document.createElement("a");
            link.className = "user-team-link";
            link.href = "#";
            link.textContent = team.name;
            link.addEventListener("click", function (event) {
              event.preventDefault();
              openEntityRecord("team", team.id);
            });
            teamList.appendChild(link);
          });

          elements.userGreeting.appendChild(teamList);
        }

        function getMatchedUserTeams(matchingTeams, userTeams) {
          var matchedIds = new Set();
          var matchedNames = new Set();

          matchingTeams.forEach(function (section) {
            (section.teamIds || (section.teamId ? [section.teamId] : [])).forEach(
              function (teamId) {
                matchedIds.add(cleanGuid(teamId));
              },
            );
            (section.teamNames || (section.teamName ? [section.teamName] : [])).forEach(
              function (teamName) {
                matchedNames.add(normalize(teamName));
              },
            );
          });

          return userTeams.filter(function (team) {
            return (
              matchedIds.has(team.id) ||
              matchedNames.has(normalize(team.name))
            );
          });
        }

        function openEntityRecord(entityName, entityId) {
          var pageInput = {
            pageType: "entityrecord",
            entityName: entityName,
            entityId: entityId,
            label: entityName,
          };

          if (navigationFrame) {
            openNavigationItem(pageInput);
            return;
          }

          getXrm().Navigation.navigateTo(pageInput, { target: 1 });
        }

        function findMatchingTeams(config, userTeams) {
          var sections = Array.isArray(config) ? config : config.teams;
          var userTeamIds = new Set(
            userTeams.map(function (team) {
              return team.id;
            }),
          );
          var userTeamNames = new Set(
            userTeams.map(function (team) {
              return normalize(team.name);
            }),
          );

          if (!Array.isArray(sections)) {
            throw new Error(
              "ARGO Config '" +
                CONFIG_NAME +
                "' must be a JSON array or an object with a teams array.",
            );
          }

          return sections.filter(function (section) {
            var configuredIds =
              section.teamIds || (section.teamId ? [section.teamId] : []);
            var configuredNames =
              section.teamNames || (section.teamName ? [section.teamName] : []);
            var matchesId = configuredIds.some(function (teamId) {
              return userTeamIds.has(cleanGuid(teamId));
            });
            var matchesName = configuredNames.some(function (teamName) {
              return userTeamNames.has(normalize(teamName));
            });

            return matchesId || matchesName;
          });
        }

        function shouldUseSimpleNavigation(config, matchingTeams, userTeams) {
          var simple = config.simpleNavigation;
          if (!simple || !simple.enabled || matchingTeams.length !== 1) {
            return false;
          }

          var matchedUserTeams = getMatchedUserTeams(matchingTeams, userTeams);
          return matchedUserTeams.length === 1 &&
            findMatchingTeams({ teams: [simple] }, matchedUserTeams).length === 1;
        }

        function resetNavigationWorkArea() {
          if (formPollTimer) {
            window.clearInterval(formPollTimer);
            formPollTimer = null;
          }
          navigationFrame = null;
          currentFormKey = "";
          currentLocation = null;
          locationHistory = [];
          isFrameNavigating = false;
        }

        function renderSimpleNavigation(config, emailTo) {
          if (!Array.isArray(config.items) || !config.items.length ||
              config.items.some(function (process) {
                return !process.label || !Array.isArray(process.items) ||
                  !process.items.length || process.items.some(function (item) {
                    return !item.label ||
                      (item.action !== "List" && item.action !== "Create") ||
                      !(item.url ||
                        (item.pageType === "webresource" && item.webresourceName) ||
                        ((item.pageType === "entitylist" ||
                          item.pageType === "entityrecord") && item.entityName));
                  });
              })) {
            throw new Error(
              "ARGO simpleNavigation requires processes with valid navigation items.",
            );
          }

          elements.navigationRoot.parentElement.classList.add("is-simple-navigation");
          elements.toggleNavigationButton.hidden = true;

          var root = document.createElement("div");
          root.className = "simple-navigation";
          var body = document.createElement("div");
          body.className = "simple-navigation-body";
          var cards = document.createElement("div");
          var workArea = document.createElement("div");
          workArea.className = "work-area simple-work-area";
          workArea.hidden = true;
          body.appendChild(cards);
          body.appendChild(workArea);
          root.appendChild(body);
          root.appendChild(createSimpleNavigationFooter(emailTo));
          elements.navigationRoot.appendChild(root);
          simpleNavigationState = {
            config: config,
            body: body,
            cards: cards,
            workArea: workArea,
            process: null,
          };
          renderSimpleNavigationPage(null, false);
