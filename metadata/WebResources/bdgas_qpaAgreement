<html><head>
    <meta charset="utf-8">

    <style>

        html,
        body {
            height: 100%;
            margin: 0;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        .container {
            display: flex;
            flex-direction: column;
            height: 100%;
            padding: 20px;
            box-sizing: border-box;
        }

        #agreementContent {
            flex: 1;
            overflow-y: auto;
            line-height: 1.6;
        }

        #agreementContent ul {
            padding-left: 25px;
        }

        #agreementContent li {
            margin-bottom: 8px;
        }

        .buttonBar {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            padding-top: 15px;
            border-top: 1px solid #d0d0d0;
            margin-top: 15px;
        }

        #btnAgree {
            background-color: #0078d4;
            color: white;
            border: none;
            padding: 8px 20px;
            cursor: pointer;
        }

        #btnCancel {
            padding: 8px 20px;
            cursor: pointer;
        }

    </style>

<meta><meta></head>

<body style="overflow-wrap: break-word;">

    <div class="container" style="font-family: undefined;">

        <div id="agreementContent"><br></div>

        <div class="buttonBar">

            <button id="btnAgree">
                I Agree
            </button>

            <button id="btnCancel">
                Cancel
            </button>

        </div>

    </div>

    <script>

        /*window.onload = function () {

            var agreementHtml =
                sessionStorage.getItem(
                    "bdgas_qpaagreement"
                );

            if (agreementHtml) {

                document.getElementById(
                    "agreementContent"
                ).innerHTML = agreementHtml;
            }
        };*/

        window.onload = function () {

            var params =
                new URLSearchParams(
                    window.location.search
                );

            var agreementHtml =
                params.get("data");

            if (agreementHtml) {

                document.getElementById(
                    "agreementContent"
                ).innerHTML =
                    decodeURIComponent(
                        agreementHtml
                    );
            }
        };

        document.getElementById(
            "btnAgree"
        ).onclick = function () {

            sessionStorage.setItem(
                "bdgas_qpaAgreementResult",
                "agree"
            );

            window.close();
        };

        document.getElementById(
            "btnCancel"
        ).onclick = function () {

            sessionStorage.setItem(
                "bdgas_qpaAgreementResult",
                "cancel"
            );

            window.close();
        };

    </script>


</body></html>