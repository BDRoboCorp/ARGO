SRAAppointment.updateNavigationParameterAccess =
    async function (formContext) {

        var lockConfiguration =
            await SRAAppointment.getRegulatoryLockConfiguration();

        var regulatoryAdminTeamId =
            lockConfiguration.RegulatoryAdmin ||
            SRAAppointment.regulatoryAdminTeamId;

        var isRegulatoryAdmin =
            await SRAAppointment.isCurrentUserInTeam(
                regulatoryAdminTeamId
            );

        var previousAccess =
            SRAAppointment.navigationTabAccess.get(formContext);
        if (previousAccess) {
            previousAccess.controls.forEach(function (wasDisabled, control) {
                control.setDisabled(wasDisabled);
            });
        }

        SRAAppointment.lockAlwaysReadOnlyFields(formContext);
        await SRAAppointment.updateRegulatoryAdminFieldAccess(
            formContext, isRegulatoryAdmin
        );

        var slotStatusAttribute =
            formContext.getAttribute(
                "bdgas_slotstatus"
            );

        var slotStatus =
            slotStatusAttribute
                ? slotStatusAttribute.getValue()
                : null;


        var isCurrentUserCreator =
            SRAAppointment.hasCurrentUserAsCreator(
                formContext
            );

        // Slot Status option values:
        // Available = 0, Not Available = 1, Reserved = 2,
        // Post Assessment = 3, Cancel = 6.

        var editableTabs = new Set();
        var readOnlyForm = false;

        function allowTab(tabName, allowed) {
            if (allowed !== false) {
                editableTabs.add(tabName);
            }
        }

        // Not Regulatory Admin.
        var isCurrentUserRegistrant =
            SRAAppointment.isCurrentUserRegistrant(
                formContext
            );


        if (isRegulatoryAdmin) {

            allowTab(
                "appointment",
                slotStatus !== 5
            );

            var showRegulatoryAssessmentTabs =
                slotStatus === 6 ||
                slotStatus === 1 ||
                slotStatus === 2 ||
                slotStatus === 3;

            if (showRegulatoryAssessmentTabs) {
                allowTab(
                    "tab_RegulatoryAssessment",
                    true
                );

                allowTab(
                    "tab_SRAMeetingDetail",
                    true
                );
            }

            if (
                slotStatus === 2 ||
                slotStatus === 3
            ) {
                allowTab(
                    "tab_5",
                    true
                );
            }

            SRAAppointment.setHeaderControlVisible(
                formContext,
                "bdgas_slotstatus",
                true
            );

            if (SRAAppointment.hasDataParameter(
                "MyScheduler"
            )) {
                allowTab(
                    "appointment",
                    true
                );
            }

            if (slotStatus !== 0) {
                allowTab(
                    "tab_SRAssessment",
                    true
                );
            }

            SRAAppointment.applyNavigationTabAccess(
                formContext, editableTabs, readOnlyForm
            );
            return;
        }

        if (slotStatus === 5) {
            // Digital SRA.

            if (isCurrentUserCreator) {
                allowTab(
                    "tab_SRAssessment",
                    true
                );
            }
            else {
                allowTab(
                    "appointment",
                    true
                );

                readOnlyForm = true;
            }
        }
        else if (
            slotStatus === 0 &&
            SRAAppointment.hasDataParameter(
                "MyScheduler"
            )
        ) {
            allowTab(
                "appointment",
                true
            );
        }
        else if (
            slotStatus === 2 &&
            (isCurrentUserRegistrant || isCurrentUserCreator)
        ) {
            allowTab(
                "appointment",
                true
            );

            allowTab(
                "tab_SRAssessment",
                true
            );
        }
        else {
            allowTab(
                "appointment",
                true
            );

            readOnlyForm = true;
        }

        SRAAppointment.applyNavigationTabAccess(
            formContext, editableTabs, readOnlyForm
        );

        var hasOwnedOnlineMeeting =
            SRAAppointment.hasOwnedOnlineMeeting(
                formContext
            );

        SRAAppointment.setHeaderControlVisible(
            formContext,
            "bdgas_slotstatus",
            hasOwnedOnlineMeeting ||
            isCurrentUserRegistrant || isCurrentUserCreator
        );

        if (
            hasOwnedOnlineMeeting ||
            isCurrentUserRegistrant ||
            isCurrentUserCreator
        ) {
            SRAAppointment.enableOwnedMeetingSlotStatus(
                formContext
            );
        }
    };

SRAAppointment.enableOwnedMeetingSlotStatus =
    function (formContext) {

        var slotStatusAttribute =
            formContext.getAttribute(
                "bdgas_slotstatus"
            );

        if (!slotStatusAttribute) {
            return;
        }

        slotStatusAttribute.controls.forEach(
            function (control) {
                control.setDisabled(false);

                control.getOptions().forEach(
                    function (option) {
                        var optionValue =
                            Number(option.value);

                        if (
                            optionValue !== 2 &&
                            optionValue !== 6
                        ) {
                            control.removeOption(
                                option.value
                            );
                        }
                    }
                );
            }
        );
    };

SRAAppointment.hasOwnedOnlineMeeting =
    function (formContext) {

        var joinUrlAttribute =
            formContext.getAttribute(
                "onlinemeetingjoinurl"
            );

        var createdByAttribute =
            formContext.getAttribute(
                "createdby"
            );

        var modifiedByAttribute =
            formContext.getAttribute(
                "modifiedby"
            );

        if (
            !joinUrlAttribute ||
            !joinUrlAttribute.getValue()
        ) {
            return false;
        }

        var createdByValue =
            createdByAttribute
                ? createdByAttribute.getValue()
                : null;

        var modifiedByValue =
            modifiedByAttribute
                ? modifiedByAttribute.getValue()
                : null;

        var currentUserId =
            Xrm.Utility.getGlobalContext()
                .userSettings.userId
                .replace(/[{}]/g, "")
                .toLowerCase();

        var createdById =
            createdByValue &&
                createdByValue.length > 0
                ? String(createdByValue[0].id || "")
                    .replace(/[{}]/g, "")
                    .toLowerCase()
                : "";

        var modifiedById =
            modifiedByValue &&
                modifiedByValue.length > 0
                ? String(modifiedByValue[0].id || "")
                    .replace(/[{}]/g, "")
                    .toLowerCase()
                : "";

        return Boolean(
            createdById === currentUserId ||
            modifiedById === currentUserId
        );
    };

