SRAAppointment.isCurrentUserInTeam =
    async function (teamId) {

        if (!teamId) {
            return false;
        }

        var userId =
            Xrm.Utility
                .getGlobalContext()
                .userSettings
                .userId;

        userId =
            userId.replace(/[{}]/g, "");

        teamId =
            teamId.replace(/[{}]/g, "");

        var query =
            "?$select=teammembershipid" +
            "&$filter=" +
            "teamid eq " + teamId +
            " and systemuserid eq " + userId +
            "&$top=1";

        try {
            var result =
                await Xrm.WebApi.retrieveMultipleRecords(
                    "teammembership",
                    query
                );

            return Boolean(
                result &&
                result.entities &&
                result.entities.length > 0
            );
        }
        catch (error) {
            console.error(
                "Unable to check Regulatory Admin team membership.",
                error
            );

            /*
             * Fail closed:
             * If membership cannot be confirmed, treat the user as
             * a non-member and keep the fields readonly.
             */
            return false;
        }
