SRAAppointment.getRaMasterBooleanLookup =
    async function (category, booleanValue) {
        /*
         * Do not treat null or undefined as No.
         * Only map an actual Boolean value.
         */
        if (
            booleanValue !== true &&
            booleanValue !== false
        ) {
            console.log(
                "[SRA] RA Master mapping skipped. " +
                "Source Boolean is null or undefined:",
                category
            );

            return null;
        }

        var name =
            booleanValue === true
                ? "Yes"
                : "No";

        var escapedCategory =
            category.replace(/'/g, "''");

        var escapedName =
            name.replace(/'/g, "''");

        var query =
            "?$select=" +
            "bdgas_regulatoryassessmentmasterid," +
            "bdgas_name," +
            "bdgas_category," +
            "bdgas_sequence" +
            "&$filter=" +
            "bdgas_category eq '" +
            escapedCategory +
            "' and " +
            "bdgas_name eq '" +
            escapedName +
            "'" +
            "&$orderby=bdgas_sequence asc" +
            "&$top=1";

        var result =
            await Xrm.WebApi.retrieveMultipleRecords(
                "bdgas_regulatoryassessmentmaster",
                query
            );

        if (
            !result ||
            !result.entities ||
            result.entities.length === 0
        ) {
            console.warn(
                "[SRA] RA Master record not found.",
                {
                    category: category,
                    name: name
                }
            );

            return null;
        }

        var record =
            result.entities[0];

        return {
            id: record.bdgas_regulatoryassessmentmasterid,
            name: record.bdgas_name,
            entityType: "bdgas_regulatoryassessmentmaster"
        };
    };

