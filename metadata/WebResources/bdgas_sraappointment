var SRAAppointment = SRAAppointment || {};

SRAAppointment.onLoad = function (executionContext) {
    SRAAppointment.onLoadAsync(
        executionContext
    ).catch(function (error) {
        console.error(error);

        Xrm.Navigation.openAlertDialog({
            text: error.message || String(error)
        });
    });
};

SRAAppointment.onLoadAsync = async function (executionContext) {

    var formContext = executionContext.getFormContext();

    

    try {
        if (
            await SRAAppointment.redirectToLatestDigitalSraAppointment(
                formContext
            )
        ) {
            return;
        }

        formContext.data.entity.removeOnSave(
            SRAAppointment.onSave
        );

        formContext.data.entity.addOnSave(
            SRAAppointment.onSave
        );

        formContext.data.entity.removeOnPostSave(
            SRAAppointment.onPostSave
        );

        formContext.data.entity.addOnPostSave(
            SRAAppointment.onPostSave
        );

        var isCreateForm =
            formContext.ui.getFormType() === 1;

        var onlineMeetingType =
            formContext.getAttribute(
                "onlinemeetingtype"
            );

        if (onlineMeetingType) {
            onlineMeetingType.setSubmitMode(
                "never"
            );
        }

        formContext.getControl("bdgas_productiondatawillbeusedid").setLabel("If Proof of Concept or a Non-Production use system, will Production data be used?");
        var slotStatus = formContext.getAttribute("bdgas_slotstatus");

        if (slotStatus) {
            slotStatus.removeOnChange(SRAAppointment.onSlotStatusChange);
            slotStatus.addOnChange(SRAAppointment.onSlotStatusChange);
        }

        var scheduleSraType =
            formContext.getAttribute(
                "bdgas_schedulesratype"
            );

        if (scheduleSraType) {
            scheduleSraType.removeOnChange(
                SRAAppointment.onScheduleSraTypeChange
            );
            scheduleSraType.addOnChange(
                SRAAppointment.onScheduleSraTypeChange
            );
        }

        await SRAAppointment.onScheduleSraTypeChange(
            executionContext
        );

        [
            "bdgas_mydigitalsraid"
        ].forEach(function (fieldName) {
            var attribute =
                formContext.getAttribute(
                    fieldName
                );

            if (attribute) {
                attribute.removeOnChange(
                    SRAAppointment.onRequestSourceChange
                );
                attribute.addOnChange(
                    SRAAppointment.onRequestSourceChange
                );
            }
        });

        var requestnumber = formContext.getAttribute("regardingobjectid");
        if (requestnumber) {
            requestnumber.removeOnChange(
                SRAAppointment.onRegardingChange
            );
            requestnumber.addOnChange(
                SRAAppointment.onRegardingChange
            );

            SRAAppointment.registerRegardingFilter(
                formContext
            );
        }

        var impactField =
            formContext.getAttribute(
                "bdgas_impacttootherapplicationsid"
            );

        var uploadSraDocument =
            formContext.getAttribute(
                "bdgas_uploadsradocument"
            );

        if (uploadSraDocument) {
            uploadSraDocument.removeOnChange(
                SRAAppointment.onUploadSraDocumentChange
            );
            uploadSraDocument.addOnChange(
                SRAAppointment.onUploadSraDocumentChange
            );
        }

        if (impactField) {
            impactField.removeOnChange(
                SRAAppointment.toggleApplicationInvolvedSection
            );

            impactField.addOnChange(
                SRAAppointment.toggleApplicationInvolvedSection
            );
        }

        var systemReside =
            formContext.getAttribute(
                "bdgas_systemresidetext"
            );

        if (systemReside) {
            systemReside.removeOnChange(
                SRAAppointment.toggleBDControlSegment
            );
            systemReside.addOnChange(
                SRAAppointment.toggleBDControlSegment
            );
        }

        var authenticationMethod =
            formContext.getAttribute(
                "bdgas_authenticationmethodtext"
            );

        if (authenticationMethod) {
            authenticationMethod.removeOnChange(
                SRAAppointment.onAuthenticationMethodChange
            );
            authenticationMethod.addOnChange(
                SRAAppointment.onAuthenticationMethodChange
            );
        }

        var routedFrom =
            formContext.getAttribute(
                "bdgas_routedfromid"
            );

        if (routedFrom) {
            routedFrom.removeOnChange(
                SRAAppointment.onRoutedFromChange
            );
            routedFrom.addOnChange(
                SRAAppointment.onRoutedFromChange
            );
        }

        var gxpApplicable =
            formContext.getAttribute(
                "bdgas_gxpapplicableid"
            );

        if (gxpApplicable) {
            gxpApplicable.removeOnChange(
                SRAAppointment.onGxpApplicableChange
            );
            gxpApplicable.addOnChange(
                SRAAppointment.onGxpApplicableChange
            );
        }

        /*
        * Set the Routed From explanation label on load.
        * UI-only change; does not modify the field value.
        */
        SRAAppointment.updateRoutedFromExplanation(
            executionContext
        );

        SRAAppointment.disableLookupMRU(
            formContext
        );

        SRAAppointment.toggleApplicationInvolvedSection(
            executionContext
        );
        
        await SRAAppointment.toggleBDControlSegment(
            executionContext
        );

        await SRAAppointment
        .updateOtherAuthenticationMethodVisibility(
            formContext
        );

        SRAAppointment.hideSraMeetingSection(
            formContext
        );
        SRAAppointment.setRescheduleSlotVisibilityOnLoad(
            formContext
        );
        SRAAppointment.lockAlwaysReadOnlyFields(
            formContext
        );
        /*SRAAppointment.populateRegistrantIfAvailable(
            formContext
        );*/
        /*SRAAppointment.lockRegistrant(
            formContext
        );*/

        /*await SRAAppointment.populateBusinessOwner(
        formContext
        );*/

        await SRAAppointment.updateNavigationParameterAccess(
            formContext
        );

        SRAAppointment.updateConditionalMandatoryFields(
            formContext
        );

        var agreementAcceptedOnLoad =
            SRAAppointment.getAttributeValue(
                formContext,
                "bdgas_sraagreementaccepted"
            ) === true;

        if (
            isCreateForm &&
            !agreementAcceptedOnLoad &&
            !SRAAppointment.hasLookupValue(
                formContext,
                "regardingobjectid"
            )
        ) {
            var agreementMessage =
                await SRAAppointment.getEnvironmentVariable(
                    "bdgas_sraagreementnotification"
                );
            if (!agreementMessage) {
                console.log("Agreement message not found.");
                return;
            }
            sessionStorage.setItem(
                "bdgas_sraagreementnotification",
                agreementMessage
            );
            console.log("Agreement Message:", agreementMessage);

            var pageInput = {
                pageType: "webresource",
                webresourceName: "bdgas_sraAgreement"
            };

            var navigationOptions = {
                target: 2,
                position: 1,
                width: {
                    value: 800,
                    unit: "px"
                },
                height: {
                    value: 650,
                    unit: "px"
                },
                title: "Registration Agreement"
            };

            sessionStorage.setItem(
                "bdgas_sraAgreementResult",
                "cancel"
            );
            await Xrm.Navigation.navigateTo(
                pageInput,
                navigationOptions
            );
            var agreementResult =
                sessionStorage.getItem(
                    "bdgas_sraAgreementResult"
                );

            if (agreementResult !== "agree") {
                formContext.ui.close();
                return;
            }

            var agreementField =
                formContext.getAttribute(
                    "bdgas_sraagreementaccepted"
                );

            if (!agreementField) {
                console.error(
                    "Field not found: bdgas_sraagreementaccepted"
                );
                return;
            }

            agreementField.setValue(true);
            agreementField.setSubmitMode("always");

            formContext.getAttribute("bdgas_systemdesciption").setValue("NA");
            formContext.getAttribute("bdgas_systemdesciption").setSubmitMode("always");

            var mandatoryLevels = [];

            formContext.data.entity.attributes.forEach(
                function (attribute) {
                    var requiredLevel =
                        attribute.getRequiredLevel();

                    if (requiredLevel !== "none") {
                        mandatoryLevels.push({
                            attribute: attribute,
                            requiredLevel: requiredLevel
                        });

                        attribute.setRequiredLevel(
                            "none"
                        );
                    }
                }
            );

            SRAAppointment.isAgreementAutoSave = true;

            try {
                var businessPartnerAttr =
                    formContext.getAttribute(
                        "bdgas_businesspartner"
                    );

                if (businessPartnerAttr) {
                    businessPartnerAttr.setSubmitMode(
                        "always"
                    );
                }

                await formContext.data.save();

                var createdRecordId =
                    formContext.data.entity.getId();

                if (!createdRecordId) {
                    throw new Error(
                        "The SRA Appointment was not created successfully. " +
                        "No record ID was returned."
                    );
                }

                console.log(
                    "[SRA] Agreement save created record:",
                    createdRecordId
                );
            }
            finally {
                SRAAppointment.isAgreementAutoSave = false;

                mandatoryLevels.forEach(
                    function (mandatoryField) {
                        mandatoryField.attribute
                            .setRequiredLevel(
                                mandatoryField.requiredLevel
                            );
                    }
                );

                await SRAAppointment.updateNavigationParameterAccess(
                    formContext
                );
                SRAAppointment.updateConditionalMandatoryFields(
                    formContext
                );
            }
        }
    }
    catch (error) {
        console.error(error);

        Xrm.Navigation.openAlertDialog({
            text: error.message || String(error)
        });
    }
};
