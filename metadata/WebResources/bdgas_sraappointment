SRAAppointment.onScheduleSraTypeChange =
    async function (executionContext) {

        var formContext =
            executionContext.getFormContext();

        var requestName =
            formContext.getAttribute(
                "bdgas_requestname"
            );

        if (requestName) {
            requestName.setRequiredLevel(
                "required"
            );
        }

        var scheduleSraType =
            formContext.getAttribute(
                "bdgas_schedulesratype"
            );

        if (!scheduleSraType) {
            return;
        }

        var scheduleSraTypeControl =
            formContext.getControl(
                "bdgas_schedulesratype"
            );

        //removeOption for bdgas_schedulesratype for Manual Upload
        if (scheduleSraTypeControl) {
            scheduleSraTypeControl.removeOption(2);
        }

        var onlineMeetingJoinUrl =
            formContext.getAttribute(
                "onlinemeetingjoinurl"
            );

        var isRegulatoryAdmin =
            await SRAAppointment.isCurrentUserInTeam(
                SRAAppointment.regulatoryAdminTeamId
            );

        var isCurrentUserCreator =
            SRAAppointment.hasCurrentUserAsCreator(
                formContext
            );

        var hasMySchedulerData =
            SRAAppointment.hasDataParameter(
                "MyScheduler"
            );

        if (!hasMySchedulerData &&
            scheduleSraTypeControl &&
            onlineMeetingJoinUrl &&
            onlineMeetingJoinUrl.getValue() &&
            !isRegulatoryAdmin &&
            !isCurrentUserCreator
        ) {
            scheduleSraTypeControl.removeOption(1);
            scheduleSraTypeControl.removeOption(3);
        }

        scheduleSraType.setRequiredLevel(
            "none"
        );

        var selectedFieldByType = {
            1: "regardingobjectid",
            2: "bdgas_uploadsradocument",
            3: "bdgas_mydigitalsraid"
        };

        var selectedField =
            selectedFieldByType[
            scheduleSraType.getValue()
            ];

        var eventSource =
            executionContext.getEventSource
                ? executionContext.getEventSource()
                : null;

        var isScheduleSraTypeChange =
            eventSource === scheduleSraType;

        [
            "regardingobjectid",
            "bdgas_uploadsradocument",
            "bdgas_mydigitalsraid"
        ].forEach(function (fieldName) {
            var attribute =
                formContext.getAttribute(
                    fieldName
                );

            if (!attribute) {
                return;
            }

            if (
                isScheduleSraTypeChange &&
                fieldName !== "regardingobjectid"
            ) {
                attribute.setValue(null);
                attribute.setSubmitMode(
                    "always"
                );
            }

            attribute.setRequiredLevel(
                fieldName === selectedField
                    ? "required"
                    : "none"
            );

            attribute.controls.forEach(
                function (control) {
                    control.setVisible(
                        fieldName === selectedField
                    );
                }
            );
        });
    };

SRAAppointment.onRequestSourceChange =
    async function (executionContext) {

        var formContext =
            executionContext.getFormContext();

        var eventSource =
            executionContext.getEventSource();

        var lookupValue =
            eventSource
                ? eventSource.getValue()
                : null;

        if (!lookupValue || lookupValue.length === 0) {
            return;
        }

        var selectedRecord = lookupValue[0];
        var recordId = selectedRecord.id
            .replace(/[{}]/g, "");

        try {
            var result =
                await Xrm.WebApi.retrieveRecord(
                    selectedRecord.entityType,
                    recordId,
                    "?$select=" +
                    "bdgas_requestname," +
                    "bdgas_configurationitemname," +
                    "bdgas_chmdmndritmplanviewnumber"
                );

            [
                "bdgas_requestname",
                "bdgas_configurationitemname",
                "bdgas_chmdmndritmplanviewnumber"
            ].forEach(function (fieldName) {
                var attribute =
                    formContext.getAttribute(fieldName);

                if (!attribute) {
                    return;
                }

                attribute.setValue(
                    result[fieldName] || null
                );
                attribute.setSubmitMode("always");
            });
        }
        catch (error) {
            console.error(
                "[SRA] Unable to retrieve My Digital SRA values.",
                error
            );

