        var formContext =
            executionContext.getFormContext();

        var dirtyFields = [];

        formContext.data.entity.attributes.forEach(
            function (attribute) {
                if (attribute.getIsDirty()) {
                    dirtyFields.push({
                        name: attribute.getName(),
                        value: attribute.getValue(),
                        submitMode: attribute.getSubmitMode()
                    });
                }
            }
        );

        console.log(
            "[DIRTY DEBUG] Dirty fields at save:",
            dirtyFields
        );
        
        var eventArgs =
            executionContext.getEventArgs();

        var saveMode =
            eventArgs.getSaveMode();

        SRAAppointment.reopenAfterSave =
            saveMode === 1 || saveMode === 70;

        var authenticationMethodAttr =
            formContext.getAttribute(
                "bdgas_authenticationmethodtext"
            );
        
        // var authenticationMethodValue =
        //     authenticationMethodAttr
        //         ? authenticationMethodAttr.getValue()
        //         : null;
        //
        // var hasAuthenticationMethod =
        //     SRAAppointment.isAgreementAutoSave ||
        //     !!authenticationMethodValue;

        var authenticationMethodControl =
            formContext.getControl(
                "bdgas_authenticationmethodtext"
            );

        // if (!hasAuthenticationMethod) {
        //     if (authenticationMethodControl) {
        //         authenticationMethodControl.setNotification(
        //             "Authentication Method is required.",
        //             "authentication_method_required"
        //         );
        //     }
        //
        //     eventArgs.preventDefault();
        //
        //     console.log(
        //         "[SRA] Save prevented: Authentication Method is empty."
        //     );
        //
        //     return;
        // }

        if (authenticationMethodControl) {
            authenticationMethodControl.clearNotification(
                "authentication_method_required"
            );
        }

        var otherAuthenticationMethodAttr =
            formContext.getAttribute(
                "bdgas_otherauthenticationmethod"
            );

        console.log(
            "[AUTH DEBUG] Authentication Method value:",
            authenticationMethodAttr
                ? authenticationMethodAttr.getValue()
                : null
        );

        console.log(
            "[AUTH DEBUG] Authentication Method dirty:",
            authenticationMethodAttr
                ? authenticationMethodAttr.getIsDirty()
                : null
        );

        console.log(
            "[AUTH DEBUG] Authentication Method required:",
            authenticationMethodAttr
                ? authenticationMethodAttr.getRequiredLevel()
                : null
        );

        console.log(
            "[AUTH DEBUG] Authentication Method submit mode:",
            authenticationMethodAttr
                ? authenticationMethodAttr.getSubmitMode()
                : null
        );

        console.log(
            "[AUTH DEBUG] Other Authentication Method value:",
            otherAuthenticationMethodAttr
                ? otherAuthenticationMethodAttr.getValue()
                : null
        );

        console.log(
            "[AUTH DEBUG] Form dirty:",
            formContext.data.entity.getIsDirty()
        );

        console.log(
            "[SRA] onSave recordID:",
            formContext.data.entity.getId()
        );

        console.log(
            "[SRA] onSave form type:",
            formContext.ui.getFormType()
        );

        console.log(
            "[SRA] onSave entity dirty:",
            formContext.data.entity.getIsDirty()
        );

        var businessPartnerAttr =
            formContext.getAttribute(
                "bdgas_businesspartner"
            );

        if (businessPartnerAttr) {
            businessPartnerAttr.setSubmitMode(
                "always"
            );

            console.log(
                "[SRA] Business Partner before save:",
                businessPartnerAttr.getValue()
            );
        }

        console.log(
            "[SRA] onSave executed"
        );

        console.log(
            "[SRA] Save mode:",
            saveMode
        );

        console.log(
            "[SRA] Agreement auto-save:",
            SRAAppointment.isAgreementAutoSave
        );

        /*
         * Do not show the submission dialog for
         * the initial save triggered by I Agree.
         */
        if (SRAAppointment.isAgreementAutoSave) {
            SRAAppointment
                .showSubmittedDialogAfterSave =
                false;

            console.log(
                "[SRA] Dialog suppressed: " +
                "Agreement auto-save"
            );

            return;
        }

        /*
         * Do not show the dialog for a normal
         * platform auto-save.
         */
        if (saveMode === 70) {
            SRAAppointment
                .showSubmittedDialogAfterSave =
                false;

            console.log(
                "[SRA] Dialog suppressed: Auto Save"
            );

            return;
        }

        var agreementAttribute =
            formContext.getAttribute(
                "bdgas_sraagreementaccepted"
            );

        var agreementAccepted =
            agreementAttribute &&
            agreementAttribute.getValue() === true;

        console.log(
            "[SRA] Agreement accepted:",
            agreementAccepted
        );

        if (!agreementAccepted) {
            SRAAppointment
                .showSubmittedDialogAfterSave =
                false;

            console.log(
                "[SRA] Dialog suppressed: " +
                "Agreement not accepted"
            );

            return;
        }

        SRAAppointment
            .showSubmittedDialogAfterSave =
            true;

        console.log(
            "[SRA] Dialog flag:",
            SRAAppointment
                .showSubmittedDialogAfterSave
        );
    };

SRAAppointment.onPostSave =
    async function (executionContext) {

        console.log(
            "[SRA] onPostSave executed"
        );

        console.log(
            "[SRA] Dialog flag at Post Save:",
            SRAAppointment
                .showSubmittedDialogAfterSave
        );

        var eventArgs =
            executionContext.getEventArgs();
        var formContext =
            executionContext.getFormContext();

        var reopenAfterSave =
            SRAAppointment.reopenAfterSave;
        SRAAppointment.reopenAfterSave = false;

        var savedRecordId =
            formContext.data.entity.getId();

        console.log(
            "[SRA] onPostSave record ID:",
            savedRecordId
        );

        console.log(
            "[SRA] onPostSave form type:",
            formContext.ui.getFormType()
        );

        console.log(
            "[SRA] Business Partner after save:",
            SRAAppointment.getAttributeValue(
                formContext,
                "bdgas_businesspartner"
            )
        );

        if (!savedRecordId) {
            SRAAppointment
                .showSubmittedDialogAfterSave = false;
            SRAAppointment.isCancellationConfirmed = false;
            console.error(
                "[SRA] Save completed without a record ID."
            );
            return;
        }
        
        if (
            eventArgs.getIsSaveSuccess &&
            !eventArgs.getIsSaveSuccess()
        ) {
            console.log(
                "[SRA] Save was not successful"
            );
            SRAAppointment
                .showSubmittedDialogAfterSave =
                false;
            SRAAppointment.isCancellationConfirmed = false;
            return;
        }
        SRAAppointment.isCancellationConfirmed = false;

        await SRAAppointment
            .updateOtherAuthenticationMethodVisibility(
                formContext
            );

        if (SRAAppointment.showSubmittedDialogAfterSave) {
            SRAAppointment.showSubmittedDialogAfterSave = false;

            await Xrm.Navigation.openAlertDialog(
                {
                    title: "Submission Successful",
                    text:
                        "Your record has been submitted"
                },
                {
                    height: 200,
                    width: 450
                }
            );
        }
        else {
            console.log(
                "[SRA] Dialog not shown: " +
                "flag is false"
            );

        }

        if (!reopenAfterSave) {
            return;
        }

        // Do not discard edits made while post-save work or the dialog was pending.
        if (formContext.data.entity.getIsDirty()) {
            console.warn(
                "[SRA] Record reopen skipped because new unsaved changes exist."
            );
            return;
        }

        try {
            await Xrm.Navigation.openForm(
                {
                    entityName: formContext.data.entity.getEntityName(),
                    entityId: savedRecordId.replace(/[{}]/g, "")
                }
            );
        }
        catch (error) {
            console.error("[SRA] Unable to reopen the saved record.", error);
            await Xrm.Navigation.openAlertDialog({
                text: "The record was saved, but could not be reopened. " +
                    (error.message || String(error))
            });
        }
    };

SRAAppointment.getEnvironmentVariable =
    async function (schemaName) {

        if (!schemaName) {
            return null;
        }

        var escapedSchemaName =
            schemaName.replace(/'/g, "''");

        var query =
            "?$select=defaultvalue" +
            "&$filter=schemaname eq '" +
            escapedSchemaName +
            "'" +
            "&$expand=environmentvariabledefinition_environmentvariablevalue" +
            "($select=value,createdon;$orderby=createdon desc;$top=1)";

        var result =
            await Xrm.WebApi.retrieveMultipleRecords(
                "environmentvariabledefinition",
                query
            );

        if (
            !result ||
            !result.entities ||
            result.entities.length === 0
        ) {
            console.warn(
                "Environment variable not found: " +
                schemaName
            );
            return null;
        }

        var definition =
            result.entities[0];

        var currentValues =
            definition
                .environmentvariabledefinition_environmentvariablevalue;

        if (
            currentValues &&
            currentValues.length > 0 &&
            currentValues[0].value !== null &&
            currentValues[0].value !== undefined &&
            String(currentValues[0].value).trim() !== ""
        ) {
            return currentValues[0].value;
        }

        return definition.defaultvalue || null;
    };

