        var filterXml =
            "<filter type='or'>" +
            "<condition attribute='bdgas_botowner' operator='eq-userid' />" +
            "<condition attribute='bdgas_botinformedid' operator='eq-userid' />" +
            "<condition attribute='bdgas_botvp' operator='eq-userid' />" +
            "<condition attribute='bdgas_assigneeba' operator='eq-userid' />" +
