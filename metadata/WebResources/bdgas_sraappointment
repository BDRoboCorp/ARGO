// UI only: visibility, label and required level. Does not change values.
SRAAppointment.updateGxpApplicabilityRequiredLevel =
    function (formContext, requireReservedFields) {
        var config = SRAAppointment.gxpConfig;
        var gxpName = SRAAppointment.getGxpApplicableName(formContext);
        var isGxpYes = gxpName === config.yesName;
        var isGxpNo = SRAAppointment.isGxpNoOrNotApplicable(gxpName);

        // Store or Process Electronic Records / Electronic Signature Capability
        config.targetFields.forEach(function (target) {
            var attribute = formContext.getAttribute(target.field);

            if (!attribute) {
                console.warn("[SRA] Field not found: " + target.field);
                return;
            }

            attribute.setRequiredLevel(
                isGxpYes && requireReservedFields ? "required" : "none"
            );
        });

        // GxP Applicability: hidden and not mandatory for No / Not Applicable
        var gxpApplicability =
            formContext.getAttribute("bdgas_gxpapplicabilityid");

        SRAAppointment.setFieldVisible(
            formContext,
            "bdgas_gxpapplicabilityid",
            !isGxpNo
        );

        if (gxpApplicability && isGxpNo) {
            gxpApplicability.setRequiredLevel("none");
        }
        // Otherwise keeps the level set by reservedRequiredFields.

        // Non-GxP Applicability: shown only for No / Not Applicable
        SRAAppointment.setFieldVisible(
            formContext,
            "bdgas_nongxpapplicabilityid",
            isGxpNo
        );

        var nonGxpAttr =
            formContext.getAttribute("bdgas_nongxpapplicabilityid");

        if (nonGxpAttr) {
            nonGxpAttr.setRequiredLevel("none");

            if (isGxpNo) {
                nonGxpAttr.controls.forEach(function (control) {
                    control.setLabel(config.nonGxpLabel);
                });
            }
        }
    };

// User-driven only. No / Not Applicable = set both fields to "No".
SRAAppointment.onGxpApplicableChange =
    async function (executionContext) {
        var formContext = executionContext.getFormContext();
        var config = SRAAppointment.gxpConfig;
        var token = ++SRAAppointment.gxpChangeToken;
        var gxpName = SRAAppointment.getGxpApplicableName(formContext);

        // Apply visibility and required level immediately
        SRAAppointment.updateConditionalMandatoryFields(formContext);

        if (!SRAAppointment.isGxpNoOrNotApplicable(gxpName)) {
            return;
        }

        try {
            var lookups = await Promise.all(
                config.targetFields.map(function (target) {
                    return SRAAppointment.getRaMasterBooleanLookup(
                        target.category,
                        false
                    );
                })
            );

            // Ignore if the user changed GxP Applicable again meanwhile
            if (token !== SRAAppointment.gxpChangeToken) {
                return;
            }

            config.targetFields.forEach(function (target, index) {
                var attribute = formContext.getAttribute(target.field);
                var noLookup = lookups[index];

                if (!attribute || !noLookup) {
                    return;
                }

                var current = attribute.getValue();
                var currentId =
                    Array.isArray(current) && current.length > 0
                        ? String(current[0].id || "")
                            .replace(/[{}]/g, "")
                            .toLowerCase()
                        : "";

                if (currentId === String(noLookup.id).toLowerCase()) {
                    return;
                }

                attribute.setValue([noLookup]);
                attribute.setSubmitMode("always");
            });
        }
        catch (error) {
            console.error("[SRA] Unable to set GxP fields to No:", error);
        }
    };

    
