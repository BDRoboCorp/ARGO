/*
 * Updates the Routed From explanation field based on bdgas_routedfromid.
 *
 * Routed From empty -> explanation field hidden
 * Routed From has value -> explanation field visible, label set:
 *   Process/AME -> "Process/ AME"
 *   BOT Request -> "Bot Request"
 *   Other       -> "Other"
 *
 * UI-only change. Does not modify field values or dirty the record.
 */
SRAAppointment.updateRoutedFromExplanation = function (executionContext) {
    var formContext = executionContext.getFormContext();

    var routedFromAttr =
        formContext.getAttribute("bdgas_routedfromid");

    var explanationAttr =
        formContext.getAttribute(
            "bdgas_othersrarequesttypeexplanation"
        );

    if (!routedFromAttr || !explanationAttr) {
        return;
    }

    var routedFromValue = routedFromAttr.getValue();

    var hasRoutedFrom =
        Array.isArray(routedFromValue) &&
        routedFromValue.length > 0;

    explanationAttr.controls.forEach(function (control) {
        control.setVisible(hasRoutedFrom);
    });

    if (!hasRoutedFrom) {
        return;
    }

    var routedFromName =
        String(routedFromValue[0].name || "").trim();

    var label = null;

    switch (routedFromName.toLowerCase()) {
        case "process/ame":
            label = "Process/ AME";
            break;
        case "bot request":
            label = "Bot Request";
            break;
        case "other":
            label = "Other";
            break;
    }

    if (label) {
        explanationAttr.controls.forEach(function (control) {
            control.setLabel(label);
        });
    }
};

SRAAppointment.onRoutedFromChange = function (executionContext) {
    SRAAppointment.updateRoutedFromExplanation(
        executionContext
    );
};

