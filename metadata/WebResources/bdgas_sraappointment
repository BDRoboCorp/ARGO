SRAAppointment.updateConditionalMandatoryFields =
    function (formContext) {
        var slotStatusAttr =
            formContext.getAttribute(
                "bdgas_slotstatus"
            );

        if (!slotStatusAttr) {
            console.warn(
                "[SRA] Missing field: bdgas_slotstatus"
            );
            return;
        }

        var agreementAttr =
            formContext.getAttribute(
                "bdgas_sraagreementaccepted"
            );

        if (!agreementAttr) {
            console.warn(
                "[SRA] Missing field: " +
                "bdgas_sraagreementaccepted"
            );
            return;
        }

        var slotStatus =
            slotStatusAttr.getValue();

        if (slotStatus === 6) {

            var cancelledRegistrant =
                formContext.getAttribute(
                    "bdgas_registrant"
                );

            if (cancelledRegistrant) {
                cancelledRegistrant.setRequiredLevel("none");
            }

            SRAAppointment.businessOwnerRequiredFields
                .forEach(function (fieldName) {
                    var attribute =
                        formContext.getAttribute(fieldName);

                    if (attribute) {
                        attribute.setRequiredLevel("none");
                    }
                });

            SRAAppointment.availableWithRequestRequiredFields
                .forEach(function (fieldName) {
                    var attribute =
                        formContext.getAttribute(fieldName);

                    if (attribute) {
                        attribute.setRequiredLevel("none");
                    }
                });

            SRAAppointment.reservedRequiredFields
                .forEach(function (fieldName) {
                    var attribute =
                        formContext.getAttribute(fieldName);

                    if (attribute) {
                        attribute.setRequiredLevel("none");
                    }
                });

            console.log(
                "[SRA] Slot Status = Cancel. Mandatory fields bypassed."
            );

            SRAAppointment.updateGxpApplicabilityRequiredLevel(
                formContext,
                false
            );
            return;
        }

        var agreementAccepted =
            agreementAttr.getValue() === true;

        var requireAvailableFields =
            slotStatus === 0;

        var requireReservedFields =
            agreementAccepted ||
            SRAAppointment.isSraMeetingSectionVisible(
                formContext
            ) ||
            SRAAppointment.isTabEditable(
                formContext,
                "tab_SRAssessment"
            );

        var requireBusinessOwnerFields =
            SRAAppointment.isTabEditable(
                formContext,
                "appointment"
            );

        var registrant =
            formContext.getAttribute(
                "bdgas_registrant"
            );

        if (registrant) {
            registrant.setRequiredLevel("required");
        }

        SRAAppointment.businessOwnerRequiredFields
            .forEach(function (fieldName) {
                var attribute =
                    formContext.getAttribute(fieldName);

                if (attribute) {
                    attribute.setRequiredLevel(
                        requireBusinessOwnerFields
                            ? "required"
                            : "none"
                    );
                }
            });

        console.log(
            "[SRA] Slot Status:",
            slotStatus
        );

        console.log(
            "[SRA] Agreement Accepted:",
            agreementAccepted
        );

        console.log(
            "[SRA] Reserved Fields Required:",
            requireReservedFields
        );

        SRAAppointment.availableWithRequestRequiredFields
            .forEach(function (fieldName) {
                var attribute =
                    formContext.getAttribute(fieldName);

                if (!attribute) {
                    console.warn(
                        "[SRA] Available field MISSING:",
                        fieldName
                    );
                    return;
                }

                attribute.setRequiredLevel(
