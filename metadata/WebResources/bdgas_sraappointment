        var currentId =
            formContext.data.entity.getId()
                .replace(/[{}]/g, "")
                .toLowerCase();

        if (!currentId) {
            return false;
        }

        var query =
            "?$select=activityid,actualstart" +
            "&$filter=_bdgas_mydigitalsraid_value eq " + currentId +
            " and activityid ne " + currentId +
            "&$orderby=actualstart desc" +
            "&$top=1";

        try {
            var result =
                await Xrm.WebApi.retrieveMultipleRecords(
                    "appointment",
                    query
                );

            if (!result || !result.entities || result.entities.length === 0) {
                return false;
            }

            var redirectId = String(result.entities[0].activityid || "");

            if (!redirectId) {
                return false;
            }

            console.log("[SRA] Redirecting to latest Digital SRA appointment:", redirectId);

            await Xrm.Navigation.openForm(
                {
                    entityName: formContext.data.entity.getEntityName(),
                    entityId: redirectId.replace(/[{}]/g, "")
                }
            );

            return true;
        }
        catch (error) {
            console.error("[SRA] Unable to redirect to latest Digital SRA appointment.", error);
            return false;
        }
    };