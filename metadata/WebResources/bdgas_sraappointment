            "<condition attribute='bdgas_leaddeveloperid' operator='eq-userid' />" +
            "<condition attribute='createdby' operator='eq-userid' />" +
            "<condition attribute='bdgas_requestedby' operator='eq-userid' />" +
            "<condition attribute='bdgas_amoleadid' operator='eq-userid' />" +
            "</filter>";

        attribute.controls.forEach(function (control) {
            if (
                !control ||
                !control.addPreSearch ||
                !control.addCustomFilter
            ) {
                return;
            }

            if (control._sraRegardingPreSearchHandler) {
                control.removePreSearch(
