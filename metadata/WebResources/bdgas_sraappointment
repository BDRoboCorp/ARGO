SRAAppointment.populateBusinessOwner =
    async function (formContext) {
        var regardingAttr =
            formContext.getAttribute(
                "regardingobjectid"
            );

        var businessOwnerAttr =
            formContext.getAttribute(
                "bdgas_businessowner"
            );

        var requestNameAttr =
            formContext.getAttribute(
                "bdgas_requestname"
            );

        var aiUsedAttr =
            formContext.getAttribute(
                "bdgas_aiusedid"
            );

        var aiAssessmentOutcomeAttr =
            formContext.getAttribute(
                "bdgas_aiassessmentoutcome"
            );

        /*
         * Stop if no Project Center record is selected.
         */
        if (
            !regardingAttr ||
            !regardingAttr.getValue() ||
            regardingAttr.getValue().length === 0
        ) {

            SRAAppointment.clearRegardingRelatedFields(
                formContext
            );

            console.log(
                "[SRA] Regarding cleared. Related fields reset."
            );

            return;
        }

        var regardingValue =
            regardingAttr.getValue()[0];

        /*
         * Regarding is a multi-table lookup.
         * Only continue when the selected record
         * is from Project Center / Request Intake.
         */
        if (
            regardingValue.entityType !==
            "bdgas_requestintake"
        ) {

            SRAAppointment.clearRegardingRelatedFields(
                formContext
            );

            console.log(
                "[SRA] Regarding is not Project Center:",
                regardingValue.entityType
            );

            return;
        }

        var requestIntakeId =
            regardingValue.id.replace(/[{}]/g, "");

        SRAAppointment.clearRegardingRelatedFields(
            formContext
        );

        try {
            /*
             * Retrieve all required Project Center values
             * through the existing single API request.
             */
            var result =
                await Xrm.WebApi.retrieveRecord(
                    "bdgas_requestintake",
                    requestIntakeId,
                    "?$select=" +
                    "_bdgas_botowner_value," +
                    "bdgas_requestintaketype," +
                    "bdgas_requestname," +
                    "bdgas_isaiassessment," +
                    "bdgas_responsibleaisubmitted"
                );

            console.log(
                "[SRA] Project Center values retrieved:",
                {
                    requestName:
                        result.bdgas_requestname,

                    isAiAssessment:
                        result.bdgas_isaiassessment,

                    responsibleAiSubmitted:
                        result
                            .bdgas_responsibleaisubmitted
                }
            );

            /*
             * Populate Request Name only when blank.
             */
            if (
                requestNameAttr &&
                result.bdgas_requestname
            ) {
                requestNameAttr.setValue(
                    result.bdgas_requestname
                );

                requestNameAttr.setSubmitMode(
                    "always"
                );
            }

            /*
             * Populate Business Owner from BOT Owner
             * only when Business Owner is blank.
             */
            if (
                businessOwnerAttr &&
                result._bdgas_botowner_value
            ) {
                businessOwnerAttr.setValue([
                    {
                        id:
                            result
                                ._bdgas_botowner_value,

                        name:
                            result[
                            "_bdgas_botowner_value@" +
                            "OData.Community.Display.V1." +
                            "FormattedValue"
                            ],

                        entityType:
                            "systemuser"
                    }
                ]);

                businessOwnerAttr.setSubmitMode(
                    "always"
                );
            }

            /*
             * Populate AI Used:
             *
             * Project Center:
             * bdgas_isaiassessment
             *
             * SRA Appointment:
             * bdgas_aiusedid
             *
             * RA Master category:
             * AI Used
             */
            if (
                aiUsedAttr &&
                (
                    result.bdgas_isaiassessment ===
                    true ||
                    result.bdgas_isaiassessment ===
                    false
                )
            ) {
                var aiUsedLookup =
                    await SRAAppointment
                        .getRaMasterBooleanLookup(
                            "AI Used",
                            result.bdgas_isaiassessment
                        );

                if (aiUsedLookup) {
                    aiUsedAttr.setValue([
                        aiUsedLookup
                    ]);

                    aiUsedAttr.setSubmitMode(
                        "always"
                    );

                    console.log(
                        "[SRA] AI Used populated:",
                        aiUsedLookup
                    );
                }
            }

            /*
             * Populate AI Assessment Outcome:
             *
             * Project Center:
             * bdgas_responsibleaisubmitted
             *
             * SRA Appointment:
             * bdgas_aiassessmentoutcome
             *
             * RA Master category:
             * AI Assessment Outcome
             */
            if (
                aiAssessmentOutcomeAttr &&
                (
                    result
                        .bdgas_responsibleaisubmitted ===
                    true ||
                    result
                        .bdgas_responsibleaisubmitted ===
                    false
                )
            ) {
                var aiAssessmentOutcomeLookup =
                    await SRAAppointment
                        .getRaMasterBooleanLookup(
                            "AI Assessment Outcome",
                            result
                                .bdgas_responsibleaisubmitted
                        );

                if (aiAssessmentOutcomeLookup) {
                    aiAssessmentOutcomeAttr.setValue([
                        aiAssessmentOutcomeLookup
                    ]);

                    aiAssessmentOutcomeAttr
                        .setSubmitMode(
                            "always"
                        );

                    console.log(
                        "[SRA] AI Assessment Outcome " +
                        "populated:",
                        aiAssessmentOutcomeLookup
                    );
                }
            }
        }
        catch (error) {
            console.error(
                "[SRA] Unable to populate values " +
                "from Project Center:",
                error
            );
        }
    };

