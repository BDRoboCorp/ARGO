SRAAppointment.hasDataParameter =
    function (expectedValue) {

        var data = "";

        try {
            data =
                new URLSearchParams(
                    window.location.search
                ).get("data") || "";
        }
        catch (error) {
            data = "";
        }

        if (!data) {
            try {
                var globalContext =
                    Xrm.Utility
                        .getGlobalContext();

                if (
                    !globalContext.getQueryStringParameters
                ) {
                    return false;
                }

                var queryParameters =
                    globalContext.getQueryStringParameters();

                data =
                    queryParameters &&
                        queryParameters.data
                        ? queryParameters.data
                        : "";
            }
            catch (error) {
                data = "";
            }
        }

        if (!data) {
            try {
                data =
                    sessionStorage.getItem(
                        SRAAppointment.navigationDataKey
                    ) || "";
            }
            catch (error) {
                data = "";
            }
        }

        if (!data) {
            return false;
        }

        try {
            data = decodeURIComponent(data);
        }
        catch (error) {
            data = String(data);
        }

        return data
            .toLowerCase()
            .indexOf(
                String(expectedValue || "")
                    .toLowerCase()
            ) !== -1;
    };

SRAAppointment.navigationTabAccess = new WeakMap();

SRAAppointment.applyNavigationTabAccess =
    function (formContext, editableTabs, readOnlyForm) {
        var previousAccess =
            SRAAppointment.navigationTabAccess.get(formContext);
        var controls = new Map();

        function disableControl(control) {
            if (control && typeof control.setDisabled === "function" &&
                typeof control.getDisabled === "function") {
                if (!controls.has(control)) {
                    controls.set(control, control.getDisabled());
                }
                control.setDisabled(true);
            }
        }

        if (readOnlyForm) {
            formContext.data.entity.attributes.forEach(function (attribute) {
                attribute.controls.forEach(disableControl);
            });
        }

        function setTabVisibleSafe(tab, tabName, isVisible) {
            try {
                // Only call setVisible when the value actually changes
                if (tab.getVisible() === isVisible) {
                    return;
                }
                tab.setVisible(isVisible);
            }
            catch (error) {
                // The tab list can be temporarily unavailable during save or refresh
                console.warn(
                    "[SRA] Unable to set tab visibility for " + tabName + ".",
                    error
                );
            }
        }

        SRAAppointment.navigationTabs.forEach(function (tabName) {
            var tab = formContext.ui.tabs.get(tabName);
            if (!tab) {
                return;
            }
            if (tabName === "tab_5") {
                setTabVisibleSafe(
                    tab,
                    tabName,
                    !readOnlyForm && editableTabs.has(tabName)
                );
                return;
            }
            setTabVisibleSafe(
                tab,
                tabName,
                tabName !== "appointment" || editableTabs.has(tabName)
            );
            if (readOnlyForm || !editableTabs.has(tabName)) {
                try {
                    tab.sections.forEach(function (section) {
                        section.controls.forEach(disableControl);
                    });
                }
                catch (error) {
                    console.warn(
                        "[SRA] Unable to lock sections for " + tabName + ".",
                        error
                    );
                }
            }
        });

        // var assessment = formContext.ui.tabs.get("tab_SRAssessment");
        // if (!readOnlyForm && editableTabs.has("tab_SRAssessment") &&
        //     assessment && assessment.getVisible() &&
        //     (!previousAccess || previousAccess.readOnlyForm ||
        //         !previousAccess.editableTabs.has("tab_SRAssessment"))) {
        //     assessment.setFocus();
        // }

        SRAAppointment.navigationTabAccess.set(formContext, {
            editableTabs: editableTabs,
            readOnlyForm: readOnlyForm,
            controls: controls
        });
    };

