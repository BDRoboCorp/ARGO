                  "inputs": {
                    "host": {
                      "workflowReferenceName": "20d1c063-a69a-f111-b8dc-7ced8d23115e"
                    },
                    "body": {
                      "text": "<fetch top=\"1\">\n  <entity name=\"bdgas_budgetrequesthistory\">\n    <attribute name=\"bdgas_budgetrequesthistoryid\" />\n\t<attribute name=\"bdgas_projectcenterid\" />\n\t<attribute name=\"bdgas_approveddate\" />\n\t<attribute name=\"bdgas_financepoc\" />\n <attribute name=\"bdgas_botowner\" />\n\t<attribute name=\"bdgas_fee\" />\n\t<attribute name=\"bdgas_costcenter\" />\n\t<attribute name=\"bdgas_budgetrequest\" />\n <link-entity name='systemuser' to='bdgas_financepoc' from='systemuserid' alias='financepoc' link-type='outer'>\n<attribute name='fullname' />\n<attribute name='internalemailaddress' />\n</link-entity>\n<link-entity name='systemuser' to='bdgas_botowner' from='systemuserid' alias='botowner' link-type='outer'>\n<attribute name='fullname' />\n<attribute name='internalemailaddress' />\n</link-entity>\n<link-entity name='bdgas_requestintake' to='bdgas_projectcenterid' from='bdgas_requestintakeid' alias='projectcenter' link-type='outer'>\n<attribute name='bdgas_digitalproductname' />\n<attribute name='bdgas_requestintake' />\n</link-entity>\n<link-entity name='bdgas_budgetrequest' to='bdgas_budgetrequest' from='bdgas_budgetrequestid' alias='budgetrequest' link-type='outer'>\n<attribute name='bdgas_name' />\n</link-entity>\n    <filter>\n      <condition\n        attribute=\"bdgas_budgetrequesthistoryid\"\n        operator=\"eq\"\n        value=\"@{triggerOutputs()?['body/bdgas_budgetrequesthistoryid']}\" />\n    </filter>\n  </entity>\n</fetch>",
                      "text_1": "Budget Request History Notification",
                      "boolean": false,
                      "boolean_1": true,
                      "boolean_2": false,
                      "text_2": "@{outputs('Get_a_BOT_Owner_user')?['body/internalemailaddress']};@{outputs('Get_Finance_POC_user')?['body/internalemailaddress']}"
                    }
                  },
                  "runAfter": {
                    "Get_Project_Center": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              }
            }
          },
          "runAfter": {
            "Budget_Request_History_statuscode": [
              "Succeeded"
            ]
          }
        },
        "Scope_-_Catch": {
          "type": "Scope",
          "actions": {
            "Get_workflow_details": {
              "type": "Compose",
              "inputs": "@workflow()"
            },
            "Flow_URL": {
              "type": "Compose",
              "inputs": "@concat(\r\n'https://make.powerautomate.com/environments/',\r\nworkflow()?['tags']?['environmentName'],\r\n'/flows/',\r\nworkflow()?['name'],\r\n'/runs/',\r\nworkflow()?['run']?['name']\r\n)",
              "runAfter": {
