                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "b7e8d3b2-e25f-4aa5-b2c2-627f68314240"
              }
            },
            "Condition_Project_Center_or_SRA": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [
                        "@empty(triggerBody()?['text'])",
                        "@true"
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Get_a_Request_Intake_by_ID": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "bdgas_requestintakes",
                      "recordId": "@triggerBody()?['text']"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "GetItem",
                      "connectionName": "shared_commondataserviceforapps"
                    }
                  },
                  "metadata": {
                    "operationMetadataId": "ef6168b4-c8fe-4a79-8939-7bcf50c04b39"
                  }
                },
                "Set_variable": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "varFolderStructure",
                    "value": "@concat(\r\n  'Project Center/',\r\n  formatDateTime(outputs('Get_a_Request_Intake_by_ID')?['body/createdon'], 'yyyy'),\r\n  '/',\r\n  formatDateTime(outputs('Get_a_Request_Intake_by_ID')?['body/createdon'], 'MM'),\r\n  '/',\r\n  outputs('Get_a_Request_Intake_by_ID')?['body/bdgas_digitalproductname'],\r\n  '_',\r\n  outputs('Get_a_Request_Intake_by_ID')?['body/bdgas_requestintake']\r\n)"
                  },
                  "runAfter": {
                    "Get_a_Request_Intake_by_ID": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {
                  "Get_a_SRA_by_ID": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "entityName": "appointments",
