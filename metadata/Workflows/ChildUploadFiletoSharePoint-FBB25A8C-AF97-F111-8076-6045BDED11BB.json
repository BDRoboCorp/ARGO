      "actions": {
        "CatchScope": {
          "type": "Scope",
          "actions": {
            "Send_an_email_(V2)": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "@body('Parse_JSON')?['Recipients']",
                  "emailMessage/Subject": "[ARGO System Notification] Power Automate Flow Failed",
                  "emailMessage/Body": "<p class=\"editor-paragraph\">Dear,<br><br>This is a system-generated email to inform you that your forwarded email could not be processed by the system due to the following error:<br><br><b><strong class=\"editor-text-bold\">Flow Name:</strong></b> @{outputs('Get_Workflow_Details')?['tags']?['flowDisplayName']}</p><p class=\"editor-paragraph\"><b><strong class=\"editor-text-bold\">Flow URL:</strong></b> <a href=\"@{outputs('Flow_URL')}\" class=\"editor-link\">View Flow</a></p><p class=\"editor-paragraph\"><b><strong class=\"editor-text-bold\">IH Event: </strong></b><a href=\"@{outputs('Record_URL')}\" class=\"editor-link\">View Record</a><br><br>Kindly contact IT Support for further assistance.<br><br><i><b><strong class=\"editor-text-bold editor-text-italic\">Do not reply to this email as it was automatically generated by the system.</strong></b></i><br><br>Thank you,<br>ARGO System Notification</p>",
                  "emailMessage/Importance": "Normal"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365-1"
                }
              },
              "runAfter": {
                "Parse_JSON": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "503d7713-0632-47ae-87e7-eecda3637bbf"
              }
            },
            "Flow_URL": {
              "type": "Compose",
              "inputs": "https://make.powerautomate.com/environments/@{outputs('Get_Workflow_Details')?['tags']?['environmentName']}/flows/@{outputs('Get_Workflow_Details')?['name']}/runs/@{outputs('Get_Workflow_Details')?['run']['name']}",
              "runAfter": {
                "Get_Workflow_Details": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "5dac59e2-9883-49ed-882e-6b8d857bf307"
              }
            },
            "Get_Workflow_Details": {
              "type": "Compose",
              "inputs": "@workflow()",
              "metadata": {
                "operationMetadataId": "b7f5e576-5cae-4bae-b2b6-2c889e0abe66"
              }
            },
            "Record_URL": {
              "type": "Compose",
              "inputs": "@{parameters('ARGO Application URL (bdgas_ARGOApplicationURL)')}&pagetype=entityrecord&etn=@{if(\r\n  equals(triggerBody()?['text'], null),\r\n  'appointment',\r\n  'bdgas_requestintake'\r\n)}&id=@{if(\r\n  equals(triggerBody()?['text'], null),\r\n  triggerBody()?['text_1'],\r\n  triggerBody()?['text']\r\n)}",
              "runAfter": {
                "Flow_URL": [
                  "Succeeded"
                ]
              }
            },
            "Parse_JSON": {
              "type": "ParseJson",
              "inputs": {
                "content": "@parameters('ARGO notification flows (bdgas_ARGOnotificationflows)')",
                "schema": {
                  "type": "object",
                  "properties": {
                    "Recipients": {
                      "type": "string"
                    }
                  }
                }
              },
              "runAfter": {
                "Record_URL": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Try_Scope": [
              "TimedOut",
              "Skipped",
              "Failed"
            ]
          },
          "metadata": {
            "operationMetadataId": "0523e571-68ec-4397-9fb8-b467e2c6089a"
          }
        },
        "Try_Scope": {
          "type": "Scope",
          "actions": {
            "Create_file": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "@parameters('SharePoint URL (bdgas_SharePointURL)')",
                  "folderPath": "/Shared Documents/@{variables('varFolderStructure')}",
                  "name": "@triggerBody()?['file']?['name']",
                  "body": "@triggerBody()?['file']?['contentBytes']"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "CreateFile",
                  "connectionName": "shared_sharepointonline"
                }
              },
              "runAfter": {
                "Condition_Project_Center_or_SRA": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "269faf25-4b86-4ab4-b3ec-dd45063839ec"
              }
            },
            "Respond_to_a_Power_App_or_flow": {
              "type": "Response",
              "kind": "PowerApp",
              "inputs": {
                "schema": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": {}
                },
                "statusCode": 200,
                "body": {}
