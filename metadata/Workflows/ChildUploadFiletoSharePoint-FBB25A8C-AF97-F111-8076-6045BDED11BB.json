                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                        "operationId": "GetItem",
                        "connectionName": "shared_commondataserviceforapps"
                      }
                    }
                  },
                  "Set_variable_1": {
                    "type": "SetVariable",
                    "inputs": {
                      "name": "varFolderStructure",
                      "value": "@concat(\r\n  'SRA/',\r\n  formatDateTime(outputs('Get_a_SRA_by_ID')?['body/createdon'], 'yyyy'),\r\n  '/',\r\n  formatDateTime(outputs('Get_a_SRA_by_ID')?['body/createdon'], 'MM'),\r\n  '/',\r\n  outputs('Get_a_SRA_by_ID')?['body/subject'],\r\n  '_',\r\n  outputs('Get_a_SRA_by_ID')?['body/bdgas_requestname']\r\n)"
                    },
                    "runAfter": {
                      "Get_a_SRA_by_ID": [
                        "Succeeded"
                      ]
                    }
                  }
                }
              }
            }
          },
          "runAfter": {
            "Initialize_variable_varFolderStructure": [
              "Succeeded"
            ]
          }
        },
        "Initialize_variable_varFolderStructure": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
