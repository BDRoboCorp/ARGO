              "type": "SetVariable",
              "inputs": {
                "name": "FetchXml",
                "value": "<fetch xmlns:generator='MarkMpn.SQL4CDS'>\n  <entity name='bdgas_requestintake'>\n    <attribute name='bdgas_requestintakeid' />\n    <attribute name='bdgas_requestintake' />\n    <attribute name='bdgas_digitalproductname' />\n    <attribute name='bdgas_description' />\n    <link-entity name='systemuser' to='bdgas_botowner' from='systemuserid' alias='botowner' link-type='outer'>\n      <attribute name='fullname' />\n      <attribute name='internalemailaddress' />\n    </link-entity>\n    <link-entity name='systemuser' to='createdby' from='systemuserid' alias='createdby' link-type='outer'>\n      <attribute name='fullname' />\n      <attribute name='internalemailaddress' />\n    </link-entity>\n    <link-entity name='systemuser' to='bdgas_botvp' from='systemuserid' alias='botvp' link-type='outer'>\n      <attribute name='fullname' />\n      <attribute name='internalemailaddress' />\n    </link-entity>\n<link-entity name='systemuser' to='bdgas_botinformedid' from='systemuserid' alias='botinformed' link-type='outer'>\n      <attribute name='fullname' />\n      <attribute name='internalemailaddress' />\n    </link-entity>\n<link-entity name='systemuser' to='bdgas_assigneeba' from='systemuserid' alias='assigneeba' link-type='outer'>\n      <attribute name='fullname' />\n      <attribute name='internalemailaddress' />\n    </link-entity>\n<link-entity name='systemuser' to='bdgas_businesspartner' from='systemuserid' alias='businesspartner' link-type='outer'>\n      <attribute name='fullname' />\n      <attribute name='internalemailaddress' />\n    </link-entity>\n<link-entity name='systemuser' to='ownerid' from='systemuserid' alias='domainowner' link-type='outer'>\n      <attribute name='fullname' />\n      <attribute name='internalemailaddress' />\n    </link-entity>\n    <filter>\n      <condition attribute='bdgas_requestintakeid' operator='eq' value='@{triggerOutputs()?['body/bdgas_requestintakeid']}' />\n    </filter>\n  </entity>\n</fetch>"
              }
            },
