              "type": "SetVariable",
              "inputs": {
                "name": "SendTo",
                "value": "@concat(\r\nfirst(outputs('List_rows')?['body/value'])?['botowner.internalemailaddress'], ';',\r\nfirst(outputs('List_rows')?['body/value'])?['createdby.internalemailaddress'], ';',\r\nfirst(outputs('List_rows')?['body/value'])?['botvp.internalemailaddress']\r\n)"
