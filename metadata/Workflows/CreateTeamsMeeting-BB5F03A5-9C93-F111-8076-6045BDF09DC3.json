    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_a_row_is_added,_modified_or_deleted": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "parameters": {
              "subscriptionRequest/message": 1,
              "subscriptionRequest/entityname": "appointment",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filterexpression": "(bdgas_sratemplate eq true and bdgas_isfirstappointment eq true)"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "connectionName": "shared_commondataserviceforapps"
            }
          },
          "metadata": {
            "operationMetadataId": "ca0ed599-0256-4111-8679-55e805416777"
          }
        }
      },
      "actions": {
        "Scope_-_Try": {
          "type": "Scope",
          "actions": {
            "Create_a_Teams_meeting": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "item/subject": "@triggerOutputs()?['body/subject']",
                  "item/body/content": "@triggerOutputs()?['body/description']",
                  "item/timeZone": "UTC",
                  "item/start/dateTime": "@formatDateTime(triggerOutputs()?['body/actualstart'], 'yyy-MM-ddTHH:mm:ss')",
                  "item/end/dateTime": "@formatDateTime(triggerOutputs()?['body/actualend'], 'yyy-MM-ddTHH:mm:ss')",
                  "calendarid": "Calendar",
                  "item/location/displayName": "@triggerOutputs()?['body/location']",
                  "item/reminderMinutesBeforeStart": 1440,
                  "item/isReminderOn": true
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                  "operationId": "CreateTeamsMeeting",
                  "connectionName": "shared_teams"
                }
              },
              "metadata": {
                "operationMetadataId": "da515fda-4fcc-4d29-b463-c3c266c77c26"
              }
            },
            "Update_a_row": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "appointments",
                  "recordId": "@triggerOutputs()?['body/activityid']",
                  "item/bdgas_eventid": "@outputs('Create_a_Teams_meeting')?['body/id']",
                  "item/onlinemeetingid": "@outputs('Create_a_Teams_meeting')?['body/id']",
                  "item/onlinemeetingjoinurl": "@outputs('Create_a_Teams_meeting')?['body/onlineMeeting/joinUrl']"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "UpdateOnlyRecord",
                  "connectionName": "shared_commondataserviceforapps"
                }
              },
              "runAfter": {
                "Create_a_Teams_meeting": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "a6a64175-eaf8-49c9-98cf-917b0008f98f"
              }
            }
          },
          "runAfter": {}
        },
        "Scope_-_Catch": {
          "type": "Scope",
          "actions": {
            "Get_workflow_details": {
              "type": "Compose",
              "inputs": "@workflow()"
            },
            "Flow_URL": {
              "type": "Compose",
              "inputs": "@concat(\r\n'https://make.powerautomate.com/environments/',\r\nworkflow()?['tags']?['environmentName'],\r\n'/flows/',\r\nworkflow()?['name'],\r\n'/runs/',\r\nworkflow()?['run']?['name']\r\n)",
              "runAfter": {
                "Get_workflow_details": [
                  "Succeeded"
                ]
              }
            },
            "Get_Environment_Variables_-_ARGO_notification_flows": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "environmentvariabledefinitions",
                  "$select": "schemaname,environmentvariabledefinitionid",
                  "$filter": "schemaname eq 'bdgas_ARGOnotificationflows'",
                  "$expand": "environmentvariabledefinition_environmentvariablevalue($select=value)"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "connectionName": "shared_commondataserviceforapps-1"
                }
              },
              "runAfter": {
                "Flow_URL": [
                  "Succeeded"
                ]
              }
            },
            "ARGO_notification_flows_value": {
              "type": "Compose",
              "inputs": "@first(\r\n    first(\r\n        body('Get_Environment_Variables_-_ARGO_notification_flows')?['value']\r\n    )?['environmentvariabledefinition_environmentvariablevalue']\r\n)?['value']",
              "runAfter": {
                "Get_Environment_Variables_-_ARGO_notification_flows": [
                  "Succeeded"
                ]
              }
            },
            "Send_an_email_(V2)": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "@json(outputs('ARGO_notification_flows_value'))?['Recipients']",
                  "emailMessage/Subject": "[Creation Teams Meeting] Power Automate Flow Failed",
                  "emailMessage/Body": "<p class=\"editor-paragraph\">Dear,<br><br>This is a system-generated email to inform you that your forwarded email could not be processed by the system due to the following error:<br><br>Flow Name: @{outputs('Get_workflow_details')?['tags']?['flowDisplayName']}<br>Flow URL: <a href=\"@{outputs('Flow_URL')}\" class=\"editor-link\">View Flow</a><br><br>Kindly contact IT Support for further assistance.<br><br>Do not reply to this email as it was automatically generated by the system.<br><br>Thank you,<br>BD System Notification</p>",
                  "emailMessage/Importance": "Normal"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365"
                }
              },
              "runAfter": {
                "ARGO_notification_flows_value": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Scope_-_Try": [
              "TimedOut",
              "Skipped",
              "Failed"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}