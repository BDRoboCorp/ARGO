          "type": "Recurrence",
          "recurrence": {
            "frequency": "Day",
            "interval": 30,
            "timeZone": "Eastern Standard Time",
            "startTime": "2026-08-24T17:30:00Z",
            "schedule": {
              "hours": [
                "1"
              ]
            }
          },
          "metadata": {
            "operationMetadataId": "cdb28b49-d42c-43ee-a20e-7e289e19ca7d"
          }
