                ]
              },
              "actions": {
                "Append_to_array_variable": {
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "varAttendees",
                    "value": {
                      "type": "required",
                      "status": {
                        "response": "none",
