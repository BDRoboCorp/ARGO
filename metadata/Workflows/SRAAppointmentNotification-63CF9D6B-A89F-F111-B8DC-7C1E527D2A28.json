        "Perform_an_unbound_action": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "actionName": "bdgas_GetEmailContent",
              "item/FetchXml": "<fetch top=\"1\">\n  <entity name=\"appointment\">\n    <attribute name=\"activityid\" />\n <attribute name=\"subject\" />\n\t<attribute name=\"bdgas_requestname\" />\n\t<attribute name=\"bdgas_requiredemails\" />\n <attribute name=\"bdgas_optionalemails\" />\n <attribute name=\"onlinemeetingjoinurl\" />\n <link-entity name='systemuser' to='bdgas_businesspartner' from='systemuserid' alias='systemuser' link-type='outer'>\n<attribute name='fullname' />\n</link-entity>\n\t<attribute name=\"bdgas_configurationitemname\" />\n\t<attribute name=\"bdgas_configurationitemserialnumber\" />\n\t<attribute name=\"bdgas_notes\" />\n    <filter>\n      <condition\n        attribute=\"activityid\"\n        operator=\"eq\"\n        value=\"@{triggerOutputs()?['body/activityid']}\" />\n    </filter>\n  </entity>\n</fetch>",
              "item/TempateName": "SRA Appointment Email Template",
              "item/StripHtml": false
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
