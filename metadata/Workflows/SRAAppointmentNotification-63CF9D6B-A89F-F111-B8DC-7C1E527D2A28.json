        "For_each": {
          "type": "Foreach",
          "foreach": "@variables('EmailArray')",
          "actions": {
            "Is_Not_Empty": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@empty(items('For_each'))",
                      "@false"
