{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedcommondataserviceforapps_ae6e7"
        },
        "runtimeSource": "embedded"
      },
      "shared_commondataserviceforapps-1": {
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "connection": {
          "connectionReferenceLogicalName": "bdgas_sharedcommondataserviceforapps_52065"
        },
        "runtimeSource": "embedded"
      },
      "shared_office365": {
        "api": {
          "name": "shared_office365"
        },
        "connection": {
          "connectionReferenceLogicalName": "new_sharedoffice365_28f0a"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_a_row_is_added,_modified_or_deleted_-_Task": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "parameters": {
              "subscriptionRequest/message": 4,
              "subscriptionRequest/entityname": "task",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filterexpression": "_bdgas_appointment_value ne null"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "connectionName": "shared_commondataserviceforapps"
            }
          },
          "metadata": {
            "operationMetadataId": "9ed090b4-4baf-4c78-828b-e8a82284f3c2"
          }
        }
      },
      "actions": {
        "Scope_-_Catch": {
          "type": "Scope",
          "actions": {
            "Get_workflow_details": {
              "type": "Compose",
              "inputs": "@workflow()"
            },
            "Flow_URL": {
              "type": "Compose",
              "inputs": "@concat(\r\n'https://make.powerautomate.com/environments/',\r\nworkflow()?['tags']?['environmentName'],\r\n'/flows/',\r\nworkflow()?['name'],\r\n'/runs/',\r\nworkflow()?['run']?['name']\r\n)",
              "runAfter": {
                "Get_workflow_details": [
                  "Succeeded"
                ]
              }
            },
            "Get_Environment_Variables_-_ARGO_notification_flows": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "environmentvariabledefinitions",
                  "$select": "schemaname,environmentvariabledefinitionid",
                  "$filter": "schemaname eq 'bdgas_ARGOnotificationflows'",
                  "$expand": "environmentvariabledefinition_environmentvariablevalue($select=value)"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "connectionName": "shared_commondataserviceforapps-1"
                }
              },
              "runAfter": {
                "Flow_URL": [
                  "Succeeded"
                ]
              }
            },
            "ARGO_notification_flows_value": {
              "type": "Compose",
              "inputs": "@first(\r\n    first(\r\n        body('Get_Environment_Variables_-_ARGO_notification_flows')?['value']\r\n    )?['environmentvariabledefinition_environmentvariablevalue']\r\n)?['value']",
              "runAfter": {
                "Get_Environment_Variables_-_ARGO_notification_flows": [
                  "Succeeded"
                ]
              }
            },
            "Send_an_email_(V2)": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "@json(outputs('ARGO_notification_flows_value'))?['Recipients']",
                  "emailMessage/Subject": "[Creation Assigned Notification] Power Automate Flow Failed",
                  "emailMessage/Body": "<p class=\"editor-paragraph\">Dear,<br><br>This is a system-generated email to inform you that your forwarded email could not be processed by the system due to the following error:<br><br>Flow Name: @{outputs('Get_workflow_details')?['tags']?['flowDisplayName']}<br>Flow URL: <a href=\"@{outputs('Flow_URL')}\" class=\"editor-link\">View Flow</a><br><br>Kindly contact IT Support for further assistance.<br><br>Do not reply to this email as it was automatically generated by the system.<br><br>Thank you,<br>BD System Notification</p>",
                  "emailMessage/Importance": "Normal"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365"
                }
              },
              "runAfter": {
                "ARGO_notification_flows_value": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Scope_-_Try": [
              "TimedOut",
              "Skipped",
              "Failed"
            ]
          }
        },
        "Scope_-_Try": {
          "type": "Scope",
          "actions": {
            "Get_EmailTo": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "entityName": "bdgas_taskassignments",
                  "fetchXml": "@variables('FetchXml')"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "connectionName": "shared_commondataserviceforapps"
                }
              },
              "metadata": {
                "operationMetadataId": "99bde264-23ef-46ba-9c6e-820f3a1c9cc1"
              }
            },
            "For_each": {
              "type": "Foreach",
              "foreach": "@outputs('Get_EmailTo')?['body/value']",
              "actions": {
                "Append_to_array_variable": {
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "EmailTo",
                    "value": "@items('For_each')?['user1.internalemailaddress']"
                  }
                }
              },
              "runAfter": {
                "Get_EmailTo": [
                  "Succeeded"
                ]
              }
            },
            "Run_a_Child_Flow": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "20d1c063-a69a-f111-b8dc-7ced8d23115e"
                },
                "body": {
                  "text": "@variables('EmailFetchXml')",
                  "text_1": "Task Create Email Template",
                  "boolean": false,
                  "boolean_1": true,
                  "boolean_2": true,
                  "text_2": "@join(variables('EmailTo'), ';')"
                }
              },
              "runAfter": {
                "Set_EmailFetchXml": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "f1bdd248-de0a-4a89-a369-a070585d5c5a"
              }
            },
            "Set_EmailFetchXml": {
              "type": "SetVariable",
              "inputs": {
                "name": "EmailFetchXml",
                "value": "<fetch>\n  <entity name='task'>\n    <attribute name='activityid' />\n    <attribute name='subject' />\n    <link-entity name='appointment' to='bdgas_appointment' from='activityid' alias='appointment' link-type='inner'>\n      <attribute name='bdgas_requestname' />\n    </link-entity>\n    <filter>\n      <condition attribute='activityid' operator='eq' value='@{triggerOutputs()?['body/activityid']}' />\n    </filter>\n  </entity>\n</fetch>"
              },
              "runAfter": {
                "For_each": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Initialize_EmailFetchXml": [
              "Succeeded"
            ]
          }
        },
        "Delay": {
          "type": "Wait",
          "inputs": {
            "interval": {
              "count": 1,
              "unit": "Minute"
            }
          },
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "7b96ca6f-74a1-4445-8052-d07d2fb63e5d"
          }
        },
        "FetchXml": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "FetchXml",
                "type": "string",
                "value": "<fetch>\n  <entity name='bdgas_taskassignment'>\n    <link-entity name='task' to='bdgas_taskid' from='activityid' alias='task' link-type='inner' />\n    <link-entity name='systemuser' to='bdgas_userid' from='systemuserid' alias='user1' link-type='inner'>\n      <attribute name='internalemailaddress' />\n    </link-entity>\n    <filter>\n      <condition attribute='bdgas_taskid' operator='eq' value='@{triggerOutputs()?['body/activityid']}' />\n    </filter>\n  </entity>\n</fetch>"
              }
            ]
          },
          "runAfter": {
            "Delay": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "9dd1a0ac-74a7-493c-8232-8f7b4681231d"
          }
        },
        "Email": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "EmailTo",
                "type": "array"
              }
            ]
          },
          "runAfter": {
            "FetchXml": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "9ccc9166-0106-420c-b8a2-6aa543111dd5"
          }
        },
        "Initialize_EmailFetchXml": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "EmailFetchXml",
                "type": "string"
              }
            ]
          },
          "runAfter": {
            "Email": [
              "Succeeded"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}