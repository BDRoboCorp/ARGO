              }
            },
            "Apply_to_each_-_Open_Task": {
              "type": "Foreach",
              "foreach": "@outputs('List_rows_-_Open_Tasks')?['body/value']",
              "actions": {
                "Get_EmailTo": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "bdgas_taskassignments",
                      "fetchXml": "<fetch>\n  <entity name='bdgas_taskassignment'>\n    <link-entity name='task' to='bdgas_taskid' from='activityid' alias='task' link-type='inner' />\n    <link-entity name='systemuser' to='bdgas_userid' from='systemuserid' alias='user1' link-type='inner'>\n      <attribute name='internalemailaddress' />\n    </link-entity>\n    <filter>\n      <condition attribute='bdgas_taskid' operator='eq' value='@{items('Apply_to_each_-_Open_Task')?['activityid']}' />\n    </filter>\n  </entity>\n</fetch>"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "ListRecords",
                      "connectionName": "shared_commondataserviceforapps"
                    }
                  },
                  "runAfter": {
