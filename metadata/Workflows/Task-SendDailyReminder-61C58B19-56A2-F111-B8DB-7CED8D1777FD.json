                "Run_a_Child_Flow": {
                  "type": "Workflow",
                  "inputs": {
                    "host": {
                      "workflowReferenceName": "20d1c063-a69a-f111-b8dc-7ced8d23115e"
                    },
                    "body": {
                      "text": "<fetch>\n  <entity name='task'>\n    <attribute name='activityid' />\n    <attribute name='subject' />\n    <link-entity name='appointment' to='bdgas_appointment' from='activityid' alias='appointment' link-type='inner'>\n      <attribute name='bdgas_requestname' />\n    </link-entity>\n    <filter>\n      <condition attribute='activityid' operator='eq' value='@{items('Apply_to_each_-_Open_Task')?['activityid']}' />\n    </filter>\n  </entity>\n</fetch>",
                      "text_1": "Task Reminder Email Template",
                      "boolean": false,
                      "boolean_1": true,
                      "boolean_2": true,
                      "text_2": "@join(variables('EmailTo'), ';')"
                    }
                  },
                  "runAfter": {
                    "For_each": [
                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "f1bdd248-de0a-4a89-a369-a070585d5c5a"
                  }
                },
                "Set_variable": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "EmailTo",
                    "value": []
                  }
                }
              },
              "runAfter": {
