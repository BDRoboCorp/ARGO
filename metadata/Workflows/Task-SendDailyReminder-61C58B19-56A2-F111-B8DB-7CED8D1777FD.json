                      "Succeeded"
                    ]
                  },
                  "metadata": {
                    "operationMetadataId": "99bde264-23ef-46ba-9c6e-820f3a1c9cc1"
                  }
                },
                "For_each": {
                  "type": "Foreach",
                  "foreach": "@outputs('Get_EmailTo')?['body/value']",
                  "actions": {
                    "Append_to_array_variable": {
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "EmailTo",
                        "value": "@items('For_each')?['user1.internalemailaddress']"
                      }
                    }
                  },
                  "runAfter": {
                    "Get_EmailTo": [
                      "Succeeded"
                    ]
