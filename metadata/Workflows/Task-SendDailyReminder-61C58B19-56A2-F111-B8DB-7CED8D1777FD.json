          }
        },
        "Compose_-_Reminder_Cutoff_UTC": {
          "type": "Compose",
          "inputs": "@addHours(\r\n  utcNow(),\r\n  mul(\r\n    int(outputs('Compose_-_Duration_Hours')),\r\n    -1\r\n  )\r\n)",
          "runAfter": {
