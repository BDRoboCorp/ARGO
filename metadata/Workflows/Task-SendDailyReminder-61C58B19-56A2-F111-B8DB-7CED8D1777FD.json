              "Succeeded"
            ]
          }
        },
        "Compose_-_Reminder_Cutoff_Formatted": {
          "type": "Compose",
          "inputs": "@formatDateTime(\r\n  outputs('Compose_-_Reminder_Cutoff_UTC'),\r\n  'yyyy-MM-ddTHH:mm:ssZ'\r\n)",
          "runAfter": {
            "Compose_-_Reminder_Cutoff_UTC": [
