          "type": "Scope",
          "actions": {
            "Send_an_email_(V2)_1": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "emailMessage/To": "@body('Parse_JSON')?['Recipients']",
                  "emailMessage/Subject": "[ARGO System Notification] Power Automate Flow Failed",
                  "emailMessage/Body": "<p class=\"editor-paragraph\">Dear,<br><br>This is a system-generated email to inform you that your forwarded email could not be processed by the system due to the following error:<br><br><b><strong class=\"editor-text-bold\">Flow Name:</strong></b> @{outputs('Get_Workflow_Details')?['tags']?['flowDisplayName']}</p><p class=\"editor-paragraph\"><b><strong class=\"editor-text-bold\">Flow URL:</strong></b> <a href=\"@{outputs('Flow_URL')}\" class=\"editor-link\">View Flow</a></p><p class=\"editor-paragraph\"><b><strong class=\"editor-text-bold\">ARGO Record: </strong></b><a href=\"@{outputs('Record_URL')}\" class=\"editor-link\">View Record</a><br><br>Kindly contact IT Support for further assistance.<br><br><i><b><strong class=\"editor-text-bold editor-text-italic\">Do not reply to this email as it was automatically generated by the system.</strong></b></i><br><br>Thank you,<br>ARGO System Notification</p>",
                  "emailMessage/Importance": "Normal"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "operationId": "SendEmailV2",
                  "connectionName": "shared_office365"
                }
              },
              "runAfter": {
                "Parse_JSON": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "503d7713-0632-47ae-87e7-eecda3637bbf"
              }
            },
            "Flow_URL": {
              "type": "Compose",
              "inputs": "https://make.powerautomate.com/environments/@{outputs('Get_Workflow_Details')?['tags']?['environmentName']}/flows/@{outputs('Get_Workflow_Details')?['name']}/runs/@{outputs('Get_Workflow_Details')?['run']['name']}",
              "runAfter": {
                "Get_Workflow_Details": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "5dac59e2-9883-49ed-882e-6b8d857bf307"
              }
            },
            "Get_Workflow_Details": {
              "type": "Compose",
              "inputs": "@workflow()",
              "metadata": {
                "operationMetadataId": "b7f5e576-5cae-4bae-b2b6-2c889e0abe66"
              }
            },
            "Record_URL": {
              "type": "Compose",
              "inputs": "@{parameters('ARGO Application URL (bdgas_ARGOApplicationURL)')}&pagetype=entityrecord&etn=bdgas_requestintake&id=@{triggerOutputs()?['body/bdgas_requestintakeid']}",
              "runAfter": {
                "Flow_URL": [
                  "Succeeded"
