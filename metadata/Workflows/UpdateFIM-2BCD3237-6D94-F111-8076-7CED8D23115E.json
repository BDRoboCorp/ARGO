              "subscriptionRequest/filteringattributes": "bdgas_serviceaccountused",
              "subscriptionRequest/filterexpression": "(startswith(bdgas_requestintake,'RPA') or startswith(bdgas_requestintake,'RITM')) and bdgas_serviceaccountused eq true"
