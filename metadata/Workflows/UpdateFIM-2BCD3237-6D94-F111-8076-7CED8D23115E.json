                  "operationId": "GetItem",
                  "connectionName": "shared_commondataserviceforapps"
                }
              }
            },
            "Compose_-_RequestedAccountName": {
              "type": "Compose",
              "inputs": "@if(\r\n  startsWith(triggerOutputs()?['body/bdgas_requestintake'], 'RITM'),\r\n  concat(\r\n    'RPA',\r\n    substring(\r\n      triggerOutputs()?['body/bdgas_requestintake'],\r\n      4,\r\n      sub(\r\n        length(triggerOutputs()?['body/bdgas_requestintake']),\r\n        4\r\n      )\r\n    )\r\n  ),\r\n  triggerOutputs()?['body/bdgas_requestintake']\r\n)",
              "runAfter": {
                "Get_user_profile_(V2)": [
                  "Succeeded"
                ]
              }
            },
            "Compose_-_LastName": {
              "type": "Compose",
              "inputs": "@last(split(outputs('Get_a_User_row_by_ID')?['body/fullname'],' '))",
              "runAfter": {
                "Compose_-_RequestName": [
                  "Succeeded"
                ]
              }
            },
            "Compose_-_Location": {
